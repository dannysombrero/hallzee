{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hallzee.invalid/contracts/web-client/v1/backup.schema.json",
  "title": "Hallzee web data backup v1",
  "$comment": "50 MiB limit, valid IANA time zones, relational integrity, unique keys, and schedule overlap checks are additionally enforced by validateBackup. This is a data-only format, never an ownership transfer.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "formatVersion",
    "schemaVersion",
    "appVersion",
    "exportedAtUtc",
    "workspaces",
    "terminals",
    "trips",
    "rosterStudents",
    "rosterEnrollments",
    "policyRules",
    "bellPeriods",
    "scheduleExceptions"
  ],
  "properties": {
    "format": {
      "const": "hallzee-web-data"
    },
    "formatVersion": {
      "const": 1
    },
    "schemaVersion": {
      "const": 1
    },
    "appVersion": {
      "type": "string"
    },
    "exportedAtUtc": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$",
      "format": "date-time"
    },
    "workspaces": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/workspace"
      },
      "minItems": 1
    },
    "terminals": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/terminal"
      }
    },
    "trips": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/trip"
      }
    },
    "rosterStudents": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/student"
      }
    },
    "rosterEnrollments": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/enrollment"
      }
    },
    "policyRules": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/policy"
      },
      "minItems": 1
    },
    "bellPeriods": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/period"
      }
    },
    "scheduleExceptions": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/exception"
      }
    }
  },
  "$defs": {
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspaceId",
        "name",
        "teacher",
        "school",
        "room",
        "timeZone",
        "createdAtUtc",
        "updatedAtUtc"
      ],
      "properties": {
        "workspaceId": {
          "type": "string",
          "maxLength": 200
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "teacher": {
          "type": "string",
          "maxLength": 200
        },
        "school": {
          "type": "string",
          "maxLength": 200
        },
        "room": {
          "type": "string",
          "maxLength": 200
        },
        "timeZone": {
          "type": "string",
          "maxLength": 200
        },
        "createdAtUtc": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$",
          "format": "date-time"
        },
        "updatedAtUtc": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$",
          "format": "date-time"
        }
      }
    },
    "terminal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "terminalId",
        "customName",
        "protocolVersion",
        "maxIdLength"
      ],
      "properties": {
        "terminalId": {
          "type": "string",
          "pattern": "^HZ-[0-9A-F]{12}$"
        },
        "customName": {
          "type": "string",
          "pattern": "^[\\u0020-\\u002B\\u002D-\\u007E]{1,24}$"
        },
        "protocolVersion": {
          "const": 2
        },
        "maxIdLength": {
          "type": "integer",
          "minimum": 4,
          "maximum": 16
        }
      }
    },
    "trip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tripId",
        "studentId",
        "tripDate",
        "timeOut",
        "timeIn",
        "durationSeconds",
        "status",
        "terminalId",
        "receivedAtUtc",
        "receivedWorkspaceId",
        "scheduleName",
        "classSection",
        "contextSource"
      ],
      "properties": {
        "tripId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "studentId": {
          "type": "string",
          "pattern": "^\\d{1,16}$"
        },
        "tripDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "const": ""
            }
          ]
        },
        "timeOut": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d$"
            },
            {
              "const": ""
            }
          ]
        },
        "timeIn": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d$"
            },
            {
              "type": "null"
            }
          ]
        },
        "durationSeconds": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "COMPLETE",
            "MANUAL",
            "MANUAL_RESET"
          ]
        },
        "terminalId": {
          "type": "string",
          "pattern": "^HZ-[0-9A-F]{12}$"
        },
        "receivedAtUtc": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$",
          "format": "date-time"
        },
        "receivedWorkspaceId": {
          "type": "string",
          "maxLength": 200
        },
        "scheduleName": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "classSection": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "contextSource": {
          "enum": [
            "resolved-on-receipt",
            "unknown"
          ]
        }
      }
    },
    "student": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspaceId",
        "studentId",
        "firstName",
        "lastName",
        "grade",
        "createdAtUtc",
        "updatedAtUtc"
      ],
      "properties": {
        "workspaceId": {
          "type": "string",
          "maxLength": 200
        },
        "studentId": {
          "type": "string",
          "pattern": "^\\d{1,16}$"
        },
        "firstName": {
          "type": "string",
          "maxLength": 200
        },
        "lastName": {
          "type": "string",
          "maxLength": 200
        },
        "grade": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "createdAtUtc": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$",
          "format": "date-time"
        },
        "updatedAtUtc": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$",
          "format": "date-time"
        }
      }
    },
    "enrollment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspaceId",
        "studentId",
        "classSection"
      ],
      "properties": {
        "workspaceId": {
          "type": "string",
          "maxLength": 200
        },
        "studentId": {
          "type": "string",
          "pattern": "^\\d{1,16}$"
        },
        "classSection": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspaceId",
        "capacity",
        "warningSeconds",
        "dailyGuideline",
        "firstMinutes",
        "lastMinutes",
        "firstAction",
        "lastAction",
        "enforcement",
        "revision",
        "appliedRevision",
        "appliedDate"
      ],
      "properties": {
        "workspaceId": {
          "type": "string",
          "maxLength": 200
        },
        "capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "warningSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "dailyGuideline": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "firstMinutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1440
        },
        "lastMinutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1440
        },
        "firstAction": {
          "enum": [
            "Allow",
            "Warn",
            "Lock"
          ]
        },
        "lastAction": {
          "enum": [
            "Allow",
            "Warn",
            "Lock"
          ]
        },
        "enforcement": {
          "type": "boolean"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "appliedRevision": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "null"
            }
          ]
        },
        "appliedDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspaceId",
        "scheduleId",
        "periodName",
        "scheduleName",
        "classSection",
        "start",
        "end",
        "weekdays"
      ],
      "properties": {
        "workspaceId": {
          "type": "string",
          "maxLength": 200
        },
        "scheduleId": {
          "type": "string",
          "maxLength": 200
        },
        "periodName": {
          "type": "string",
          "maxLength": 200
        },
        "scheduleName": {
          "type": "string",
          "maxLength": 200
        },
        "classSection": {
          "type": "string",
          "maxLength": 200
        },
        "start": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "end": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "weekdays": {
          "type": "array",
          "items": {
            "enum": [
              "Sun",
              "Mon",
              "Tue",
              "Wed",
              "Thu",
              "Fri",
              "Sat"
            ]
          }
        }
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspaceId",
        "date",
        "scheduleName",
        "isNoSchool"
      ],
      "properties": {
        "workspaceId": {
          "type": "string",
          "maxLength": 200
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "scheduleName": {
          "type": "string",
          "maxLength": 200
        },
        "isNoSchool": {
          "type": "boolean"
        }
      }
    }
  }
}
