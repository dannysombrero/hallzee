<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BathroomSync.Universal.App"
             RequestedThemeVariant="Light">
  <Application.Resources>
    <!-- CANONICAL HALLZEE VIBRANT CYAN-TO-OCEAN GRADIENT -->
    <LinearGradientBrush x:Key="HallzeeVibrantGradient" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Color="#00B8F2" Offset="0.0" />
      <GradientStop Color="#0098E8" Offset="0.45" />
      <GradientStop Color="#0070C4" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HallzeeVibrantGradientHover" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Color="#00C6FF" Offset="0.0" />
      <GradientStop Color="#00A4F2" Offset="0.45" />
      <GradientStop Color="#007AD0" Offset="1.0" />
    </LinearGradientBrush>

    <!-- DARK SLATE GRADIENT -->
    <LinearGradientBrush x:Key="HallzeeDarkGradient" StartPoint="0%,0%" EndPoint="100%,0%">
      <GradientStop Color="#0F172A" Offset="0.0" />
      <GradientStop Color="#1E293B" Offset="0.5" />
      <GradientStop Color="#0F172A" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HallzeeDarkGradientHover" StartPoint="0%,0%" EndPoint="100%,0%">
      <GradientStop Color="#1E293B" Offset="0.0" />
      <GradientStop Color="#334155" Offset="0.5" />
      <GradientStop Color="#1E293B" Offset="1.0" />
    </LinearGradientBrush>

    <!-- WINDOW HEADER GRADIENT -->
    <LinearGradientBrush x:Key="HallzeeWindowHeaderGradient" StartPoint="0%,0%" EndPoint="100%,0%">
      <GradientStop Color="#0284C7" Offset="0.0" />
      <GradientStop Color="#0369A1" Offset="0.5" />
      <GradientStop Color="#075985" Offset="1.0" />
    </LinearGradientBrush>

    <!-- CLEAN VECTOR PATH GEOMETRIES (LUCIDE / FLUENT ICONS) -->
    <StreamGeometry x:Key="IconLaptop">M4 5h16a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z M2 19h20</StreamGeometry>
    <StreamGeometry x:Key="IconHistory">M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8 M3 3v5h5 M12 7v5l4 2</StreamGeometry>
    <StreamGeometry x:Key="IconUsers">M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2 M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z M22 21v-2a4 4 0 0 0-3-3.87 M16 3.13a4 4 0 0 1 0 7.75</StreamGeometry>
    <StreamGeometry x:Key="IconCalendar">M8 2v4 M16 2v4 M3 10h18 M3 4h18a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z</StreamGeometry>
    <StreamGeometry x:Key="IconRadio">M4.9 19.1C1 15.2 1 8.8 4.9 4.9 M7.8 16.2c-2.3-2.3-2.3-6.1 0-8.5 M12 14a2 2 0 1 0 0-4 2 2 0 0 0 0 4z M16.2 7.8c2.3 2.3 2.3 6.1 0 8.5 M19.1 4.9C23 8.8 23 15.1 19.1 19</StreamGeometry>
    <StreamGeometry x:Key="IconSettings">M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z</StreamGeometry>
    <StreamGeometry x:Key="IconSync">M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8 M21 3v5h-5 M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16 M3 21v-5h5</StreamGeometry>
    <StreamGeometry x:Key="IconUserCheck">M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2 M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z M16 11l2 2 4-4</StreamGeometry>
    <StreamGeometry x:Key="IconUserX">M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2 M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z M17 8l5 5 M22 8l-5 5</StreamGeometry>
    <StreamGeometry x:Key="IconClock">M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z M12 6v6l4 2</StreamGeometry>
    <StreamGeometry x:Key="IconPauseCircle">M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z M10 15V9 M14 15V9</StreamGeometry>
    <StreamGeometry x:Key="IconShieldCheck">M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z M9 12l2 2 4-4</StreamGeometry>
    <StreamGeometry x:Key="IconDownload">M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4 M7 10l5 5 5-5 M12 15V3</StreamGeometry>
    <StreamGeometry x:Key="IconChevronRight">M9 18l6-6-6-6</StreamGeometry>
    <StreamGeometry x:Key="IconZap">M13 2L3 14h9l-1 8 10-12h-9l1-8z</StreamGeometry>
    <StreamGeometry x:Key="IconTag">M12 2H2v10l9.29 9.29c.94.94 2.48.94 3.42 0l6.58-6.58c.94-.94.94-2.48 0-3.42L12 2z M7 7a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3z</StreamGeometry>
    <StreamGeometry x:Key="IconSearch">M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16z M21 21l-4.35-4.35</StreamGeometry>
    <StreamGeometry x:Key="IconTrash">M3 6h18 M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6 M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2 M10 11v6 M14 11v6</StreamGeometry>
    <StreamGeometry x:Key="IconPlus">M12 5v14 M5 12h14</StreamGeometry>
    <StreamGeometry x:Key="IconX">M18 6L6 18 M6 6l12 12</StreamGeometry>
    <StreamGeometry x:Key="IconCheck">M20 6L9 17l-5-5</StreamGeometry>
    <StreamGeometry x:Key="IconEdit">M17 3a2.85 2.85 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z M15 5l4 4</StreamGeometry>
    <StreamGeometry x:Key="IconVolume2">M11 5L6 9H2v6h4l5 4V5z M19.07 4.93a10 10 0 0 1 0 14.14 M15.54 8.46a5 5 0 0 1 0 7.07</StreamGeometry>
    <StreamGeometry x:Key="IconChevronDown">M6 9l6 6 6-6</StreamGeometry>
    <StreamGeometry x:Key="IconChevronUp">M6 15l6-6 6 6</StreamGeometry>

    <!-- COMPACT MODERN BUTTON SPINNER REPEAT BUTTON -->
    <ControlTheme x:Key="HallzeeSpinnerRepeatButton" TargetType="RepeatButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="20" />
      <Setter Property="Width" Value="20" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="PART_Border"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ Border#PART_Border">
        <Setter Property="Background" Value="#BAE6FD" />
      </Style>
      <Style Selector="^:pressed /template/ Border#PART_Border">
        <Setter Property="Background" Value="#7DD3FC" />
      </Style>
      <Style Selector="^:disabled /template/ Border#PART_Border">
        <Setter Property="Opacity" Value="0.3" />
      </Style>
    </ControlTheme>

    <!-- UNIFIED BUTTON SPINNER THEME (ZERO INTERNAL BORDER / GAP ARTIFACTS) -->
    <ControlTheme x:Key="{x:Type ButtonSpinner}" TargetType="ButtonSpinner">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <ControlTemplate>
          <DockPanel Background="Transparent">
            <Border DockPanel.Dock="Right"
                    Background="#BAE6FD"
                    CornerRadius="0,9,9,0"
                    Margin="0"
                    VerticalAlignment="Stretch"
                    IsVisible="{TemplateBinding ShowButtonSpinner}">
              <StackPanel Name="PART_SpinnerPanel"
                          Orientation="Horizontal"
                          VerticalAlignment="Stretch">
                <RepeatButton Name="PART_IncreaseButton"
                              Theme="{StaticResource HallzeeSpinnerRepeatButton}"
                              IsTabStop="{TemplateBinding IsTabStop}">
                  <Path Data="{StaticResource IconChevronUp}"
                        Width="9" Height="9" Stretch="Uniform"
                        Stroke="#0369A1" StrokeThickness="2.2" StrokeLineCap="Round"
                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                </RepeatButton>

                <RepeatButton Name="PART_DecreaseButton"
                              Theme="{StaticResource HallzeeSpinnerRepeatButton}"
                              IsTabStop="{TemplateBinding IsTabStop}">
                  <Path Data="{StaticResource IconChevronDown}"
                        Width="9" Height="9" Stretch="Uniform"
                        Stroke="#0369A1" StrokeThickness="2.2" StrokeLineCap="Round"
                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                </RepeatButton>
              </StackPanel>
            </Border>

            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              Padding="{TemplateBinding Padding}" />
          </DockPanel>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:left /template/ Border">
        <Setter Property="DockPanel.Dock" Value="Left" />
        <Setter Property="CornerRadius" Value="9,0,0,9" />
      </Style>
    </ControlTheme>

    <!-- UNIFIED NUMERICUPDOWN THEME (FLAWLESS PILL/ROUNDED CORNERS, NO BLEED) -->
    <ControlTheme x:Key="{x:Type NumericUpDown}" TargetType="NumericUpDown">
      <Setter Property="Foreground" Value="#0F172A" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#BAE6FD" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  ClipToBounds="True"
                  MinHeight="{TemplateBinding MinHeight}">
            <ButtonSpinner Name="PART_Spinner"
                           Background="Transparent"
                           BorderThickness="0"
                           Padding="0"
                           HorizontalContentAlignment="Stretch"
                           VerticalContentAlignment="Stretch"
                           AllowSpin="{TemplateBinding AllowSpin}"
                           ShowButtonSpinner="{TemplateBinding ShowButtonSpinner}"
                           ButtonSpinnerLocation="{TemplateBinding ButtonSpinnerLocation}">
              <TextBox Name="PART_TextBox"
                       Background="Transparent"
                       BorderBrush="Transparent"
                       BorderThickness="0"
                       CornerRadius="0"
                       Padding="8,2"
                       MinWidth="0"
                       Foreground="{TemplateBinding Foreground}"
                       FontSize="{TemplateBinding FontSize}"
                       FontWeight="Bold"
                       IsReadOnly="{TemplateBinding IsReadOnly}"
                       VerticalContentAlignment="Center"
                       HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                       Text="{TemplateBinding Text}"
                       TextAlignment="{TemplateBinding TextAlignment}"
                       AcceptsReturn="False"
                       TextWrapping="NoWrap" />
            </ButtonSpinner>
          </Border>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="#E0F2FE" />
        <Setter Property="BorderBrush" Value="#7DD3FC" />
      </Style>
      <Style Selector="^:focus-within">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="#0284C7" />
      </Style>
    </ControlTheme>

    <!-- CANONICAL APPLICATION FONTS (MATCHING WEB CLIENT: DM SANS) -->
    <FontFamily x:Key="DMSansFont">avares://Hallzee/Assets/Fonts#DM Sans</FontFamily>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    
    <!-- GLOBAL APPLICATION TYPOGRAPHY (MATCHING WEB CLIENT) -->
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="{StaticResource DMSansFont}" />
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource DMSansFont}" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="FontFamily" Value="{StaticResource DMSansFont}" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="FontFamily" Value="{StaticResource DMSansFont}" />
    </Style>
    <Style Selector="Button">
      <Setter Property="FontFamily" Value="{StaticResource DMSansFont}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource DMSansFont}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    
    <!-- BRAND GRADIENT PILL BUTTON -->
    <Style Selector="Button.hallzee-pill-btn">
      <Setter Property="Background" Value="{StaticResource HallzeeVibrantGradient}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="CornerRadius" Value="24" />
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.hallzee-pill-btn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource HallzeeVibrantGradientHover}" />
      <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- ACTIVE SIDEBAR NAV BUTTON -->
    <Style Selector="Button.sidebar-nav-active">
      <Setter Property="Background" Value="{StaticResource HallzeeVibrantGradient}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="CornerRadius" Value="24" />
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.sidebar-nav-active:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource HallzeeVibrantGradientHover}" />
      <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- LIGHT SIDEBAR NAV BUTTON -->
    <Style Selector="Button.sidebar-nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#0F172A" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="CornerRadius" Value="24" />
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.sidebar-nav:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#E0F2FE" />
      <Setter Property="Foreground" Value="#0369A1" />
    </Style>

    <!-- WHITE CARD BUTTON WITH SKY BORDER -->
    <Style Selector="Button.card-outline">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#0369A1" />
      <Setter Property="BorderBrush" Value="#BAE6FD" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.card-outline:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F0F9FF" />
      <Setter Property="BorderBrush" Value="#7DD3FC" />
      <Setter Property="Foreground" Value="#0284C7" />
    </Style>

    <!-- OUTLINE PILL BUTTON (e.g. Export CSV matching Web Client) -->
    <Style Selector="Button.pill-outline">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#0369A1" />
      <Setter Property="BorderBrush" Value="#BAE6FD" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="CornerRadius" Value="24" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.pill-outline:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F0F9FF" />
      <Setter Property="BorderBrush" Value="#7DD3FC" />
      <Setter Property="Foreground" Value="#0284C7" />
    </Style>

    <!-- REUSABLE VIBRANT STATUS PILL (CONNECTED, COMPLETED, MANUAL, ETC.) -->
    <Style Selector="Border.status-pill">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="BoxShadow" Value="0 1 2 0 #15000000" />
    </Style>
    <Style Selector="Border.status-pill TextBlock">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="0.5" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.status-pill.success">
      <Setter Property="Background" Value="#10B981" />
    </Style>
    <Style Selector="Border.status-pill.warning">
      <Setter Property="Background" Value="#F59E0B" />
    </Style>
    <Style Selector="Border.status-pill.info">
      <Setter Property="Background" Value="#0284C7" />
    </Style>
    <Style Selector="Border.status-pill.neutral">
      <Setter Property="Background" Value="#64748B" />
    </Style>
    <Style Selector="Border.status-pill.dark">
      <Setter Property="Background" Value="#0F172A" />
    </Style>

    <!-- INTERACTIVE STATUS PILL BUTTON (e.g. Filter Threshold Badge) -->
    <Style Selector="Button.status-pill">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="9,3" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.status-pill:pointerover">
      <Setter Property="RenderTransform" Value="scale(1.04)" />
    </Style>
    <Style Selector="Button.status-pill TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="ExtraBold" />
      <Setter Property="LetterSpacing" Value="0.3" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.status-pill.warning">
      <Setter Property="Background" Value="#F59E0B" />
    </Style>
    <Style Selector="Button.status-pill.warning:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#D97706" />
    </Style>


    <!-- DARK ACTION BUTTON (e.g. Check In) -->
    <Style Selector="Button.dark-action">
      <Setter Property="Background" Value="{StaticResource HallzeeDarkGradient}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.dark-action:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource HallzeeDarkGradientHover}" />
      <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- SECONDARY / UTILITY BUTTON -->
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="#E0F2FE" />
      <Setter Property="Foreground" Value="#0369A1" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#BAE6FD" />
      <Setter Property="Foreground" Value="#0284C7" />
    </Style>

    <!-- DANGER BUTTON -->
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="#FFE4E6" />
      <Setter Property="Foreground" Value="#E11D48" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,4" />
    </Style>

    <!-- SOFT CYAN PILL BUTTON (e.g. + Create New Profile, Earliest First, + Add Period, Preview) -->
    <Style Selector="Button.pill-secondary">
      <Setter Property="Background" Value="#BAE6FD" />
      <Setter Property="Foreground" Value="#0369A1" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.pill-secondary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#7DD3FC" />
      <Setter Property="Foreground" Value="#0284C7" />
    </Style>

    <!-- CIRCULAR ICON ACTION BUTTONS (e.g. Close, Edit, Delete) -->
    <Style Selector="Button.icon-circle">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.icon-circle.secondary">
      <Setter Property="Background" Value="#BAE6FD" />
      <Setter Property="Foreground" Value="#0369A1" />
    </Style>
    <Style Selector="Button.icon-circle.secondary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#7DD3FC" />
    </Style>
    <Style Selector="Button.icon-circle.info">
      <Setter Property="Background" Value="#BAE6FD" />
      <Setter Property="Foreground" Value="#0284C7" />
    </Style>
    <Style Selector="Button.icon-circle.info:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#7DD3FC" />
    </Style>
    <Style Selector="Button.icon-circle.danger">
      <Setter Property="Background" Value="#FEE2E2" />
      <Setter Property="Foreground" Value="#EF4444" />
    </Style>
    <Style Selector="Button.icon-circle.danger:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#FECACA" />
    </Style>

    <!-- TABLE HEADER BUTTON (For clickable sortable columns) -->
    <Style Selector="Button.table-header-btn">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.table-header-btn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- UNIFIED TABLE STYLES (MATCHING WEB CLIENT DESIGN SYSTEM) -->
    <Style Selector="Border.hallzee-table-container">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#BAE6FD" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="BoxShadow" Value="0 4 20 0 #1A0284C7, 0 1 3 0 #0A0284C7" />
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="MinHeight" Value="260" />
      <Setter Property="Margin" Value="0,2,0,4" />
    </Style>

    <Style Selector="Border.hallzee-table-inner, Border.hallzee-table-container > Border">
      <Setter Property="CornerRadius" Value="17" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style Selector="Border.hallzee-table-header">
      <Setter Property="Background" Value="#F0F9FF" />
      <Setter Property="BorderBrush" Value="#BAE6FD" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="16,13" />
      <Setter Property="CornerRadius" Value="17,17,0,0" />
    </Style>

    <Style Selector="ListBox.hallzee-table-list">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.hallzee-table-list ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="ListBox.hallzee-table-list ListBoxItem /template/ ContentPresenter">
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="ListBox.hallzee-table-list ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="#F0F9FF" />
    </Style>
    <Style Selector="ListBox.hallzee-table-list ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F8FAFC" />
    </Style>

    <Style Selector="Border.hallzee-table-row">
      <Setter Property="BorderBrush" Value="#EDF6FB" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="16,13" />
    </Style>

    <!-- THEMED FILTER DROPDOWN (ROUNDED PILL WITH SKY PALETTE) -->
    <Style Selector="ComboBox.filter-dropdown">
      <Setter Property="Background" Value="#F0F9FF" />
      <Setter Property="BorderBrush" Value="#BAE6FD" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="Padding" Value="14,6,10,6" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#0369A1" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="MinHeight" Value="36" />
    </Style>
    <Style Selector="ComboBox.filter-dropdown:pointerover /template/ Border#Background">
      <Setter Property="Background" Value="#E0F2FE" />
      <Setter Property="BorderBrush" Value="#7DD3FC" />
    </Style>

    <!-- THEMED GLOBAL INPUT FIELDS (MATCHING TRIP & ROSTER AESTHETICS) -->
    <Style Selector="TextBox">
      <Setter Property="Background" Value="#F0F9FF" />
      <Setter Property="BorderBrush" Value="#BAE6FD" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="#0F172A" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#E0F2FE" />
      <Setter Property="BorderBrush" Value="#7DD3FC" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#0284C7" />
    </Style>

    <Style Selector="ComboBox">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#BAE6FD" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="#0369A1" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBox:pointerover /template/ Border#Background">
      <Setter Property="Background" Value="#E0F2FE" />
      <Setter Property="BorderBrush" Value="#7DD3FC" />
    </Style>

    <!-- RESET INTERNAL TEXTBOX INSIDE NUMERICUPDOWN -->
    <Style Selector="TextBox.card-search">
      <Setter Property="Background" Value="#F0F9FF" />
      <Setter Property="BorderBrush" Value="#BAE6FD" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.card-search:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#E0F2FE" />
      <Setter Property="BorderBrush" Value="#7DD3FC" />
    </Style>
    <Style Selector="TextBox.card-search:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#0284C7" />
    </Style>

    <!-- THEMED FILTER SEARCH (PILL SEARCH BOX FOR MODAL TOOLBARS) -->
    <Style Selector="TextBox.filter-search">
      <Setter Property="Background" Value="#F0F9FF" />
      <Setter Property="BorderBrush" Value="#BAE6FD" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="Padding" Value="4,7,14,7" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Foreground" Value="#0F172A" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.filter-search:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#E0F2FE" />
      <Setter Property="BorderBrush" Value="#7DD3FC" />
    </Style>
    <Style Selector="TextBox.filter-search:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#0284C7" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Button.pill-filter">
      <Setter Property="Background" Value="#F1F5F9" />
      <Setter Property="Foreground" Value="#475569" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#E2E8F0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.pill-filter:pointerover">
      <Setter Property="Background" Value="#E2E8F0" />
      <Setter Property="Foreground" Value="#0F172A" />
    </Style>
    <Style Selector="Button.pill-filter.active">
      <Setter Property="Background" Value="#0284C7" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#0284C7" />
    </Style>
    <Style Selector="Button.pill-filter.active:pointerover">
      <Setter Property="Background" Value="#0369A1" />
      <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- THEMED TOOLTIP (MATCHING HALLZEE SKY PALETTE) -->
    <Style Selector="ToolTip">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#BAE6FD" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Foreground" Value="#0F172A" />
      <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- NUMERICUPDOWN INTERNAL TEXTBOX CLEANUP -->
    <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>


    <!-- UNIFIED CARD & SECTION CONTAINERS -->
    <Style Selector="Border.hallzee-card, Border.hallzee-section">
      <Setter Property="Background" Value="#F0F9FF" />
      <Setter Property="BorderBrush" Value="#BAE6FD" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="BoxShadow" Value="0 1 3 0 #0A0284C7" />
    </Style>

    <Style Selector="Border.hallzee-card-white, Border.hallzee-section-white">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#BAE6FD" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Padding" Value="16,14" />
      <Setter Property="BoxShadow" Value="0 2 8 0 #060284C7" />
    </Style>

    <!-- REUSABLE MODAL SURFACE (Soft sky background matching mockup) -->
    <Style Selector="Border.hallzee-modal-window">
      <Setter Property="Background" Value="#EBF8FE" />
      <Setter Property="CornerRadius" Value="24" />
      <Setter Property="Padding" Value="28" />
      <Setter Property="BoxShadow" Value="0 10 30 0 #40000000" />
    </Style>

    <Style Selector="Border.hallzee-subnav-bar">
      <Setter Property="Background" Value="#F0F9FF" />
      <Setter Property="BorderBrush" Value="#BAE6FD" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="4" />
    </Style>
  </Application.Styles>
</Application>
