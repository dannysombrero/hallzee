<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BathroomSync.Universal.App"
             RequestedThemeVariant="Light">
  <Application.Resources>
    <!-- CANONICAL HALLZEE VIBRANT CYAN-TO-OCEAN GRADIENT -->
    <LinearGradientBrush x:Key="HallzeeVibrantGradient" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Color="#00B8F2" Offset="0.0" />
      <GradientStop Color="#0098E8" Offset="0.45" />
      <GradientStop Color="#0070C4" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HallzeeVibrantGradientHover" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Color="#00C6FF" Offset="0.0" />
      <GradientStop Color="#00A4F2" Offset="0.45" />
      <GradientStop Color="#007AD0" Offset="1.0" />
    </LinearGradientBrush>

    <!-- DARK SLATE GRADIENT -->
    <LinearGradientBrush x:Key="HallzeeDarkGradient" StartPoint="0%,0%" EndPoint="100%,0%">
      <GradientStop Color="#0F172A" Offset="0.0" />
      <GradientStop Color="#1E293B" Offset="0.5" />
      <GradientStop Color="#0F172A" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HallzeeDarkGradientHover" StartPoint="0%,0%" EndPoint="100%,0%">
      <GradientStop Color="#1E293B" Offset="0.0" />
      <GradientStop Color="#334155" Offset="0.5" />
      <GradientStop Color="#1E293B" Offset="1.0" />
    </LinearGradientBrush>

    <!-- WINDOW HEADER GRADIENT -->
    <LinearGradientBrush x:Key="HallzeeWindowHeaderGradient" StartPoint="0%,0%" EndPoint="100%,0%">
      <GradientStop Color="#0284C7" Offset="0.0" />
      <GradientStop Color="#0369A1" Offset="0.5" />
      <GradientStop Color="#075985" Offset="1.0" />
    </LinearGradientBrush>

    <!-- CLEAN VECTOR PATH GEOMETRIES (LUCIDE / FLUENT ICONS) -->
    <StreamGeometry x:Key="IconLaptop">M4 5h16a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z M2 19h20</StreamGeometry>
    <StreamGeometry x:Key="IconHistory">M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8 M3 3v5h5 M12 7v5l4 2</StreamGeometry>
    <StreamGeometry x:Key="IconUsers">M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2 M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z M22 21v-2a4 4 0 0 0-3-3.87 M16 3.13a4 4 0 0 1 0 7.75</StreamGeometry>
    <StreamGeometry x:Key="IconCalendar">M8 2v4 M16 2v4 M3 10h18 M3 4h18a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z</StreamGeometry>
    <StreamGeometry x:Key="IconRadio">M4.9 19.1C1 15.2 1 8.8 4.9 4.9 M7.8 16.2c-2.3-2.3-2.3-6.1 0-8.5 M12 14a2 2 0 1 0 0-4 2 2 0 0 0 0 4z M16.2 7.8c2.3 2.3 2.3 6.1 0 8.5 M19.1 4.9C23 8.8 23 15.1 19.1 19</StreamGeometry>
    <StreamGeometry x:Key="IconSettings">M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z</StreamGeometry>
    <StreamGeometry x:Key="IconSync">M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8 M21 3v5h-5 M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16 M3 21v-5h5</StreamGeometry>
    <StreamGeometry x:Key="IconUserCheck">M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2 M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z M16 11l2 2 4-4</StreamGeometry>
    <StreamGeometry x:Key="IconUserX">M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2 M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z M17 8l5 5 M22 8l-5 5</StreamGeometry>
    <StreamGeometry x:Key="IconClock">M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z M12 6v6l4 2</StreamGeometry>
    <StreamGeometry x:Key="IconShieldCheck">M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z M9 12l2 2 4-4</StreamGeometry>
    <StreamGeometry x:Key="IconDownload">M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4 M7 10l5 5 5-5 M12 15V3</StreamGeometry>
    <StreamGeometry x:Key="IconChevronRight">M9 18l6-6-6-6</StreamGeometry>
    <StreamGeometry x:Key="IconZap">M13 2L3 14h9l-1 8 10-12h-9l1-8z</StreamGeometry>
    <StreamGeometry x:Key="IconTag">M12 2H2v10l9.29 9.29c.94.94 2.48.94 3.42 0l6.58-6.58c.94-.94.94-2.48 0-3.42L12 2z M7 7a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3z</StreamGeometry>
    <StreamGeometry x:Key="IconSearch">M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16z M21 21l-4.35-4.35</StreamGeometry>
    <StreamGeometry x:Key="IconTrash">M3 6h18 M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2</StreamGeometry>
    <StreamGeometry x:Key="IconPlus">M12 5v14 M5 12h14</StreamGeometry>
    <StreamGeometry x:Key="IconX">M18 6L6 18 M6 6l12 12</StreamGeometry>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    
    <!-- BRAND GRADIENT PILL BUTTON -->
    <Style Selector="Button.hallzee-pill-btn">
      <Setter Property="Background" Value="{StaticResource HallzeeVibrantGradient}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="CornerRadius" Value="24" />
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.hallzee-pill-btn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource HallzeeVibrantGradientHover}" />
      <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- ACTIVE SIDEBAR NAV BUTTON -->
    <Style Selector="Button.sidebar-nav-active">
      <Setter Property="Background" Value="{StaticResource HallzeeVibrantGradient}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="CornerRadius" Value="24" />
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.sidebar-nav-active:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource HallzeeVibrantGradientHover}" />
      <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- LIGHT SIDEBAR NAV BUTTON -->
    <Style Selector="Button.sidebar-nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#0F172A" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="CornerRadius" Value="24" />
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.sidebar-nav:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#E0F2FE" />
      <Setter Property="Foreground" Value="#0369A1" />
    </Style>

    <!-- WHITE CARD BUTTON WITH SKY BORDER -->
    <Style Selector="Button.card-outline">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#0369A1" />
      <Setter Property="BorderBrush" Value="#BAE6FD" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="14,8" />
    </Style>
    <Style Selector="Button.card-outline:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F0F9FF" />
      <Setter Property="BorderBrush" Value="#7DD3FC" />
      <Setter Property="Foreground" Value="#0284C7" />
    </Style>

    <!-- DARK ACTION BUTTON (e.g. Check In) -->
    <Style Selector="Button.dark-action">
      <Setter Property="Background" Value="{StaticResource HallzeeDarkGradient}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="16,9" />
    </Style>
    <Style Selector="Button.dark-action:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource HallzeeDarkGradientHover}" />
      <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- SECONDARY / UTILITY BUTTON -->
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="#E0F2FE" />
      <Setter Property="Foreground" Value="#0369A1" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="12,6" />
    </Style>
    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#BAE6FD" />
      <Setter Property="Foreground" Value="#0284C7" />
    </Style>

    <!-- DANGER BUTTON -->
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="#FFE4E6" />
      <Setter Property="Foreground" Value="#E11D48" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,4" />
    </Style>
  </Application.Styles>
</Application>
