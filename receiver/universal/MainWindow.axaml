<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BathroomSync.Universal.ViewModels;assembly=HallzeeSync.Universal"
        xmlns:views="clr-namespace:BathroomSync.Universal.Views;assembly=HallzeeSync.Universal"
        x:Class="BathroomSync.Universal.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="avares://HallzeeSync.Universal/Assets/hallzee.ico"
        Width="1120" Height="740" MinWidth="940" MinHeight="640"
        Title="{Binding WindowTitle}">
  
  <Window.Background>
    <ImageBrush Source="avares://HallzeeSync.Universal/Assets/background.jpg" Stretch="UniformToFill" AlignmentX="Left" AlignmentY="Center" />
  </Window.Background>
  
  <Grid RowDefinitions="Auto,*">
    
    <!-- 1. TOP WINDOW BAR -->
    <Border Grid.Row="0" Background="{StaticResource HallzeeWindowHeaderGradient}" Padding="16,8" BorderBrush="#38BDF8" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Image Source="avares://HallzeeSync.Universal/Assets/hallzee-logo.png" Width="18" Height="18" VerticalAlignment="Center" />
          <TextBlock Text="Hallzee Desktop Client" FontWeight="Bold" FontSize="12" Foreground="White" VerticalAlignment="Center" />
          <TextBlock Text="|" Foreground="#7DD3FC" VerticalAlignment="Center" Margin="4,0" />
          <TextBlock Text="{Binding HeaderLocationText}" FontSize="12" Foreground="#F0F9FF" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Button Classes="secondary" Click="OnStudentsOutClick" Padding="10,5" ToolTip.Tip="Open the always-on-top Mini Window">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Path Data="{StaticResource IconLaptop}" Width="14" Height="14" Stretch="Uniform" Stroke="#0369A1" StrokeThickness="2" StrokeLineCap="Round" />
              <TextBlock Text="Mini Window" FontSize="11" FontWeight="Bold" />
            </StackPanel>
          </Button>
          <TextBlock Text="Teacher workspace" FontSize="11" FontWeight="Bold" Foreground="#E0F2FE" VerticalAlignment="Center" />
          <ComboBox Width="190" ItemsSource="{Binding Profiles}" SelectedItem="{Binding ActiveProfile}" DisplayMemberBinding="{Binding Name}" />
          <TextBlock Text="{Binding ClientVersionDisplay}" FontSize="11" FontFamily="Cascadia Mono, Menlo, monospace" Foreground="#E0F2FE" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- 2. MAIN APPLICATION WORKSPACE -->
    <Grid Grid.Row="1" ColumnDefinitions="260,*">
      
      <!-- LEFT SIDEBAR -->
      <Border Grid.Column="0" Background="#F0FFFFFF" BorderBrush="#BAE6FD" BorderThickness="0,0,1,0" Padding="16,18">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16">
          
          <!-- LOGO & BRAND -->
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
            <Border Width="42" Height="42" CornerRadius="14" Background="White" BorderBrush="#BAE6FD" BorderThickness="1" BoxShadow="0 4 12 0 #0D0284C7" VerticalAlignment="Center" Padding="4">
              <Image Source="avares://HallzeeSync.Universal/Assets/hallzee-logo.png" Width="32" Height="32" VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
              <TextBlock Text="Hallzee" FontSize="18" FontWeight="Black" Foreground="#0F172A" LetterSpacing="0.5" />
              <TextBlock Text="Classroom hall passes" FontSize="11" FontWeight="Bold" Foreground="#0369A1" />
            </StackPanel>
          </Grid>

          <!-- CLASSROOM PROFILE BOX -->
          <Border Grid.Row="1" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="16" Padding="14,12" BoxShadow="0 1 3 0 #0A0284C7">
            <StackPanel Spacing="4">
              <TextBlock Text="CLASSROOM PROFILE" FontSize="10" FontWeight="SemiBold" Foreground="#475569" LetterSpacing="0.6" />
              <TextBlock Text="{Binding ActiveProfile.Name}" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,1,0,0" />
              <TextBlock Text="{Binding ProfileDetails}" FontSize="12" Foreground="#475569" FontWeight="Medium" />
              <TextBlock Text="{Binding ProfileTeacher}" FontSize="12" Foreground="#475569" />
            </StackPanel>
          </Border>

          <!-- NAVIGATION MENU -->
          <StackPanel Grid.Row="2" Spacing="6">
            
            <!-- Dashboard (Active) -->
            <Button Classes="sidebar-nav-active" Click="OnDashboardClick">
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Path Data="{StaticResource IconLaptop}" Width="24" Height="24" Stroke="White" StrokeThickness="2.2" StrokeLineCap="Round" VerticalAlignment="Center" />
                <TextBlock Text="Dashboard" FontWeight="Bold" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <!-- Trip History -->
            <Button Classes="sidebar-nav" Click="OnTripsClick">
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Path Data="{StaticResource IconHistory}" Width="24" Height="24" Stroke="#0F172A" StrokeThickness="2.2" StrokeLineCap="Round" VerticalAlignment="Center" />
                <TextBlock Text="Trip History Log" FontWeight="Bold" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <!-- Student Roster -->
            <Button Classes="sidebar-nav" Click="OnRosterClick">
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Path Data="{StaticResource IconUsers}" Width="24" Height="24" Stroke="#0F172A" StrokeThickness="2.2" StrokeLineCap="Round" VerticalAlignment="Center" />
                <TextBlock Text="Student Roster" FontWeight="Bold" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <!-- Policies & Bell Times -->
            <Button Classes="sidebar-nav" Click="OnPoliciesClick">
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Path Data="{StaticResource IconCalendar}" Width="24" Height="24" Stroke="#0F172A" StrokeThickness="2.2" StrokeLineCap="Round" VerticalAlignment="Center" />
                <TextBlock Text="Policies &amp; Bell Times" FontWeight="Bold" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <!-- Settings -->
            <Button Classes="sidebar-nav" Click="OnSettingsClick">
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Path Data="{StaticResource IconSettings}" Width="24" Height="24" Stroke="#0F172A" StrokeThickness="2.2" StrokeLineCap="Round" VerticalAlignment="Center" />
                <TextBlock Text="Settings" FontWeight="Bold" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <WrapPanel>
              <Button Classes="secondary" Content="Help" Click="OnHelpClick" ToolTip.Tip="Open the teacher guide, downloads, and troubleshooting" Margin="0,4,6,0" />
              <Button Classes="secondary" Content="Updates" Click="OnUpdatesClick" ToolTip.Tip="Check for desktop and terminal updates; internet required" Margin="0,4,0,0" />
            </WrapPanel>
            <TextBlock Text="A new desktop version is available." IsVisible="{Binding DesktopUpdateAvailable}" TextWrapping="Wrap" Foreground="#0369A1" FontSize="11" />
          </StackPanel>

          <!-- BOTTOM TERMINAL NODE BOX -->
          <Border Grid.Row="3" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="16" Padding="14" BoxShadow="0 1 3 0 #0A0284C7">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <TextBlock Text="TERMINAL NODE" FontSize="10" FontWeight="SemiBold" Foreground="#475569" LetterSpacing="0.6" VerticalAlignment="Center" />
                <Border Grid.Column="1" Classes="status-pill" Background="{Binding ConnectionBadgeBackground}">
                  <TextBlock Text="{Binding TopStatusBadgeText}" Foreground="{Binding ConnectionBadgeForeground}" />
                </Border>
              </Grid>

              <TextBlock Text="Terminal clock is set when you sync" FontSize="11" Foreground="#475569" />

              <!-- DEVICE FRIENDLY NAME & LINK INFO -->
              <Border Background="White" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="12" Padding="10,8" Margin="0,2,0,0">
                <StackPanel Spacing="3">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconRadio}" Width="12" Height="12" Stretch="Uniform" Stroke="#0284C7" StrokeThickness="2" StrokeLineCap="Round" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding TerminalFriendlyNameDisplay}" FontSize="11" FontWeight="Bold" Foreground="#0F172A" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  </Grid>
                  <TextBlock Text="{Binding TerminalTransportInfoDisplay}" FontSize="10" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="18,0,0,0" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </Grid>
        </ScrollViewer>
      </Border>

      <!-- MAIN DASHBOARD CONTENT -->
      <Grid Grid.Column="1">
        <views:DashboardView />
      </Grid>
    </Grid>

    <!-- MODAL DIALOG OVERLAYS -->
    <views:TripsModalView Grid.RowSpan="2" IsVisible="{Binding IsTripsModalVisible}" />
    <views:RosterModalView Grid.RowSpan="2" IsVisible="{Binding IsRosterModalVisible}" />
    <views:PoliciesModalView Grid.RowSpan="2" IsVisible="{Binding IsPoliciesModalVisible}" />
    <views:TerminalSettingsModalView Grid.RowSpan="2" IsVisible="{Binding IsTerminalSettingsModalVisible}" />
    <views:FindTerminalsModalView Grid.RowSpan="2" IsVisible="{Binding IsFindTerminalsModalVisible}" />
    <views:ManualCheckInModalView Grid.RowSpan="2" IsVisible="{Binding IsManualCheckInModalVisible}" />

    <Border Grid.RowSpan="2" IsVisible="{Binding IsReconnectPromptVisible}"
            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,72,0,0"
            Background="White" BorderBrush="#BAE6FD" BorderThickness="1"
            CornerRadius="14" Padding="18" BoxShadow="0 6 20 0 #40000000">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" MinWidth="520">
        <StackPanel Spacing="3">
          <TextBlock Text="{Binding ReconnectPromptTitle}" FontWeight="Bold" Foreground="#0F172A" />
          <TextBlock Text="{Binding ReconnectPromptDetail}" FontSize="12" Foreground="#475569" TextWrapping="Wrap" />
          <TextBlock Text="{Binding ReconnectCandidateName}" FontSize="12" Foreground="#0369A1" />
        </StackPanel>
        <Button Grid.Column="1" Classes="secondary" Content="Not now" Click="OnDismissReconnectClick" Padding="12,7" />
        <Button Grid.Column="2" Classes="hallzee-pill-btn" Content="Reconnect" Click="OnReconnectClick" Padding="14,7" IsVisible="{Binding !IsReconnecting}" />
      </Grid>
    </Border>
  </Grid>
</Window>
