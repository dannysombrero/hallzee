<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BathroomSync.Universal.ViewModels;assembly=HallzeeSync.Universal"
        xmlns:views="clr-namespace:BathroomSync.Universal.Views;assembly=HallzeeSync.Universal"
        x:Class="BathroomSync.Universal.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1080" Height="720" MinWidth="880" MinHeight="600"
        Title="Hallzee · Classroom Hall Pass Manager"
        Background="#F8FAFC">
  
  <Grid>
    <!-- MAIN APPLICATION SHELL -->
    <Grid ColumnDefinitions="240,*">
      
      <!-- LEFT NAVIGATION SIDEBAR -->
      <Border Grid.Column="0" Background="#0F172A" Padding="16,20">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="20">
          
          <!-- BRAND LOGO & TITLE -->
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
            <Image Grid.Column="0" Source="avares://HallzeeSync.Universal/Assets/hallzee-logo.png" Width="36" Height="36" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
              <TextBlock Text="Hallzee" FontSize="20" FontWeight="Black" Foreground="White" LetterSpacing="0.5" />
              <TextBlock Text="Classroom Pass" FontSize="11" Foreground="#94A3B8" />
            </StackPanel>
          </Grid>

          <!-- CLASSROOM PROFILE PICKER -->
          <Border Grid.Row="1" Background="#1E293B" CornerRadius="10" Padding="12,10">
            <StackPanel Spacing="4">
              <TextBlock Text="ACTIVE PROFILE" FontSize="10" FontWeight="Bold" Foreground="#64748B" LetterSpacing="0.5" />
              <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding ActiveProfile}" HorizontalAlignment="Stretch" Background="Transparent" Foreground="White">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Name}" Foreground="White" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
          </Border>

          <!-- NAVIGATION LINKS -->
          <StackPanel Grid.Row="2" Spacing="4">
            <Button Classes="nav" Click="OnDashboardClick">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="📊" FontSize="16" />
                <TextBlock Text="Dashboard" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <Button Classes="nav" Click="OnTripsClick">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="📋" FontSize="16" />
                <TextBlock Text="Trip History" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <Button Classes="nav" Click="OnRosterClick">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="👥" FontSize="16" />
                <TextBlock Text="Class Roster" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <Button Classes="nav" Click="OnPoliciesClick">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="⚙️" FontSize="16" />
                <TextBlock Text="Policies &amp; Schedule" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <Button Classes="nav" Click="OnTerminalSettingsClick">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="📟" FontSize="16" />
                <TextBlock Text="Kiosk Settings" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>

          <!-- BOTTOM QUICK ACTIONS -->
          <StackPanel Grid.Row="3" Spacing="8">
            <Button Classes="secondary" HorizontalAlignment="Stretch" Click="OnFindTerminalsClick">
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <TextBlock Text="📡" />
                <TextBlock Text="Find Terminal" />
              </StackPanel>
            </Button>

            <Button Classes="primary" HorizontalAlignment="Stretch" Click="OnSyncNowClick" IsEnabled="{Binding !IsSyncing}">
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <TextBlock Text="🔄" />
                <TextBlock Text="Sync Now" />
              </StackPanel>
            </Button>

            <Button Classes="nav" HorizontalAlignment="Center" Click="OnDisconnectClick" IsVisible="{Binding IsConnected}">
              <TextBlock Text="⚡ Disconnect" FontSize="11" Foreground="#94A3B8" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- MAIN CONTENT AREA -->
      <Grid Grid.Column="1" RowDefinitions="Auto,*">
        
        <!-- HEADER BAR -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="28,16">
          <Grid ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center">
            
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <TextBlock Text="{Binding ActiveProfile.Name}" FontSize="18" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
              <TextBlock Text="·" Foreground="#CBD5E1" VerticalAlignment="Center" />
              <TextBlock Text="{Binding LastSyncTimeText, StringFormat='Last sync: {0}'}" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
            </StackPanel>

            <Border Grid.Column="1" Background="{Binding ConnectionBadgeBackground}" CornerRadius="16" Padding="12,5" Margin="0,0,14,0" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Border Width="8" Height="8" CornerRadius="4" Background="{Binding ConnectionStatusColor}" />
                <TextBlock Text="{Binding ConnectionStatusText}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding ConnectionStatusColor}" />
              </StackPanel>
            </Border>

            <Button Grid.Column="2" Classes="primary" Content="Sync" Click="OnSyncNowClick" IsEnabled="{Binding !IsSyncing}" />
          </Grid>
        </Border>

        <!-- DASHBOARD VIEW -->
        <views:DashboardView Grid.Row="1" />
      </Grid>
    </Grid>

    <!-- MODAL DIALOG OVERLAYS -->
    <views:TripsModalView IsVisible="{Binding IsTripsModalVisible}" />
    <views:RosterModalView IsVisible="{Binding IsRosterModalVisible}" />
    <views:PoliciesModalView IsVisible="{Binding IsPoliciesModalVisible}" />
    <views:TerminalSettingsModalView IsVisible="{Binding IsTerminalSettingsModalVisible}" />
    <views:FindTerminalsModalView IsVisible="{Binding IsFindTerminalsModalVisible}" />
  </Grid>
</Window>
