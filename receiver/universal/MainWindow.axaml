<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BathroomSync.Universal.MainWindow"
        Width="920" Height="620" MinWidth="760" MinHeight="540"
        Title="{Binding WindowTitle}">
  <Grid RowDefinitions="Auto,*,Auto" Background="#F5F8FB">
    <Border Padding="32,26" Background="#103A5B">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
        <Image Grid.Column="0" Source="avares://HallzeeSync.Universal/Assets/hallzee-logo.png" Width="44" Height="44" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
          <TextBlock Text="Hallzee" FontSize="28" FontWeight="Bold" Foreground="White" />
          <TextBlock Text="{Binding ModeDescription}" FontSize="14" Foreground="#CFE6F7" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid Margin="32,28" MinWidth="696" ColumnDefinitions="1.15*,0.85*" ColumnSpacing="22">
      <StackPanel Spacing="18">
        <Border Background="White" CornerRadius="14" Padding="22">
          <StackPanel Spacing="16">
            <TextBlock Text="Connect a terminal" FontSize="20" FontWeight="SemiBold" Foreground="#16324A" />
            <TextBlock Text="Find the nearby Hallzee, then start a secure sync." TextWrapping="Wrap" Foreground="#5B6B7A" />
            <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
              <Button Grid.Column="0" Classes="secondary" Content="Find terminal" Click="FindTerminal" IsEnabled="{Binding CanFind}" />
              <Button Grid.Column="1" Classes="primary" Content="Sync now" Click="SyncNow" IsEnabled="{Binding CanSync}" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Background="White" CornerRadius="14" Padding="22">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
            <Border Width="12" Height="12" CornerRadius="6" Background="{Binding StatusColor}" VerticalAlignment="Top" Margin="2,5,0,0" />
            <StackPanel Grid.Column="1" Spacing="3">
              <TextBlock Text="{Binding StatusTitle}" FontSize="16" FontWeight="SemiBold" Foreground="#16324A" />
              <TextBlock Text="{Binding StatusDetail}" TextWrapping="Wrap" Foreground="#5B6B7A" />
              <StackPanel IsVisible="{Binding HasTransferProgress}" Spacing="6" Margin="0,10,0,0">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Transfer progress" FontWeight="SemiBold" Foreground="#16324A" />
                  <TextBlock Grid.Column="1" Text="{Binding TransferProgressText}" Foreground="#326346" />
                </Grid>
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding TransferProgressPercent}" Height="10" />
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>

        <Border Background="#E7F3EC" CornerRadius="14" Padding="20">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="3">
              <TextBlock Text="Trips saved this session" Foreground="#326346" />
              <TextBlock Text="{Binding SavedTrips}" FontSize="30" FontWeight="Bold" Foreground="#1A6B3C" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="✓" FontSize="34" Foreground="#2C8A50" VerticalAlignment="Center" />
          </Grid>
        </Border>
      </StackPanel>

      <Border Grid.Column="1" Background="#102B40" CornerRadius="14" Padding="20" MaxHeight="430">
        <Grid RowDefinitions="Auto,*" RowSpacing="12">
          <TextBlock Text="Sync activity" FontSize="18" FontWeight="SemiBold" Foreground="White" />
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding LogEntries}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Menlo, monospace" FontSize="12" Foreground="#CFE6F7" TextWrapping="Wrap" Margin="0,0,0,8" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
    </ScrollViewer>

    <Border Grid.Row="2" Padding="22,16" Background="White" BorderBrush="#DCE5EC" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
        <TextBlock Text="{Binding FooterDescription}" VerticalAlignment="Center" Foreground="#5B6B7A" />
        <Button Grid.Column="1" Classes="secondary" Content="Open export folder" Click="OpenExportFolder" />
        <Button Grid.Column="2" Classes="secondary" Content="Save CSV as…" Click="SaveCsvAs" />
      </Grid>
    </Border>
  </Grid>
</Window>
