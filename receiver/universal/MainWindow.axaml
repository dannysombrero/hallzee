<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BathroomSync.Universal.ViewModels;assembly=HallzeeSync.Universal"
        xmlns:views="clr-namespace:BathroomSync.Universal.Views;assembly=HallzeeSync.Universal"
        x:Class="BathroomSync.Universal.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1120" Height="740" MinWidth="940" MinHeight="640"
        Title="Hallzee Desktop Client · Room 204 • Period 3 (Chemistry AP)"
        Background="#EBF5FB">
  
  <Grid RowDefinitions="Auto,*">
    
    <!-- 1. TOP WINDOW BAR -->
    <Border Grid.Row="0" Background="{StaticResource HallzeeWindowHeaderGradient}" Padding="16,8" BorderBrush="#38BDF8" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Image Source="avares://HallzeeSync.Universal/Assets/hallzee-logo.png" Width="18" Height="18" VerticalAlignment="Center" />
          <TextBlock Text="Hallzee Desktop Client" FontWeight="Bold" FontSize="12" Foreground="White" VerticalAlignment="Center" />
          <TextBlock Text="|" Foreground="#7DD3FC" VerticalAlignment="Center" Margin="4,0" />
          <TextBlock Text="{Binding ActiveProfile.Name}" FontSize="12" Foreground="#F0F9FF" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <TextBlock Text="v1.5.2-win64" FontSize="11" FontFamily="Cascadia Mono, Menlo, monospace" Foreground="#E0F2FE" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- 2. MAIN APPLICATION WORKSPACE -->
    <Grid Grid.Row="1" ColumnDefinitions="260,*">
      
      <!-- LEFT SIDEBAR -->
      <Border Grid.Column="0" Background="White" BorderBrush="#BAE6FD" BorderThickness="0,0,1,0" Padding="16,18">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16">
          
          <!-- LOGO & BRAND -->
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
            <Border Width="42" Height="42" CornerRadius="14" Background="White" BorderBrush="#BAE6FD" BorderThickness="1" BoxShadow="0 4 12 0 #0D0284C7" VerticalAlignment="Center" Padding="4">
              <Image Source="avares://HallzeeSync.Universal/Assets/hallzee-logo.png" Width="32" Height="32" VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
              <TextBlock Text="Hallzee" FontSize="18" FontWeight="Black" Foreground="#0F172A" LetterSpacing="0.5" />
              <TextBlock Text="Terminal Gateway" FontSize="11" FontWeight="Bold" Foreground="#0369A1" />
            </StackPanel>
          </Grid>

          <!-- CLASSROOM PROFILE BOX -->
          <Border Grid.Row="1" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="16" Padding="12,10">
            <StackPanel Spacing="3">
              <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <TextBlock Text="CLASSROOM PROFILE" FontSize="10" FontWeight="ExtraBold" Foreground="#64748B" LetterSpacing="0.5" />
                <Border Grid.Column="1" Background="#DCFCE7" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="10" Padding="8,1">
                  <TextBlock Text="Active" FontSize="10" FontWeight="ExtraBold" Foreground="#166534" />
                </Border>
              </Grid>

              <TextBlock Text="{Binding ActiveProfile.Name}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0" />
              <TextBlock Text="{Binding ProfileDetails}" FontSize="11" Foreground="#475569" FontWeight="Medium" />
              <TextBlock Text="{Binding ProfileTeacher}" FontSize="11" Foreground="#64748B" />
            </StackPanel>
          </Border>

          <!-- NAVIGATION MENU -->
          <StackPanel Grid.Row="2" Spacing="6">
            
            <!-- Dashboard (Active) -->
            <Button Classes="sidebar-nav-active" Click="OnDashboardClick">
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <PathIcon Data="{StaticResource IconLaptop}" Width="16" Height="16" Foreground="White" VerticalAlignment="Center" />
                <TextBlock Text="Dashboard Overview" FontWeight="Bold" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <!-- Trip History -->
            <Button Classes="sidebar-nav" Click="OnTripsClick">
              <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                  <PathIcon Data="{StaticResource IconHistory}" Width="16" Height="16" Foreground="#0F172A" VerticalAlignment="Center" />
                  <TextBlock Text="Trip History Log" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
                <Border Grid.Column="1" Background="#E0F2FE" CornerRadius="10" Padding="8,2" Margin="0,0,4,0">
                  <TextBlock Text="{Binding Dashboard.RecentTrips.Count, FallbackValue='5'}" FontSize="10" FontWeight="Bold" Foreground="#0369A1" />
                </Border>
              </Grid>
            </Button>

            <!-- Student Roster -->
            <Button Classes="sidebar-nav" Click="OnRosterClick">
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <PathIcon Data="{StaticResource IconUsers}" Width="16" Height="16" Foreground="#0F172A" VerticalAlignment="Center" />
                <TextBlock Text="Student Roster Import" FontWeight="Bold" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <!-- Policies & Bell Times -->
            <Button Classes="sidebar-nav" Click="OnPoliciesClick">
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <PathIcon Data="{StaticResource IconCalendar}" Width="16" Height="16" Foreground="#0F172A" VerticalAlignment="Center" />
                <TextBlock Text="Policies &amp; Bell Times" FontWeight="Bold" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <!-- Terminal Settings -->
            <Button Classes="sidebar-nav" Click="OnTerminalSettingsClick">
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <PathIcon Data="{StaticResource IconRadio}" Width="16" Height="16" Foreground="#0F172A" VerticalAlignment="Center" />
                <TextBlock Text="Terminal Settings" FontWeight="Bold" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <!-- App Settings -->
            <Button Classes="sidebar-nav" Click="OnTerminalSettingsClick">
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <PathIcon Data="{StaticResource IconSettings}" Width="16" Height="16" Foreground="#0F172A" VerticalAlignment="Center" />
                <TextBlock Text="App Settings" FontWeight="Bold" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>

          <!-- BOTTOM TERMINAL NODE BOX -->
          <Border Grid.Row="3" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="16" Padding="12,10">
            <StackPanel Spacing="4">
              <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <TextBlock Text="TERMINAL NODE" FontSize="10" FontWeight="ExtraBold" Foreground="#64748B" LetterSpacing="0.5" />
                <Border Grid.Column="1" Background="{Binding ConnectionBadgeBackground}" CornerRadius="10" Padding="8,2">
                  <TextBlock Text="{Binding TopStatusBadgeText}" FontSize="9" FontWeight="ExtraBold" Foreground="{Binding ConnectionBadgeForeground}" />
                </Border>
              </Grid>

              <TextBlock Text="{Binding ConnectedTerminalName}" FontSize="11" FontWeight="Bold" FontFamily="Cascadia Mono, Menlo, monospace" Foreground="#0F172A" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="Auto-clock synced with Windows RTC" FontSize="10" Foreground="#64748B" />

              <Button Classes="card-outline" Click="OnTerminalSettingsClick" HorizontalAlignment="Stretch" Padding="8,6" Margin="0,4,0,0">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <PathIcon Data="{StaticResource IconRadio}" Width="12" Height="12" Foreground="#0369A1" VerticalAlignment="Center" />
                  <TextBlock Text="Configure Node" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- MAIN DASHBOARD CONTENT -->
      <Grid Grid.Column="1">
        <views:DashboardView />

        <!-- BOTTOM FLOATING SANDBOX PILL TOOLBAR -->
        <Border Background="#0F172A" CornerRadius="24" Padding="16,8" BoxShadow="0 8 24 0 #40000000" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <TextBlock Text="SANDBOX:" FontSize="11" FontWeight="Black" Foreground="#38BDF8" VerticalAlignment="Center" LetterSpacing="0.5" />
            
            <Button Classes="dark-action" Click="OnSandboxDisconnectClick">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <PathIcon Data="{StaticResource IconZap}" Width="12" Height="12" Foreground="#F59E0B" VerticalAlignment="Center" />
                <TextBlock Text="Disconnect" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <Button Classes="dark-action" Click="OnSandboxStudentOutClick">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <PathIcon Data="{StaticResource IconUsers}" Width="12" Height="12" Foreground="#38BDF8" VerticalAlignment="Center" />
                <TextBlock Text="Student Out" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <Button Classes="dark-action" Click="OnSandboxToggleNameClick">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <PathIcon Data="{StaticResource IconTag}" Width="12" Height="12" Foreground="#34D399" VerticalAlignment="Center" />
                <TextBlock Text="Toggle Name" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>

    <!-- MODAL DIALOG OVERLAYS -->
    <views:TripsModalView Grid.RowSpan="2" IsVisible="{Binding IsTripsModalVisible}" />
    <views:RosterModalView Grid.RowSpan="2" IsVisible="{Binding IsRosterModalVisible}" />
    <views:PoliciesModalView Grid.RowSpan="2" IsVisible="{Binding IsPoliciesModalVisible}" />
    <views:TerminalSettingsModalView Grid.RowSpan="2" IsVisible="{Binding IsTerminalSettingsModalVisible}" />
    <views:FindTerminalsModalView Grid.RowSpan="2" IsVisible="{Binding IsFindTerminalsModalVisible}" />
  </Grid>
</Window>
