<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BathroomSync.Universal.ViewModels;assembly=HallzeeSync.Universal"
        x:Class="BathroomSync.Universal.StudentsOutWindow"
        x:DataType="vm:MainViewModel"
        Width="620" Height="640" MinWidth="440" MinHeight="380"
        Title="Hallzee · Students Out"
        Topmost="True"
        ShowInTaskbar="True"
        Background="#F8FAFC">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20" Spacing="16">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
        <Border Width="42" Height="42" CornerRadius="14" Background="#0284C7">
          <Path Data="{StaticResource IconUsers}" Width="21" Height="21" Stretch="Uniform"
                Stroke="White" StrokeThickness="2" StrokeLineCap="Round"
                HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
          <TextBlock Text="STUDENTS OUT" FontSize="11" FontWeight="Bold" Foreground="#0369A1" LetterSpacing="0.7" />
          <TextBlock Text="Live classroom pass board" FontSize="18" FontWeight="Black" Foreground="#0F172A" />
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding ConnectionStatusText}" FontSize="11" FontWeight="Bold"
                   Foreground="{Binding ConnectionStatusColor}" VerticalAlignment="Center" />
      </Grid>

      <Border Background="White" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="18" Padding="16">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding CurrentPeriodName}" FontSize="17" FontWeight="Black" Foreground="#0F172A" />
              <TextBlock Text="{Binding CurrentPeriodRange}" FontSize="12" Foreground="#64748B" />
            </StackPanel>
            <Border Grid.Column="1" Background="{Binding PeriodWindowAccent}" CornerRadius="12" Padding="10,5" VerticalAlignment="Center">
              <TextBlock Text="{Binding PeriodWindowTitle}" Foreground="White" FontWeight="Bold" FontSize="11" />
            </Border>
          </Grid>
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding CurrentPeriodProgress}" Height="10" />
          <TextBlock Text="{Binding PeriodWindowDetail}" FontSize="13" FontWeight="SemiBold" Foreground="{Binding PeriodWindowAccent}" />
          <Grid ColumnDefinitions="*,*,*" Margin="0,2,0,0">
            <TextBlock Text="FIRST 10" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" />
            <TextBlock Grid.Column="1" Text="OPEN WINDOW" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="LAST 10" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Right" />
          </Grid>
        </StackPanel>
      </Border>

      <Border Background="#EFF6FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="16" Padding="18" IsVisible="{Binding !HasStudentsOut}">
        <StackPanel HorizontalAlignment="Center" Spacing="5">
          <TextBlock Text="No students are currently out" FontSize="17" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" />
          <TextBlock Text="This board updates as students check out and return." FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>

      <Border Background="White" BorderBrush="#FCD34D" BorderThickness="2" CornerRadius="20" Padding="18" IsVisible="{Binding ActivePass.IsOccupied}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
          <Border Width="52" Height="52" CornerRadius="16" Background="#F59E0B">
            <Path Data="{StaticResource IconUserX}" Width="25" Height="25" Stretch="Uniform" Stroke="White" StrokeThickness="2.2" StrokeLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
            <TextBlock Text="{Binding ActivePass.DisplayName}" FontSize="19" FontWeight="Black" Foreground="#0F172A" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding ActivePass.DepartTime, StringFormat='Departed {0}'}" FontSize="12" Foreground="#64748B" />
            <TextBlock Text="{Binding ActivePass.DurationDisplay}" FontSize="22" FontWeight="Black" FontFamily="Cascadia Mono, Menlo, monospace" Foreground="#D97706" />
          </StackPanel>
          <Button Grid.Column="2" Classes="dark-action" Content="Check In" Click="OnCheckInActiveClick" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <ItemsControl ItemsSource="{Binding Dashboard.AdditionalActiveTrips}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="White" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="18" Padding="16" Margin="0,2">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Border Width="42" Height="42" CornerRadius="13" Background="#F59E0B">
                  <Path Data="{StaticResource IconUserX}" Width="20" Height="20" Stretch="Uniform" Stroke="White" StrokeThickness="2" StrokeLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                  <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="Bold" Foreground="#0F172A" />
                  <TextBlock Text="{Binding ElapsedDisplay}" FontSize="14" FontFamily="Cascadia Mono, Menlo, monospace" FontWeight="Bold" Foreground="#D97706" />
                </StackPanel>
                <Button Grid.Column="2" Classes="dark-action" Content="Check In" Tag="{Binding StudentId}" Click="OnCheckInStudentClick" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</Window>
