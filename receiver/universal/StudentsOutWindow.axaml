<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BathroomSync.Universal.ViewModels;assembly=HallzeeSync.Universal"
        x:Class="BathroomSync.Universal.StudentsOutWindow"
        x:DataType="vm:MainViewModel"
        Width="520" Height="280" MinWidth="440" MinHeight="250"
        Title="Hallzee"
        Topmost="True"
        ShowInTaskbar="True"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="44"
        ExtendClientAreaChromeHints="NoChrome"
        Background="Transparent"
        TransparencyLevelHint="Transparent">

  <Window.Styles>
    <Style Selector="Border.popup-center-pill">
      <Setter Property="CornerRadius" Value="26" />
      <Setter Property="Padding" Value="36,12" />
      <Setter Property="MinHeight" Value="52" />
      <Setter Property="BoxShadow" Value="0 4 14 0 #20000000" />
    </Style>
  </Window.Styles>

  <Border Background="White"
          BorderBrush="#38BDF8"
          BorderThickness="2"
          CornerRadius="20"
          ClipToBounds="True"
          PointerPressed="OnWindowPointerPressed">
    <Grid RowDefinitions="Auto,Auto,*">
      <!-- 1. TOP TITLE BAR -->
      <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Height="44" Margin="0" VerticalAlignment="Center">
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <!-- Custom traffic lights (visible on non-macOS platforms) -->
          <StackPanel x:Name="CustomTrafficLights" Orientation="Horizontal" Spacing="6" Margin="16,0,10,0" VerticalAlignment="Center">
            <Button Width="12" Height="12" CornerRadius="6" Background="#FF5F56" BorderThickness="0" Padding="0" Cursor="Hand" Click="OnCloseDotClick" ToolTip.Tip="Close" />
            <Button Width="12" Height="12" CornerRadius="6" Background="#FFBD2E" BorderThickness="0" Padding="0" Cursor="Hand" Click="OnMinimizeDotClick" ToolTip.Tip="Minimize" />
            <Border Width="12" Height="12" CornerRadius="6" Background="#27C93F" />
          </StackPanel>

          <!-- App Title (offset set in code-behind for macOS to clear native traffic lights) -->
          <TextBlock x:Name="TitleText" Text="Hallzee" FontWeight="Bold" FontSize="14" Foreground="#0F172A" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>

      <!-- 2. HEADER DIVIDER -->
      <Border Grid.Row="1" Height="1" Background="#E2E8F0" HorizontalAlignment="Stretch" />

      <!-- 3. BODY CONTENT -->
      <Grid Grid.Row="2" RowDefinitions="Auto,*,Auto" Margin="24,18,24,18">
        <!-- ROW A: Period & Live Clock -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="{Binding CurrentPeriodName}" FontSize="18" FontWeight="Black" Foreground="#0F172A" VerticalAlignment="Center" />
            <TextBlock Text="{Binding FormattedPeriodRange}" FontSize="16" Foreground="#64748B" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding CurrentTimeDisplay}" FontSize="24" FontWeight="Black" Foreground="#0F172A" VerticalAlignment="Center" />
        </Grid>

        <!-- ROW B: Prominent Center Pill Status Indicator (Display Only) -->
        <Border Grid.Row="1"
                Classes="popup-center-pill"
                Background="{Binding PopupPillBackground}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
          <TextBlock Text="{Binding PopupPillText}"
                     Foreground="{Binding PopupPillForeground}"
                     FontSize="20"
                     FontWeight="Black"
                     LetterSpacing="0.8"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Border>

        <!-- ROW C: Bottom Status Line with countdown -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
          <TextBlock Text="{Binding PopupStatusPrefix}" FontSize="14" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" />
          <TextBlock Text="{Binding PopupStatusTimer}" FontSize="15" FontWeight="Black" Foreground="#0F172A" FontFamily="Cascadia Mono, Menlo, monospace" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
