<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BathroomSync.Universal.ViewModels;assembly=Hallzee"
        x:Class="BathroomSync.Universal.StudentsOutWindow"
        x:DataType="vm:MainViewModel"
        Icon="avares://Hallzee/Assets/hallzee.ico"
        Width="540" Height="300" MinWidth="460" MinHeight="270"
        Title="Hallzee"
        Topmost="True"
        ShowInTaskbar="True"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent">

  <Window.Styles>
    <Style Selector="Border.popup-center-pill">
      <Setter Property="CornerRadius" Value="26" />
      <Setter Property="Padding" Value="36,12" />
      <Setter Property="MinHeight" Value="52" />
      <Setter Property="BoxShadow" Value="0 4 14 0 #20000000" />
    </Style>
  </Window.Styles>

  <Border Margin="10"
          Background="White"
          BorderBrush="#38BDF8"
          BorderThickness="2"
          CornerRadius="20"
          BoxShadow="0 8 28 0 #35000000"
          PointerPressed="OnWindowPointerPressed">
    <Grid RowDefinitions="Auto,Auto,*">
      <!-- 1. TOP TITLE BAR -->
      <Border Grid.Row="0" CornerRadius="18,18,0,0" Background="#F8FAFC">
        <Grid ColumnDefinitions="Auto,*,Auto" Height="38" VerticalAlignment="Center">
          <!-- Custom traffic lights at top-left (Close & Minimize) -->
          <StackPanel x:Name="CustomTrafficLights" Orientation="Horizontal" Spacing="7" Margin="14,0,10,0" VerticalAlignment="Center">
            <Button Width="13" Height="13" CornerRadius="7" Background="#FF5F56" BorderBrush="#E0443E" BorderThickness="0.5" Padding="0" Cursor="Hand" Click="OnCloseDotClick" ToolTip.Tip="Close (Esc)" />
            <Button Width="13" Height="13" CornerRadius="7" Background="#FFBD2E" BorderBrush="#DEA123" BorderThickness="0.5" Padding="0" Cursor="Hand" Click="OnMinimizeDotClick" ToolTip.Tip="Minimize" />
          </StackPanel>

          <!-- App Title centered -->
          <TextBlock x:Name="TitleText" Grid.Column="1" Text="Hallzee" FontWeight="Bold" FontSize="13" Foreground="#334155" HorizontalAlignment="Center" VerticalAlignment="Center" />

          <!-- Top Right spacer to balance traffic lights -->
          <Border Grid.Column="2" Width="48" Height="1" />
        </Grid>
      </Border>

      <!-- 2. HEADER DIVIDER -->
      <Border Grid.Row="1" Height="1" Background="#E2E8F0" HorizontalAlignment="Stretch" />

      <!-- 3. BODY CONTENT -->
      <Grid Grid.Row="2" RowDefinitions="Auto,*,Auto" Margin="24,18,24,18">
        <!-- ROW A: Period & Live Clock -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" ToolTip.Tip="{Binding PopupPillToolTip}">
            <TextBlock Text="{Binding CurrentPeriodName}" FontSize="18" FontWeight="Black" Foreground="#0F172A" VerticalAlignment="Center" />
            <TextBlock Text="{Binding FormattedPeriodRange}" FontSize="16" Foreground="#64748B" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding CurrentTimeDisplay}" FontSize="24" FontWeight="Black" Foreground="#0F172A" VerticalAlignment="Center" />
        </Grid>

        <!-- ROW B: Prominent Center Pill Status Indicator (Display Only) -->
        <Border Grid.Row="1"
                Classes="popup-center-pill"
                Background="{Binding PopupPillBackground}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                ToolTip.Tip="{Binding PopupPillToolTip}">
          <TextBlock Text="{Binding PopupPillText}"
                     Foreground="{Binding PopupPillForeground}"
                     FontSize="20"
                     FontWeight="Black"
                     LetterSpacing="0.8"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Border>

        <!-- ROW C: Bottom Status Line with countdown -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
          <TextBlock Text="{Binding PopupStatusPrefix}" FontSize="14" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" />
          <TextBlock Text="{Binding PopupStatusTimer}" FontSize="15" FontWeight="Black" Foreground="#0F172A" FontFamily="Cascadia Mono, Menlo, monospace" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
