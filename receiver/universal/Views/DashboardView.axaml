<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BathroomSync.Universal.ViewModels;assembly=HallzeeSync.Universal"
             x:Class="BathroomSync.Universal.Views.DashboardView"
             x:DataType="vm:MainViewModel">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,20" Spacing="20" MaxWidth="1100">
      
      <!-- 1. TOP TERMINAL STATUS STRIP -->
      <Border Background="White" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="20" BoxShadow="0 4 16 0 #0D0284C7" Padding="18,14">
        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
          
          <!-- TERMINAL AVATAR / ICON -->
          <Border Grid.Column="0" Width="48" Height="48" CornerRadius="16" Background="{Binding TerminalAvatarBackground}" VerticalAlignment="Center" Margin="0,0,16,0">
            <PathIcon Data="{StaticResource IconRadio}" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
          </Border>

          <!-- TERMINAL DETAILS -->
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <TextBlock Text="{Binding ConnectedTerminalName}" FontSize="16" FontWeight="ExtraBold" Foreground="#0F172A" VerticalAlignment="Center" />
              <Border Background="{Binding TopStatusBadgeBackground}" CornerRadius="12" Padding="10,2" VerticalAlignment="Center">
                <TextBlock Text="{Binding TopStatusBadgeText}" FontWeight="ExtraBold" FontSize="10" Foreground="{Binding TopStatusBadgeForeground}" LetterSpacing="0.5" />
              </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="Last successful sync:" FontSize="12" Foreground="#64748B" />
              <TextBlock Text="{Binding LastSyncTimeText}" FontSize="12" FontWeight="Bold" Foreground="#0F172A" />
            </StackPanel>
          </StackPanel>

          <!-- ACTION BUTTONS -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <!-- Connected Actions -->
            <Button Classes="hallzee-pill-btn" Click="OnSyncClick" IsEnabled="{Binding !IsSyncing}" IsVisible="{Binding IsConnected}">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <PathIcon Data="{StaticResource IconSync}" Width="16" Height="16" VerticalAlignment="Center" Foreground="White" />
                <TextBlock Text="{Binding SyncButtonText}" FontSize="11" FontWeight="Bold" LineHeight="12" />
              </StackPanel>
            </Button>
            <TextBlock Text="{Binding SyncProgressText}" FontSize="12" Foreground="#0369A1" VerticalAlignment="Center" IsVisible="{Binding IsSyncing}" Margin="12,0,0,0" />
            <Button Classes="card-outline" Content="Configure Node" Click="OnConfigureNodeClick" IsVisible="{Binding IsConnected}" />

            <!-- Disconnected Action: Scan for devices -->
            <Button Classes="hallzee-pill-btn" Click="OnScanForDevicesClick" IsVisible="{Binding !IsConnected}">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <PathIcon Data="{StaticResource IconSearch}" Width="16" Height="16" VerticalAlignment="Center" Foreground="White" />
                <TextBlock Text="Scan for devices" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- 2. HERO ACTIVE PASS CARD -->
      <Border Background="{Binding ActivePass.HeroCardBackground}" BorderBrush="{Binding ActivePass.HeroCardBorderBrush}" BorderThickness="2" CornerRadius="22" BoxShadow="0 4 20 0 #0D000000" Padding="20">
        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
          
          <!-- LEFT: AVATAR & PASS DETAILS -->
          <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center" Margin="0,0,16,0">
            <Border Grid.Column="0" Width="56" Height="56" CornerRadius="18" Background="{Binding ActivePass.AvatarBackground}" Margin="0,0,16,0" VerticalAlignment="Center">
              <Panel>
                <PathIcon Data="{StaticResource IconUserX}" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" IsVisible="{Binding ActivePass.IsOccupied}" />
                <PathIcon Data="{StaticResource IconUserCheck}" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" IsVisible="{Binding !ActivePass.IsOccupied}" />
              </Panel>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
              <Border Background="{Binding ActivePass.BadgeColor}" CornerRadius="12" Padding="10,2" HorizontalAlignment="Left">
                <TextBlock Text="{Binding ActivePass.BadgeText}" FontWeight="ExtraBold" FontSize="10" Foreground="White" LetterSpacing="0.5" />
              </Border>

              <TextBlock Text="{Binding ActivePass.HeadingText}" FontSize="22" FontWeight="Black" Foreground="#0F172A" />
              <TextBlock Text="{Binding ActivePass.SubtitleText}" FontSize="13" Foreground="#475569" FontWeight="Medium" />
            </StackPanel>
          </Grid>

          <!-- RIGHT: FLOATING ELAPSED TIMER CARD -->
          <Border Grid.Column="1" Background="White" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="18" Padding="18,12" BoxShadow="0 4 12 0 #08000000" MinWidth="260">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
              <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="TRIP ELAPSED" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" LetterSpacing="0.5" />
                <TextBlock Text="{Binding ActivePass.DurationDisplay}" FontSize="24" FontWeight="Black" FontFamily="Cascadia Mono, Menlo, monospace" Foreground="{Binding ActivePass.TimerTextColor}" />
                <TextBlock Text="{Binding ActivePass.StudentId, StringFormat='Student ID: #{0}', FallbackValue='Door kiosk live'}" FontSize="11" Foreground="#64748B" FontWeight="SemiBold" />
              </StackPanel>

              <Button Grid.Column="1" Classes="dark-action" Content="Check In" Click="OnToggleOccupancyClick" IsVisible="{Binding ActivePass.IsOccupied}" Margin="14,0,0,0" VerticalAlignment="Center" />
            </Grid>
          </Border>
        </Grid>
      </Border>

      <!-- ADDITIONAL ACTIVE PASSES -->
      <ItemsControl ItemsSource="{Binding Dashboard.AdditionalActiveTrips}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="#FFFBEB" BorderBrush="#FCD34D" BorderThickness="2" CornerRadius="22" BoxShadow="0 4 20 0 #0D000000" Padding="20" Margin="0,10">
              <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <Border Width="56" Height="56" CornerRadius="18" Background="#F59E0B" Margin="0,0,16,0" VerticalAlignment="Center">
                  <PathIcon Data="{StaticResource IconUserX}" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                  <Border Background="#F59E0B" CornerRadius="12" Padding="10,2" HorizontalAlignment="Left">
                    <TextBlock Text="PASS OCCUPIED" FontWeight="ExtraBold" FontSize="10" Foreground="White" LetterSpacing="0.5" />
                  </Border>
                  <TextBlock Text="{Binding DisplayName, StringFormat='{}{0} is Out of Class'}" FontSize="22" FontWeight="Black" Foreground="#0F172A" />
                  <TextBlock Text="{Binding TimeOut, StringFormat='Departed at {0}.'}" FontSize="13" Foreground="#475569" FontWeight="Medium" />
                </StackPanel>
                <Border Grid.Column="2" Background="White" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="18" Padding="18,12" MinWidth="160">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <StackPanel Spacing="2">
                    <TextBlock Text="TRIP ELAPSED" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" LetterSpacing="0.5" />
                    <TextBlock Text="{Binding ElapsedDisplay}" FontSize="24" FontWeight="Black" FontFamily="Cascadia Mono, Menlo, monospace" Foreground="#D97706" />
                    <TextBlock Text="{Binding StudentId, StringFormat='Student ID: #{0}'}" FontSize="11" Foreground="#64748B" FontWeight="SemiBold" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="dark-action" Content="Check In" Click="OnCheckInStudentClick" Tag="{Binding StudentId}" VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- 3. MAIN DASHBOARD 2-COLUMN GRID -->
      <Grid ColumnDefinitions="1.8*,1.2*" ColumnSpacing="20">
        
        <!-- LEFT COLUMN: RECENT HALL PASS ACTIVITY (2/3 width) -->
        <Border Grid.Column="0" Background="White" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="22" BoxShadow="0 4 16 0 #0A0284C7" Padding="20">
          <Grid RowDefinitions="Auto,*">
            
            <!-- HEADER -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14" VerticalAlignment="Center">
              <StackPanel Spacing="2">
                <TextBlock Text="Recent Hall Pass Activity" FontSize="16" FontWeight="ExtraBold" Foreground="#0F172A" />
                <TextBlock Text="Latest completed student trips" FontSize="12" Foreground="#64748B" />
              </StackPanel>

              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Classes="card-outline" Click="OnExportCsvClick" Padding="10,6">
                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource IconDownload}" Width="12" Height="12" Foreground="#0369A1" />
                    <TextBlock Text="Export CSV" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                
                <Button Classes="secondary" Click="OnViewAllClick" Padding="10,6">
                  <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="View All History" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                    <PathIcon Data="{StaticResource IconChevronRight}" Width="10" Height="10" Foreground="#0369A1" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>

            <!-- TRIP ROWS LIST -->
            <StackPanel Grid.Row="1" Spacing="8">
              <ItemsControl ItemsSource="{Binding Dashboard.RecentTrips}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="#F8FAFC" BorderBrush="#E0F2FE" BorderThickness="1" CornerRadius="14" Padding="12,10" Margin="0,2">
                      <Grid ColumnDefinitions="Auto,2*,3*,Auto" ColumnSpacing="18" VerticalAlignment="Center">
                        
                        <!-- AVATAR ICON -->
                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="12" Background="{Binding AvatarBackground}" Margin="0,0,12,0" VerticalAlignment="Center">
                          <PathIcon Data="{StaticResource IconUserCheck}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#166534" />
                        </Border>

                        <!-- STUDENT DETAILS -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                          <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="13" Foreground="#0F172A" />
                          <TextBlock Text="{Binding StudentId, StringFormat='ID: #{0}'}" FontSize="11" Foreground="#64748B" />
                        </StackPanel>

                        <!-- TRIP TIMES -->
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                          <Grid ColumnDefinitions="28,Auto">
                            <TextBlock Text="Out:" FontSize="11" Foreground="#64748B" />
                            <TextBlock Grid.Column="1" Text="{Binding TimeOut}" FontSize="11" Foreground="#64748B" />
                          </Grid>
                          <Grid ColumnDefinitions="28,Auto">
                            <TextBlock Text="In:" FontSize="11" Foreground="#64748B" />
                            <TextBlock Grid.Column="1" Text="{Binding TimeIn}" FontSize="11" Foreground="#64748B" />
                          </Grid>
                        </StackPanel>

                        <!-- DURATION & STATUS PILL -->
                        <StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
                          <TextBlock Text="{Binding DurationText}" FontWeight="Bold" FontSize="12" Foreground="#0F172A" HorizontalAlignment="Right" />
                          <Border Background="{Binding StatusBackground}" CornerRadius="10" Padding="8,2" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding StatusText}" FontSize="9" FontWeight="ExtraBold" Foreground="{Binding StatusForeground}" />
                          </Border>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Grid>
        </Border>

        <!-- RIGHT COLUMN: ROSTER & PASS POLICY CARD (1/3 width) -->
        <Border Grid.Column="1" Background="White" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="22" BoxShadow="0 4 16 0 #0A0284C7" Padding="20">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="14">
            
            <!-- HEADER -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalAlignment="Center">
              <Border Width="28" Height="28" CornerRadius="8" Background="#E0F2FE" VerticalAlignment="Center">
                <PathIcon Data="{StaticResource IconShieldCheck}" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#0284C7" />
              </Border>
              <TextBlock Grid.Column="1" Text="Roster &amp; Pass Policy" FontSize="16" FontWeight="ExtraBold" Foreground="#0F172A" VerticalAlignment="Center" />
            </Grid>

            <!-- INSET CONTAINER 1: PASS POLICY -->
            <Border Grid.Row="1" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="16" Padding="14">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Pass Capacity:" FontSize="12" Foreground="#475569" />
                  <TextBlock Grid.Column="1" Text="{Binding PolicyModal.MaxSimultaneousPasses, StringFormat='{}{0} student(s)'}" FontSize="12" FontWeight="ExtraBold" Foreground="#0F172A" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Overdue Warning:" FontSize="12" Foreground="#475569" />
                  <TextBlock Grid.Column="1" Text="8 minutes" FontSize="12" FontWeight="ExtraBold" Foreground="#D97706" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Daily Max:" FontSize="12" Foreground="#475569" />
                  <TextBlock Grid.Column="1" Text="{Binding PolicyModal.MaxDailyPasses, StringFormat='{}{0} trips'}" FontSize="12" FontWeight="ExtraBold" Foreground="#0F172A" />
                </Grid>
              </StackPanel>
            </Border>

            <!-- INSET CONTAINER 2: LOADED ROSTER CSV -->
            <Border Grid.Row="2" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="16" Padding="14">
              <StackPanel Spacing="3">
                <TextBlock Text="LOADED ROSTER CSV" FontSize="10" FontWeight="ExtraBold" Foreground="#64748B" LetterSpacing="0.5" />
                <TextBlock Text="{Binding LoadedRosterFileName}" FontSize="12" FontWeight="Bold" FontFamily="Cascadia Mono, Menlo, monospace" Foreground="#0F172A" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <!-- ACTION BUTTON -->
            <Button Grid.Row="3" Classes="hallzee-pill-btn" Click="OnManagePoliciesClick" HorizontalAlignment="Stretch" CornerRadius="16" Padding="12,12">
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                <PathIcon Data="{StaticResource IconUsers}" Width="14" Height="14" Foreground="White" VerticalAlignment="Center" />
                <TextBlock Text="Manage Pass Rules" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>
        </Border>

      </Grid>

    </StackPanel>
  </ScrollViewer>
</UserControl>
