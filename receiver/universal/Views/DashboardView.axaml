<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BathroomSync.Universal.ViewModels;assembly=HallzeeSync.Universal"
             x:Class="BathroomSync.Universal.Views.DashboardView"
             x:DataType="vm:MainViewModel">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28,24" Spacing="24">
      
      <!-- HERO ACTIVE PASS CARD -->
      <Border Background="White" CornerRadius="16" BoxShadow="0 4 20 0 #0D000000" Padding="24">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
          <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Border Background="{Binding ActivePass.BadgeColor}" CornerRadius="6" Padding="8,3">
                <TextBlock Text="{Binding ActivePass.BadgeText}" FontWeight="Bold" FontSize="11" Foreground="{Binding ActivePass.StatusColor}" />
              </Border>
              <TextBlock Text="{Binding ActivePass.StatusText}" FontSize="15" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" />
            </StackPanel>
            
            <TextBlock Text="{Binding ActivePass.DisplayName}" FontSize="32" FontWeight="ExtraBold" Foreground="#0F172A" Margin="0,8,0,0" />
            
            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
              <TextBlock Text="Departed:" Foreground="#64748B" FontSize="13" />
              <TextBlock Text="{Binding ActivePass.DepartTime, FallbackValue='--:--'}" FontWeight="SemiBold" Foreground="#334155" FontSize="13" />
              <TextBlock Text="·" Foreground="#94A3B8" />
              <TextBlock Text="Location:" Foreground="#64748B" FontSize="13" />
              <TextBlock Text="Hallway Restroom (East)" FontWeight="SemiBold" Foreground="#334155" FontSize="13" />
            </StackPanel>
          </StackPanel>

          <!-- LIVE COUNTING TIMER BADGE -->
          <Border Grid.Row="0" Grid.Column="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="20,12" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center" Spacing="2">
              <TextBlock Text="TIME ELAPSED" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" LetterSpacing="0.5" />
              <TextBlock Text="{Binding ActivePass.ElapsedFormatted}" FontSize="36" FontWeight="Black" FontFamily="Cascadia Mono, Menlo, monospace" Foreground="{Binding ActivePass.StatusColor}" HorizontalAlignment="Center" />
            </StackPanel>
          </Border>

          <!-- HERO CARD QUICK ACTIONS -->
          <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,18,0,0" Padding="0,16,0,0" BorderBrush="#F1F5F9" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
              <TextBlock Text="Physical ESP32 kiosk handles direct keypad sign-in and return." FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <Button Classes="secondary" Content="View Live Pass" Click="OnViewPassClick" />
                <Button Classes="primary" Content="Sync Terminal" Click="OnSyncClick" IsEnabled="{Binding !IsSyncing}" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <!-- METRIC CARDS GRID -->
      <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="16">
        <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="16" BoxShadow="0 2 8 0 #08000000">
          <StackPanel Spacing="4">
            <TextBlock Text="TOTAL TRIPS TODAY" FontSize="11" FontWeight="Bold" Foreground="#64748B" />
            <TextBlock Text="{Binding Dashboard.TotalTripsToday}" FontSize="24" FontWeight="Bold" Foreground="#0F172A" />
            <TextBlock Text="Updated live from sync" FontSize="11" Foreground="#10B981" />
          </StackPanel>
        </Border>
        
        <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="16" BoxShadow="0 2 8 0 #08000000">
          <StackPanel Spacing="4">
            <TextBlock Text="AVG DURATION" FontSize="11" FontWeight="Bold" Foreground="#64748B" />
            <TextBlock Text="{Binding Dashboard.AverageDurationFormatted}" FontSize="24" FontWeight="Bold" Foreground="#0F172A" />
            <TextBlock Text="Target: &lt; 7.0 min" FontSize="11" Foreground="#64748B" />
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="16" BoxShadow="0 2 8 0 #08000000">
          <StackPanel Spacing="4">
            <TextBlock Text="STUDENTS ENROLLED" FontSize="11" FontWeight="Bold" Foreground="#64748B" />
            <TextBlock Text="{Binding RosterModal.TotalStudents}" FontSize="24" FontWeight="Bold" Foreground="#0F172A" />
            <TextBlock Text="Attached via Roster CSV" FontSize="11" Foreground="#0284C7" />
          </StackPanel>
        </Border>

        <Border Grid.Column="3" Background="White" CornerRadius="12" Padding="16" BoxShadow="0 2 8 0 #08000000">
          <StackPanel Spacing="4">
            <TextBlock Text="MAX PASS POLICY" FontSize="11" FontWeight="Bold" Foreground="#64748B" />
            <TextBlock Text="{Binding PolicyModal.MaxDailyPasses, StringFormat='{}{0} Passes / Day'}" FontSize="20" FontWeight="Bold" Foreground="#0F172A" />
            <TextBlock Text="Auto-enforced at kiosk" FontSize="11" Foreground="#64748B" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- RECENT ACTIVITY DATA GRID / LIST -->
      <Border Background="White" CornerRadius="14" BoxShadow="0 2 10 0 #08000000" Padding="20">
        <StackPanel Spacing="16">
          <Grid ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="Recent Hall Pass Activity" FontSize="18" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Dashboard.RecentTrips.Count, StringFormat='({0})'}" Foreground="#64748B" VerticalAlignment="Center" />
            </StackPanel>
            
            <TextBox Grid.Column="1" Width="220" Watermark="Search student or ID…" Text="{Binding Dashboard.QuickSearchText}" Margin="0,0,10,0" />
            
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
              <Button Classes="secondary" Content="Export CSV" Click="OnExportCsvClick" />
              <Button Classes="secondary" Content="View All" Click="OnViewAllClick" />
            </StackPanel>
          </Grid>

          <Border BorderBrush="#F1F5F9" BorderThickness="0,1,0,0">
            <ListBox ItemsSource="{Binding Dashboard.RecentTrips}" Background="Transparent">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="Auto,2*,*,*,*,Auto" Margin="0,6" VerticalAlignment="Center">
                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#F1F5F9" Margin="0,0,12,0">
                      <TextBlock Text="🚶" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" Foreground="#0F172A" />
                      <TextBlock Text="{Binding StudentId, StringFormat='ID: {0}'}" FontSize="12" Foreground="#64748B" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                      <TextBlock Text="{Binding TripDate}" FontSize="13" Foreground="#334155" />
                      <TextBlock Text="{Binding ClassPeriod, FallbackValue='Period --'}" FontSize="11" Foreground="#94A3B8" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                      <TextBlock Text="{Binding TimeOut, StringFormat='Out: {0}'}" FontSize="13" Foreground="#334155" />
                      <TextBlock Text="{Binding TimeIn, StringFormat='In: {0}'}" FontSize="11" Foreground="#94A3B8" />
                    </StackPanel>

                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                      <TextBlock Text="{Binding DurationSeconds, StringFormat='{}{0}s'}" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A" />
                    </StackPanel>

                    <Border Grid.Column="5" Background="#F8FAFC" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold" Foreground="#475569" />
                    </Border>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
