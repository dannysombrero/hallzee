<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BathroomSync.Universal.ViewModels;assembly=Hallzee"
             x:Class="BathroomSync.Universal.Views.FindTerminalsModalView"
             x:DataType="vm:MainViewModel">
  <UserControl.Styles>
    <Style Selector="Border.signal-bar">
      <Setter Property="Width" Value="5" />
      <Setter Property="CornerRadius" Value="1" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="Background" Value="#CBD5E1" />
    </Style>
    <Style Selector="Border.signal-bar.filled">
      <Setter Property="Background" Value="#0369A1" />
    </Style>
    <Style Selector="ListBox.terminal-picker ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="#BAE6FD" />
      <Setter Property="BorderBrush" Value="#0284C7" />
      <Setter Property="BorderThickness" Value="3" />
    </Style>
    <Style Selector="ListBox.terminal-picker ListBoxItem:selected:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#BAE6FD" />
    </Style>
  </UserControl.Styles>
  <!-- OVERLAY WITH GUARANTEED PADDING SO MODAL NEVER CLIPS WINDOW BOUNDS -->
  <Border Background="#99000000" Padding="32,24" PointerPressed="OnBackdropPointerPressed">
    <Border Background="White" CornerRadius="24" MaxWidth="560" VerticalAlignment="Center" HorizontalAlignment="Stretch" Padding="24" BoxShadow="0 10 30 0 #40000000">
      <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="16">
        
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2">
            <TextBlock Text="Find Nearby Terminals" FontSize="20" FontWeight="Bold" Foreground="#0F172A" />
            <TextBlock Text="Discover nearby Hallzee Bluetooth LE kiosks." FontSize="13" Foreground="#64748B" />
          </StackPanel>
          <Button Grid.Column="1" Classes="secondary" Content="✕" Click="OnCloseClick" Width="36" Height="36" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
        </Grid>

        <TextBlock Grid.Row="1" Text="{Binding FindTerminalsModal.StatusText}" FontSize="13" Foreground="#334155" TextWrapping="Wrap" />

        <Border Grid.Row="2" Classes="hallzee-table-container" MinHeight="140" MaxHeight="220" Margin="0,2,0,2">
          <Border Classes="hallzee-table-inner">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ListBox ItemsSource="{Binding FindTerminalsModal.Devices}" SelectedItem="{Binding FindTerminalsModal.SelectedDevice}" Classes="hallzee-table-list terminal-picker">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4" VerticalAlignment="Center">
                      <Path Data="{StaticResource IconRadio}" Width="18" Height="18" Margin="4,0,10,0" Stretch="Uniform" Stroke="#0284C7" StrokeThickness="2" StrokeLineCap="Round" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="#0F172A" TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="6" Margin="0,3,8,0">
                          <TextBlock Text="Signal Strength:" FontSize="11" Foreground="#475569" VerticalAlignment="Center" />
                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" Height="16" VerticalAlignment="Center" ToolTip.Tip="{Binding SignalQuality}">
                            <Border Classes="signal-bar" Classes.filled="{Binding HasSignalBar1}" Height="4" />
                            <Border Classes="signal-bar" Classes.filled="{Binding HasSignalBar2}" Height="8" />
                            <Border Classes="signal-bar" Classes.filled="{Binding HasSignalBar3}" Height="12" />
                            <Border Classes="signal-bar" Classes.filled="{Binding HasSignalBar4}" Height="16" />
                          </StackPanel>
                          <TextBlock Grid.Column="2" FontSize="11" Foreground="#0369A1" VerticalAlignment="Center" TextWrapping="Wrap">
                            <Run Text="{Binding SignalQuality}" /><Run Text=" · " /><Run Text="{Binding SignalStrengthText}" />
                          </TextBlock>
                        </Grid>
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#FEF3C7" CornerRadius="6" Padding="8,3" VerticalAlignment="Center" IsVisible="{Binding IsInUse}">
                          <TextBlock Text="CLAIMED OR BUSY" FontSize="10" FontWeight="Bold" Foreground="#92400E" />
                        </Border>
                        <Border Background="#DCFCE7" CornerRadius="6" Padding="8,3" VerticalAlignment="Center" IsVisible="{Binding !IsInUse}">
                          <TextBlock Text="READY TO PAIR" FontSize="10" FontWeight="Bold" Foreground="#166534" />
                        </Border>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </ScrollViewer>
          </Border>
        </Border>

        <StackPanel Grid.Row="3" Spacing="5">
          <TextBlock Text="Bluetooth passkey (unclaimed terminals only)" FontSize="12" Foreground="#475569" />
          <TextBox Text="{Binding FindTerminalsModal.PairingPasskey}" Watermark="6 digits shown on the kiosk" MaxLength="6" />
        </StackPanel>

        <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" VerticalAlignment="Center">
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding FindTerminalsModal.IsBusy}" Height="6" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="secondary" Content="Scan Again" Click="OnScanClick" IsEnabled="{Binding FindTerminalsModal.CanScan}" />
          <Button Grid.Column="2" Classes="hallzee-pill-btn" Content="{Binding FindTerminalsModal.ConnectButtonText}" Click="OnConnectClick" IsEnabled="{Binding FindTerminalsModal.CanConnect}" Padding="16,8" FontSize="13" />
        </Grid>
      </Grid>
    </Border>
  </Border>
</UserControl>
