<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BathroomSync.Universal.ViewModels;assembly=HallzeeSync.Universal"
             x:Class="BathroomSync.Universal.Views.ManualCheckInModalView"
             x:DataType="vm:MainViewModel">
  <!-- OVERLAY WITH GUARANTEED PADDING SO MODAL NEVER CLIPS WINDOW BOUNDS -->
  <Border Background="#99000000" Padding="32,24" PointerPressed="OnBackdropPointerPressed">
    <Border Background="White" CornerRadius="24" MaxWidth="520" VerticalAlignment="Center" HorizontalAlignment="Stretch" Padding="24" BoxShadow="0 10 30 0 #40000000">
      <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16">
        
        <!-- HEADER -->
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2">
            <TextBlock Text="Teacher-Started Pass" FontSize="20" FontWeight="Bold" Foreground="#0F172A" />
            <TextBlock Text="Assign an active hall pass while a pass is available." FontSize="13" Foreground="#64748B" />
          </StackPanel>
          <Button Grid.Column="1" Classes="secondary" Content="✕" Click="OnCancelClick" Width="36" Height="36" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
        </Grid>

        <!-- FORM CONTENT -->
        <StackPanel Grid.Row="1" Spacing="14">
          
          <!-- STUDENT NAME -->
          <StackPanel Spacing="4">
            <TextBlock Text="Student Name" FontSize="12" FontWeight="Bold" Foreground="#334155" />
            <TextBox Text="{Binding ManualCheckInModal.StudentName}" Watermark="e.g. Avery Chen (optional if ID is provided)" FontSize="13" />
          </StackPanel>

          <!-- STUDENT ID -->
          <StackPanel Spacing="4">
            <TextBlock Text="Student ID" FontSize="12" FontWeight="Bold" Foreground="#334155" />
            <TextBox Text="{Binding ManualCheckInModal.StudentId}" Watermark="e.g. 10482 (optional if Name is provided)" FontSize="13" />
          </StackPanel>

          <!-- PERIOD (OPTIONAL) -->
          <StackPanel Spacing="4">
            <TextBlock Text="Period (optional)" FontSize="12" FontWeight="Bold" Foreground="#334155" />
            <TextBox Text="{Binding ManualCheckInModal.Period}" Watermark="e.g. Period 3" FontSize="13" />
          </StackPanel>

          <!-- DESTINATION (OPTIONAL) -->
          <StackPanel Spacing="4">
            <TextBlock Text="Destination (optional)" FontSize="12" FontWeight="Bold" Foreground="#334155" />
            <TextBox Text="{Binding ManualCheckInModal.Destination}" Watermark="e.g. Hallway Restroom, Clinic, Room 204" FontSize="13" />
          </StackPanel>

          <!-- PURPOSE (OPTIONAL) -->
          <StackPanel Spacing="4">
            <TextBlock Text="Purpose (optional)" FontSize="12" FontWeight="Bold" Foreground="#334155" />
            <TextBox Text="{Binding ManualCheckInModal.Purpose}" Watermark="e.g. restroom, nurse, office" FontSize="13" />
          </StackPanel>

          <!-- HELPER HINT -->
          <Border Classes="hallzee-section" Padding="12">
            <TextBlock Text="Student Name or Student ID is required. Period, destination, and purpose are optional. Submitting starts the live timer." FontSize="11" Foreground="#0369A1" TextWrapping="Wrap" />
          </Border>
        </StackPanel>

        <!-- FOOTER ACTIONS -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" VerticalAlignment="Center">
          <TextBlock Text="{Binding ManualCheckInModal.StatusMessage}" Foreground="#E11D48" FontSize="12" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="secondary" Content="Cancel" Click="OnCancelClick" Padding="14,8" />
          <Button Grid.Column="2" Classes="hallzee-pill-btn" Click="OnSubmitClick" IsEnabled="{Binding ManualCheckInModal.CanSubmit}" Padding="16,8">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Path Data="{StaticResource IconUserCheck}" Width="14" Height="14" Stretch="Uniform" Stroke="White" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center" />
              <TextBlock Text="Start Pass" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>

      </Grid>
    </Border>
  </Border>
</UserControl>
