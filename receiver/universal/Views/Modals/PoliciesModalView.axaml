<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BathroomSync.Universal.ViewModels;assembly=HallzeeSync.Universal"
             x:Class="BathroomSync.Universal.Views.PoliciesModalView"
             x:DataType="vm:MainViewModel">
  <Border Background="#99000000">
    <Border Background="White" CornerRadius="22" Width="1040" MaxHeight="700" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28" BoxShadow="0 10 30 0 #40000000">
      <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
        
        <!-- ROW 0: HEADER -->
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
          <StackPanel Spacing="2">
            <TextBlock Text="Hall Pass Policies &amp; Schedule" FontSize="22" FontWeight="Bold" Foreground="#111B33" />
            <TextBlock Text="Configure classroom pass limits, grace periods, and timetable." FontSize="14" Foreground="#617694" />
          </StackPanel>
          <Button Grid.Column="1" Classes="secondary" Content="✕" Click="OnCloseClick" Width="36" Height="36" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
        </Grid>

        <!-- ROW 1: PROFILE SELECTION & SAVE PROFILE SETTINGS (TOP PROFILE BAR) -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
          <TextBlock Text="Profile:" FontWeight="Bold" FontSize="14" Foreground="#334155" VerticalAlignment="Center" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding Profiles}" SelectedItem="{Binding ActiveProfile}" DisplayMemberBinding="{Binding Name}" MinWidth="200" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="{Binding PolicyModal.StatusMessage}" MaxWidth="240" TextTrimming="CharacterEllipsis" Foreground="#10B981" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
          <Button Grid.Column="3" Classes="hallzee-pill-btn" Content="Save Profile Settings" Click="OnSavePolicyClick" Padding="16,8" FontSize="13" />
        </Grid>

        <!-- ROW 2: ADD NEW PROFILE BAR (MATCHING ROSTER LAYOUT) -->
        <Border Grid.Row="2" Background="#F0F9FF" BorderBrush="#D9EAF5" BorderThickness="1" CornerRadius="14" Padding="14,10">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
            <TextBlock Text="Add new profile:" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding PolicyModal.NewProfileName}" Watermark="Profile / section name (e.g. Period 2 / Block B)" FontSize="12" />
            <Button Grid.Column="2" Classes="secondary" Content="+ Save as New Profile" Click="OnSaveAsProfileClick" Padding="12,6" FontSize="12" />
          </Grid>
        </Border>

        <!-- ROW 3: POLICIES AND SCHEDULE CONTENT -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
          <StackPanel Spacing="16">
            
            <!-- CLASSROOM PASS LIMITS -->
            <Border Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="18" Padding="20">
              <StackPanel Spacing="12">
                <TextBlock Text="CLASSROOM PASS LIMITS" FontSize="12" FontWeight="Bold" Foreground="#617694" />
                
                <Grid ColumnDefinitions="2*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10" VerticalAlignment="Center">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="Students allowed out at once:" FontSize="15" Foreground="#344A66" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="1" Maximum="8" Increment="1" FormatString="0" ParsingNumberStyle="Integer" Value="{Binding PolicyModal.MaxSimultaneousPasses}" />

                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Maximum Daily Passes per Student:" FontSize="15" Foreground="#344A66" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="10" Increment="1" FormatString="0" ParsingNumberStyle="Integer" Value="{Binding PolicyModal.MaxDailyPasses}" />

                  <TextBlock Grid.Row="2" Grid.Column="0" Text="Overdue warning (minutes):" FontSize="15" Foreground="#344A66" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Row="2" Grid.Column="1" Minimum="1" Maximum="60" Increment="1" FormatString="0" ParsingNumberStyle="Integer" Value="{Binding PolicyModal.DurationWarningMinutes}" />
                </Grid>
              </StackPanel>
            </Border>

            <!-- BELL-TIME WINDOWS -->
            <Border Background="#FFFBEB" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="18" Padding="20">
              <StackPanel Spacing="10">
                <TextBlock Text="BELL-TIME WINDOWS" FontSize="12" FontWeight="Bold" Foreground="#A44A05" />
                <Grid ColumnDefinitions="2*,Auto,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                  <TextBlock Grid.Row="0" Text="First minutes of period" FontSize="15" Foreground="#344A66" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Row="0" Grid.Column="1" Width="140" Minimum="0" Maximum="30" Increment="1" FormatString="0" ParsingNumberStyle="Integer" HorizontalContentAlignment="Center" Value="{Binding PolicyModal.FirstWindowMinutes}" />
                  <ComboBox Grid.Row="0" Grid.Column="2" Width="110" ItemsSource="{Binding PolicyModal.BellActions}" SelectedItem="{Binding PolicyModal.FirstWindowAction}" />
                  
                  <TextBlock Grid.Row="1" Text="Last minutes of period" FontSize="15" Foreground="#344A66" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Row="1" Grid.Column="1" Width="140" Minimum="0" Maximum="30" Increment="1" FormatString="0" ParsingNumberStyle="Integer" HorizontalContentAlignment="Center" Value="{Binding PolicyModal.LastWindowMinutes}" />
                  <ComboBox Grid.Row="1" Grid.Column="2" Width="110" ItemsSource="{Binding PolicyModal.BellActions}" SelectedItem="{Binding PolicyModal.LastWindowAction}" />
                  
                  <TextBlock Grid.Row="2" Text="Warning sound" FontSize="15" Foreground="#344A66" VerticalAlignment="Center" />
                  <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <ComboBox ItemsSource="{Binding PolicyModal.AlertSounds}" SelectedItem="{Binding PolicyModal.AlertSound}" HorizontalAlignment="Stretch" />
                    <Button Grid.Column="1" Classes="secondary" Click="OnPlaySoundPreviewClick" ToolTip.Tip="Hear selected warning sound" Padding="10,6">
                      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource IconVolume2}" Width="14" Height="14" Foreground="#0284C7" />
                        <TextBlock Text="Play Preview" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </Grid>
                </Grid>
              </StackPanel>
            </Border>

            <!-- BELL SCHEDULE PERIODS -->
            <Border Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="18" Padding="20">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="BELL SCHEDULE PERIODS" FontSize="12" FontWeight="Bold" Foreground="#617694" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="secondary" Click="OnAddPeriodClick" Padding="10,4" FontSize="12">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <PathIcon Data="{StaticResource IconPlus}" Width="12" Height="12" Foreground="#0284C7" />
                      <TextBlock Text="Add Period" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </Grid>

                <ItemsControl ItemsSource="{Binding PolicyModal.Periods}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Panel Margin="0,4">
                        <!-- VIEW MODE: COMPACT READABLE ROW -->
                        <Border Background="White" BorderBrush="#D9EAF5" BorderThickness="1" CornerRadius="12" Padding="14,12" IsVisible="{Binding !IsEditing}">
                          <Grid ColumnDefinitions="1.5*,2*,2*,Auto" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayTitle}" FontWeight="Bold" FontSize="14" Foreground="#111B33" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding DisplayTimeRange}" FontSize="13" FontFamily="Cascadia Mono, Menlo, monospace" FontWeight="SemiBold" Foreground="#617694" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding FormattedDaysSummary}" FontSize="12" FontWeight="SemiBold" Foreground="#0284C7" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                              <Button Classes="secondary" Click="OnEditPeriodClick" Tag="{Binding}" Width="32" Height="32" Padding="0" ToolTip.Tip="Edit Period">
                                <PathIcon Data="{StaticResource IconEdit}" Width="14" Height="14" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center" />
                              </Button>
                              <Button Classes="secondary" Click="OnRemovePeriodClick" Tag="{Binding}" Width="32" Height="32" Padding="0" ToolTip.Tip="Delete Period">
                                <PathIcon Data="{StaticResource IconTrash}" Width="14" Height="14" Foreground="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center" />
                              </Button>
                            </StackPanel>
                          </Grid>
                        </Border>

                        <!-- EDIT MODE: FORM FIELDS WITH CHECKBOXES -->
                        <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="8" Padding="12,10" IsVisible="{Binding IsEditing}">
                          <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="1.5*,*,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                              <TextBox Text="{Binding EditName}" Watermark="Period name" FontSize="12" />
                              <TextBox Grid.Column="1" Text="{Binding EditStartTime}" Watermark="08:00 AM" FontSize="12" />
                              <TextBox Grid.Column="2" Text="{Binding EditEndTime}" Watermark="08:50 AM" FontSize="12" />
                              <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                                <Button Classes="hallzee-pill-btn" Click="OnSavePeriodClick" Tag="{Binding}" Width="32" Height="32" Padding="0" ToolTip.Tip="Save Changes">
                                  <PathIcon Data="{StaticResource IconCheck}" Width="14" Height="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>
                                <Button Classes="secondary" Click="OnRemovePeriodClick" Tag="{Binding}" Width="32" Height="32" Padding="0" ToolTip.Tip="Delete Period">
                                  <PathIcon Data="{StaticResource IconTrash}" Width="14" Height="14" Foreground="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>
                              </StackPanel>
                            </Grid>

                            <!-- DAY CHECKBOXES -->
                            <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                              <TextBlock Text="Active Days:" FontSize="11" FontWeight="Bold" Foreground="#166534" Margin="0,0,10,0" VerticalAlignment="Center" />
                              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                <CheckBox Content="Mon" IsChecked="{Binding IsMonday}" FontSize="12" />
                                <CheckBox Content="Tue" IsChecked="{Binding IsTuesday}" FontSize="12" />
                                <CheckBox Content="Wed" IsChecked="{Binding IsWednesday}" FontSize="12" />
                                <CheckBox Content="Thu" IsChecked="{Binding IsThursday}" FontSize="12" />
                                <CheckBox Content="Fri" IsChecked="{Binding IsFriday}" FontSize="12" />
                              </StackPanel>
                            </Grid>
                          </StackPanel>
                        </Border>
                      </Panel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>

      </Grid>
    </Border>
  </Border>
</UserControl>
