<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BathroomSync.Universal.ViewModels;assembly=HallzeeSync.Universal"
             x:Class="BathroomSync.Universal.Views.PoliciesModalView"
             x:DataType="vm:MainViewModel">
  <Border Background="#99000000">
    <Border Background="White" CornerRadius="16" Width="820" MaxHeight="680" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24" BoxShadow="0 10 30 0 #40000000">
      <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16">
        
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2">
            <TextBlock Text="Hall Pass Policies &amp; Schedule" FontSize="20" FontWeight="Bold" Foreground="#0F172A" />
            <TextBlock Text="Configure classroom pass limits, grace periods, and timetable." FontSize="13" Foreground="#64748B" />
          </StackPanel>
          <Button Grid.Column="1" Classes="secondary" Content="✕" Click="OnCloseClick" Width="36" Height="36" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="16">
            
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16">
              <StackPanel Spacing="12">
                <TextBlock Text="CLASSROOM PASS LIMITS" FontSize="11" FontWeight="Bold" Foreground="#64748B" />
                
                <Grid ColumnDefinitions="2*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10" VerticalAlignment="Center">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="Students allowed out at once:" FontSize="13" Foreground="#334155" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="1" Maximum="8" Increment="1" FormatString="0" ParsingNumberStyle="Integer" Value="{Binding PolicyModal.MaxSimultaneousPasses}" />

                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Maximum Daily Passes per Student:" FontSize="13" Foreground="#334155" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="10" Increment="1" FormatString="0" ParsingNumberStyle="Integer" Value="{Binding PolicyModal.MaxDailyPasses}" />

                  <TextBlock Grid.Row="2" Grid.Column="0" Text="Overdue warning (minutes):" FontSize="13" Foreground="#334155" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Row="2" Grid.Column="1" Minimum="1" Maximum="60" Increment="1" FormatString="0" ParsingNumberStyle="Integer" Value="{Binding PolicyModal.DurationWarningMinutes}" />
                </Grid>
              </StackPanel>
            </Border>

            <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="10" Padding="16">
              <StackPanel Spacing="10">
                <TextBlock Text="BELL-TIME WINDOWS" FontSize="11" FontWeight="Bold" Foreground="#92400E" />
                <Grid ColumnDefinitions="2*,Auto,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                  <TextBlock Grid.Row="0" Text="First minutes of period" FontSize="13" Foreground="#334155" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Row="0" Grid.Column="1" Width="140" Minimum="0" Maximum="30" Increment="1" FormatString="0" ParsingNumberStyle="Integer" HorizontalContentAlignment="Center" Value="{Binding PolicyModal.FirstWindowMinutes}" />
                  <ComboBox Grid.Row="0" Grid.Column="2" Width="110" ItemsSource="{Binding PolicyModal.BellActions}" SelectedItem="{Binding PolicyModal.FirstWindowAction}" />
                  
                  <TextBlock Grid.Row="1" Text="Last minutes of period" FontSize="13" Foreground="#334155" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Row="1" Grid.Column="1" Width="140" Minimum="0" Maximum="30" Increment="1" FormatString="0" ParsingNumberStyle="Integer" HorizontalContentAlignment="Center" Value="{Binding PolicyModal.LastWindowMinutes}" />
                  <ComboBox Grid.Row="1" Grid.Column="2" Width="110" ItemsSource="{Binding PolicyModal.BellActions}" SelectedItem="{Binding PolicyModal.LastWindowAction}" />
                  
                  <TextBlock Grid.Row="2" Text="Warning sound" FontSize="13" Foreground="#334155" VerticalAlignment="Center" />
                  <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <ComboBox ItemsSource="{Binding PolicyModal.AlertSounds}" SelectedItem="{Binding PolicyModal.AlertSound}" HorizontalAlignment="Stretch" />
                    <Button Grid.Column="1" Classes="secondary" Click="OnPlaySoundPreviewClick" ToolTip.Tip="Hear selected warning sound" Padding="10,6">
                      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource IconVolume2}" Width="14" Height="14" Foreground="#0284C7" />
                        <TextBlock Text="Play Preview" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </Grid>
                </Grid>
                <TextBlock Text="Allow accepts passes; Warn accepts and alerts; Lock blocks new checkouts during the selected window." TextWrapping="Wrap" FontSize="11" Foreground="#92400E" />
              </StackPanel>
            </Border>

            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="BELL SCHEDULE PERIODS" FontSize="11" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="secondary" Click="OnAddPeriodClick" Padding="10,4">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                      <PathIcon Data="{StaticResource IconPlus}" Width="10" Height="10" Foreground="#0369A1" />
                      <TextBlock Text="Add Period" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </Grid>

                <ItemsControl ItemsSource="{Binding PolicyModal.Periods}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:BellPeriodItemViewModel">
                      <Panel Margin="0,3">
                        <!-- VIEW MODE -->
                        <Border IsVisible="{Binding !IsEditing}" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,10">
                          <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                            <Border Background="#E0F2FE" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                              <TextBlock Text="{Binding ScheduleName}" FontSize="11" FontWeight="Bold" Foreground="#0369A1" />
                            </Border>
                            
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                              <TextBlock Text="{Binding PeriodName}" FontWeight="Bold" FontSize="13" Foreground="#0F172A" />
                              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource IconClock}" Width="11" Height="11" Foreground="#64748B" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DisplayTimeRange}" FontSize="12" Foreground="#475569" FontWeight="SemiBold" />
                                <TextBlock Text="•" Foreground="#94A3B8" FontSize="12" />
                                <TextBlock Text="{Binding FormattedDaysSummary}" FontSize="11" Foreground="#64748B" />
                              </StackPanel>
                            </StackPanel>

                            <Button Grid.Column="2" Classes="secondary" Click="OnEditPeriodClick" Tag="{Binding}" Padding="8,6" ToolTip.Tip="Edit period">
                              <PathIcon Data="{StaticResource IconEdit}" Width="12" Height="12" Foreground="#0369A1" />
                            </Button>
                            <Button Grid.Column="3" Classes="danger" Click="OnRemovePeriodClick" Tag="{Binding}" Padding="8,6" ToolTip.Tip="Delete period">
                              <PathIcon Data="{StaticResource IconTrash}" Width="12" Height="12" Foreground="#E11D48" />
                            </Button>
                          </Grid>
                        </Border>

                        <!-- EDIT MODE -->
                        <Border IsVisible="{Binding IsEditing}" Background="#F8FAFC" BorderBrush="#0284C7" BorderThickness="1.5" CornerRadius="8" Padding="12">
                          <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="1.2*,1.5*,*,*,Auto,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                              <TextBox Text="{Binding ScheduleName}" Watermark="Schedule (e.g. Regular)" FontSize="12" />
                              <TextBox Grid.Column="1" Text="{Binding PeriodName}" Watermark="Period name" FontSize="12" />
                              <TextBox Grid.Column="2" Text="{Binding StartTime}" Watermark="Start (e.g. 08:00 AM)" FontSize="12" />
                              <TextBox Grid.Column="3" Text="{Binding EndTime}" Watermark="End (e.g. 08:50 AM)" FontSize="12" />
                              <Button Grid.Column="4" Background="#10B981" Foreground="White" Click="OnSavePeriodClick" Tag="{Binding}" Padding="8,6" ToolTip.Tip="Done editing period">
                                <PathIcon Data="{StaticResource IconCheck}" Width="12" Height="12" Foreground="White" />
                              </Button>
                              <Button Grid.Column="5" Classes="danger" Click="OnRemovePeriodClick" Tag="{Binding}" Padding="8,6" ToolTip.Tip="Delete period">
                                <PathIcon Data="{StaticResource IconTrash}" Width="12" Height="12" Foreground="#E11D48" />
                              </Button>
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
                              <TextBlock Text="Applies to:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" />
                              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                <CheckBox Content="Mon" IsChecked="{Binding IsMonday}" FontSize="12" />
                                <CheckBox Content="Tue" IsChecked="{Binding IsTuesday}" FontSize="12" />
                                <CheckBox Content="Wed" IsChecked="{Binding IsWednesday}" FontSize="12" />
                                <CheckBox Content="Thu" IsChecked="{Binding IsThursday}" FontSize="12" />
                                <CheckBox Content="Fri" IsChecked="{Binding IsFriday}" FontSize="12" />
                              </StackPanel>
                            </Grid>
                          </StackPanel>
                        </Border>
                      </Panel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBox Width="170" Text="{Binding PolicyModal.NewProfileName}" Watermark="New profile name" />
            <Button Classes="secondary" Content="Save as New Profile" Click="OnSaveAsProfileClick" Padding="12,8" FontSize="12" />
            <TextBlock Text="{Binding PolicyModal.StatusMessage}" MaxWidth="180" TextTrimming="CharacterEllipsis" Foreground="#10B981" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
          </StackPanel>
          <Button Grid.Column="1" Classes="hallzee-pill-btn" Content="Save Profile Settings" Click="OnSavePolicyClick" Padding="16,8" FontSize="13" />
        </Grid>
      </Grid>
    </Border>
  </Border>
</UserControl>
