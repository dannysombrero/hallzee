<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BathroomSync.Universal.ViewModels;assembly=HallzeeSync.Universal"
             x:Class="BathroomSync.Universal.Views.PoliciesModalView"
             x:DataType="vm:MainViewModel">
  <Border Background="#99000000">
    <Border Background="White" CornerRadius="16" Width="680" MaxHeight="560" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24" BoxShadow="0 10 30 0 #40000000">
      <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16">
        
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2">
            <TextBlock Text="Hall Pass Policies &amp; Schedule" FontSize="20" FontWeight="Bold" Foreground="#0F172A" />
            <TextBlock Text="Configure classroom pass limits, grace periods, and timetable." FontSize="13" Foreground="#64748B" />
          </StackPanel>
          <Button Grid.Column="1" Classes="secondary" Content="✕" Click="OnCloseClick" Width="36" Height="36" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="16">
            
            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16">
              <StackPanel Spacing="12">
                <TextBlock Text="CLASSROOM PASS LIMITS" FontSize="11" FontWeight="Bold" Foreground="#64748B" />
                
                <Grid ColumnDefinitions="2*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10" VerticalAlignment="Center">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="Maximum Daily Passes per Student:" FontSize="13" Foreground="#334155" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="1" Maximum="10" Value="{Binding PolicyModal.MaxDailyPasses}" />

                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Grace Period (Minutes):" FontSize="13" Foreground="#334155" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="20" Value="{Binding PolicyModal.GracePeriodMinutes}" />

                  <TextBlock Grid.Row="2" Grid.Column="0" Text="Auto-Reset Timeout (Minutes):" FontSize="13" Foreground="#334155" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Row="2" Grid.Column="1" Minimum="5" Maximum="60" Value="{Binding PolicyModal.AutoResetTimeoutMinutes}" />
                </Grid>
              </StackPanel>
            </Border>

            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="BELL SCHEDULE PERIODS" FontSize="11" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="secondary" Click="OnAddPeriodClick" Padding="10,4">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                      <PathIcon Data="{StaticResource IconPlus}" Width="10" Height="10" Foreground="#0369A1" />
                      <TextBlock Text="Add Period" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </Grid>

                <ItemsControl ItemsSource="{Binding PolicyModal.Periods}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="2*,*,*,Auto" Margin="0,3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PeriodName}" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding StartTime}" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding EndTime}" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                        <Button Grid.Column="3" Classes="danger" Click="OnRemovePeriodClick" Tag="{Binding}" Margin="0,0,4,0" Padding="6,4">
                          <PathIcon Data="{StaticResource IconX}" Width="10" Height="10" Foreground="#E11D48" />
                        </Button>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
          <TextBlock Text="{Binding PolicyModal.StatusMessage}" Foreground="#10B981" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="hallzee-pill-btn" Content="Save Policy" Click="OnSavePolicyClick" Padding="16,8" FontSize="13" />
        </Grid>
      </Grid>
    </Border>
  </Border>
</UserControl>
