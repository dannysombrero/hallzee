<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BathroomSync.Universal.ViewModels;assembly=Hallzee"
             x:Class="BathroomSync.Universal.Views.PoliciesModalView"
             x:DataType="vm:MainViewModel">
  <Border Background="#99000000" Padding="32,24" PointerPressed="OnBackdropPointerPressed">
    <Border Classes="hallzee-modal-window" MaxWidth="1040" MaxHeight="640" VerticalAlignment="Center" HorizontalAlignment="Stretch">
      <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
        
        <!-- ROW 0: HEADER -->
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,2">
          <StackPanel Spacing="2">
            <TextBlock Text="Hall Pass Policies &amp; Schedule" FontSize="22" FontWeight="Bold" Foreground="#111B33" />
            <TextBlock Text="Configure classroom pass limits, grace periods, and timetable." FontSize="14" Foreground="#617694" />
          </StackPanel>
          <Button Grid.Column="1" Classes="icon-circle secondary" Content="✕" FontSize="14" FontWeight="Bold" Click="OnCloseClick" />
        </Grid>

        <!-- ROW 1: REIMAGINED WORKSPACE CONTROL TOOLBAR -->
        <Border Grid.Row="1" Classes="hallzee-section-white" Padding="14,10">
          <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
            
            <!-- Workspace Scope & Selector -->
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Path Data="{StaticResource IconTag}" Width="14" Height="14" Stretch="Uniform" Stroke="#0284C7" StrokeThickness="2" StrokeLineCap="Round" VerticalAlignment="Center" />
              <TextBlock Text="Workspace:" FontWeight="Bold" FontSize="13" Foreground="#334155" VerticalAlignment="Center" />
            </StackPanel>

            <ComboBox Grid.Column="1" Classes="filter-dropdown" ItemsSource="{Binding Profiles}" SelectedItem="{Binding ActiveProfile}" DisplayMemberBinding="{Binding Name}" MinWidth="180" VerticalAlignment="Center" />

            <!-- Workspace Actions: Rename & New -->
            <Button Grid.Column="2" Classes="pill-secondary" Click="OnToggleRenameProfileClick" ToolTip.Tip="Rename active teacher workspace">
              <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                <Path Data="{StaticResource IconEdit}" Width="12" Height="12" Stretch="Uniform" Stroke="#0369A1" StrokeThickness="1.8" StrokeLineCap="Round" VerticalAlignment="Center" />
                <TextBlock Text="Rename" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <Button Grid.Column="3" Classes="pill-secondary" Click="OnToggleCreateProfileClick" ToolTip.Tip="Create a new teacher workspace">
              <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                <Path Data="{StaticResource IconPlus}" Width="11" Height="11" Stretch="Uniform" Stroke="#0369A1" StrokeThickness="2" StrokeLineCap="Round" VerticalAlignment="Center" />
                <TextBlock Text="New" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <!-- Subtle Vertical Separator -->
            <Rectangle Grid.Column="4" Width="1" Height="20" Fill="#BAE6FD" Margin="4,0" VerticalAlignment="Center" />

            <!-- Backup / Share: Export & Import -->
            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Button Classes="pill-secondary" Click="OnExportWorkspaceClick" ToolTip.Tip="Export active workspace rules and schedules to JSON file">
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                  <Path Data="{StaticResource IconDownload}" Width="12" Height="12" Stretch="Uniform" Stroke="#0369A1" StrokeThickness="1.8" StrokeLineCap="Round" VerticalAlignment="Center" />
                  <TextBlock Text="Export" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
              </Button>

              <Button Classes="pill-secondary" Click="OnImportWorkspaceClick" ToolTip.Tip="Import a teacher workspace from a Hallzee JSON file">
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                  <Path Data="{StaticResource IconSync}" Width="12" Height="12" Stretch="Uniform" Stroke="#0369A1" StrokeThickness="1.8" StrokeLineCap="Round" VerticalAlignment="Center" />
                  <TextBlock Text="Import" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>

            <!-- Primary Action: Save Workspace Settings -->
            <Button Grid.Column="7" Classes="hallzee-pill-btn" Content="Save Workspace Settings" Click="OnSavePolicyClick" Padding="18,8" FontSize="13" VerticalAlignment="Center" />

          </Grid>
        </Border>

        <!-- ROW 2: DYNAMIC INLINE ACTION PANEL & STATUS FEEDBACK -->
        <StackPanel Grid.Row="2" Spacing="6">
          <!-- INLINE RENAME BAR -->
          <Border Classes="hallzee-section" Padding="14,8" IsVisible="{Binding PolicyModal.IsRenamingProfile}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Path Data="{StaticResource IconEdit}" Width="13" Height="13" Stretch="Uniform" Stroke="#0284C7" StrokeThickness="1.8" StrokeLineCap="Round" VerticalAlignment="Center" />
                <TextBlock Text="Rename workspace:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" />
              </StackPanel>
              <TextBox Grid.Column="1" Text="{Binding PolicyModal.RenameProfileName}" KeyDown="OnRenameTextBoxKeyDown" Watermark="Enter new workspace name" FontSize="12" />
              <Button Grid.Column="2" Classes="hallzee-pill-btn" Content="Save Name" Click="OnSaveRenameProfileClick" Padding="14,6" FontSize="12" />
              <Button Grid.Column="3" Classes="secondary" Content="Cancel" Click="OnCancelRenameProfileClick" Padding="12,6" FontSize="12" />
            </Grid>
          </Border>

          <!-- INLINE CREATE BAR -->
          <Border Classes="hallzee-section" Padding="14,8" IsVisible="{Binding PolicyModal.IsCreatingProfile}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Path Data="{StaticResource IconPlus}" Width="12" Height="12" Stretch="Uniform" Stroke="#0284C7" StrokeThickness="2" StrokeLineCap="Round" VerticalAlignment="Center" />
                <TextBlock Text="New workspace name:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" />
              </StackPanel>
              <TextBox Grid.Column="1" Text="{Binding PolicyModal.NewProfileName}" KeyDown="OnNewProfileTextBoxKeyDown" Watermark="Teacher name (e.g. Ms. Rivera)" FontSize="12" />
              <Button Grid.Column="2" Classes="hallzee-pill-btn" Content="Create Workspace" Click="OnSaveAsProfileClick" Padding="14,6" FontSize="12" />
              <Button Grid.Column="3" Classes="secondary" Content="Cancel" Click="OnCancelCreateProfileClick" Padding="12,6" FontSize="12" />
            </Grid>
          </Border>

          <!-- STATUS FEEDBACK (ONLY SHOWN WHEN MESSAGE EXISTS) -->
          <Border Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="10" Padding="12,6" HorizontalAlignment="Left" IsVisible="{Binding PolicyModal.HasStatusMessage}">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Path Data="{StaticResource IconCheck}" Width="12" Height="12" Stretch="Uniform" Stroke="#0284C7" StrokeThickness="2.2" StrokeLineCap="Round" VerticalAlignment="Center" />
              <TextBlock Text="{Binding PolicyModal.StatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="#0369A1" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ROW 3: DOUBLE-COLUMN MAIN CONTENT -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
          <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
            
            <!-- LEFT COLUMN: PASS POLICY RULES & BELL-TIME WINDOWS -->
            <StackPanel Grid.Column="0" Spacing="16">
              
              <!-- Section Header: Pass Policy Rules -->
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalAlignment="Center">
                <Path Data="{StaticResource IconShieldCheck}" Width="16" Height="16" Stretch="Uniform" Stroke="#0284C7" StrokeThickness="2" StrokeLineCap="Round" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Pass Policy Rules" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
              </Grid>

              <!-- Card 1: Pass Limits -->
              <Border Classes="hallzee-section-white">
                <StackPanel Spacing="12">
                  <!-- Row 1: Students Allowed Out Simultaneously -->
                  <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                    <TextBlock Text="Students allowed out simultaneously:" FontSize="13" Foreground="#475569" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Column="1" Minimum="1" Maximum="8" Increment="1" FormatString="0" ParsingNumberStyle="Integer" HorizontalContentAlignment="Center" Width="105" Value="{Binding PolicyModal.MaxSimultaneousPasses}" />
                  </Grid>

                  <Rectangle Height="1" Fill="#E0F2FE" />

                  <!-- Row 2: Overdue Warning Threshold -->
                  <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                    <TextBlock Text="Overdue warning threshold:" FontSize="13" Foreground="#475569" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <NumericUpDown Minimum="1" Maximum="60" Increment="1" FormatString="0" ParsingNumberStyle="Integer" HorizontalContentAlignment="Center" Width="105" Value="{Binding PolicyModal.DurationWarningMinutes}" />
                      <Border Classes="status-pill warning">
                        <TextBlock Text="mins" />
                      </Border>
                    </StackPanel>
                  </Grid>

                  <Rectangle Height="1" Fill="#E0F2FE" />

                  <!-- Row 3: Daily Pass Guideline -->
                  <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                    <TextBlock Text="Daily pass guideline per student:" FontSize="13" Foreground="#475569" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <NumericUpDown Minimum="1" Maximum="20" Increment="1" FormatString="0" ParsingNumberStyle="Integer" HorizontalContentAlignment="Center" Width="105" Value="{Binding PolicyModal.MaxDailyPasses}" />
                      <Border Classes="status-pill dark">
                        <TextBlock Text="trips" />
                      </Border>
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>

              <!-- Card 2: Bell-Time Windows & Class Pass Rules -->
              <Border Classes="hallzee-section-white">
                <StackPanel Spacing="12">
                  <TextBlock Text="CLASS PASS RULES &amp; BELL-TIME WINDOWS" FontSize="11" FontWeight="Bold" Foreground="#64748B" />

                  <!-- 3-OPTION PASS POLICY MODE SELECTOR -->
                  <Border Background="#F1F5F9" CornerRadius="12" Padding="3">
                    <Grid ColumnDefinitions="*,*,*">
                      <Button Grid.Column="0" Tag="Windows" Click="OnSelectPassPolicyModeClick"
                              Background="{Binding PolicyModal.WindowsModeBackground}"
                              Foreground="{Binding PolicyModal.WindowsModeForeground}"
                              FontWeight="{Binding PolicyModal.WindowsModeFontWeight}"
                              CornerRadius="9" Padding="6,7" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                              ToolTip.Tip="Enforce configurable first, middle, and last window rules">
                        <TextBlock Text="Windows" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" />
                      </Button>
                      <Button Grid.Column="1" Tag="NoPasses" Click="OnSelectPassPolicyModeClick"
                              Background="{Binding PolicyModal.NoPassesModeBackground}"
                              Foreground="{Binding PolicyModal.NoPassesModeForeground}"
                              FontWeight="{Binding PolicyModal.NoPassesModeFontWeight}"
                              CornerRadius="9" Padding="6,7" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                              ToolTip.Tip="Lock passes during the entire class period">
                        <TextBlock Text="No Passes" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" />
                      </Button>
                      <Button Grid.Column="2" Tag="NoRules" Click="OnSelectPassPolicyModeClick"
                              Background="{Binding PolicyModal.NoRulesModeBackground}"
                              Foreground="{Binding PolicyModal.NoRulesModeForeground}"
                              FontWeight="{Binding PolicyModal.NoRulesModeFontWeight}"
                              CornerRadius="9" Padding="6,7" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                              ToolTip.Tip="Free passes anytime without bell window restrictions">
                        <TextBlock Text="No Rules" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" />
                      </Button>
                    </Grid>
                  </Border>

                  <!-- MODE: WINDOWS CONFIGURATION -->
                  <StackPanel Spacing="10" IsVisible="{Binding PolicyModal.IsWindowsMode}">
                    
                    <!-- Quick Presets -->
                    <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                      <TextBlock Text="Quick presets:" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Classes="pill-secondary" Tag="10/10" Click="OnApplyPresetClick" ToolTip.Tip="Lock first and last 10 minutes, allow middle">
                          <TextBlock Text="10/10 Lockout" FontSize="11" FontWeight="Bold" Foreground="#0369A1" />
                        </Button>
                        <Button Classes="pill-secondary" Tag="StartEnd" Click="OnApplyPresetClick" ToolTip.Tip="Allow passes ONLY during first and last 10 minutes (middle locked)">
                          <TextBlock Text="Start &amp; End Only" FontSize="11" FontWeight="Bold" Foreground="#0369A1" />
                        </Button>
                        <Button Classes="pill-secondary" Tag="Warning" Click="OnApplyPresetClick" ToolTip.Tip="Warn on first and last 10 minutes, allow middle">
                          <TextBlock Text="Warnings" FontSize="11" FontWeight="Bold" Foreground="#0369A1" />
                        </Button>
                      </StackPanel>
                    </Grid>

                    <Rectangle Height="1" Fill="#E0F2FE" />

                    <!-- Row 1: First Minutes -->
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                      <TextBlock Text="First minutes of period:" FontSize="13" Foreground="#475569" VerticalAlignment="Center" />
                      <NumericUpDown Grid.Column="1" Width="95" Minimum="0" Maximum="30" Increment="1" FormatString="0" ParsingNumberStyle="Integer" HorizontalContentAlignment="Center" Value="{Binding PolicyModal.FirstWindowMinutes}" />
                      <ComboBox Grid.Column="2" Width="100" ItemsSource="{Binding PolicyModal.BellActions}" SelectedItem="{Binding PolicyModal.FirstWindowAction}" />
                    </Grid>

                    <!-- Row 2: Middle of Class (In Between) -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                      <StackPanel Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="Middle of class (in between):" FontSize="13" Foreground="#475569" VerticalAlignment="Center" />
                        <TextBlock Text="Action during instruction between the first and last windows" FontSize="11" Foreground="#94A3B8" />
                      </StackPanel>
                      <ComboBox Grid.Column="1" Width="100" ItemsSource="{Binding PolicyModal.BellActions}" SelectedItem="{Binding PolicyModal.MiddleWindowAction}" />
                    </Grid>

                    <!-- Row 3: Last Minutes -->
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                      <TextBlock Text="Last minutes of period:" FontSize="13" Foreground="#475569" VerticalAlignment="Center" />
                      <NumericUpDown Grid.Column="1" Width="95" Minimum="0" Maximum="30" Increment="1" FormatString="0" ParsingNumberStyle="Integer" HorizontalContentAlignment="Center" Value="{Binding PolicyModal.LastWindowMinutes}" />
                      <ComboBox Grid.Column="2" Width="100" ItemsSource="{Binding PolicyModal.BellActions}" SelectedItem="{Binding PolicyModal.LastWindowAction}" />
                    </Grid>
                  </StackPanel>

                  <!-- MODE: NO PASSES INFO CARD -->
                  <Border Background="#FFF1F2" BorderBrush="#FECDD3" BorderThickness="1" CornerRadius="12" Padding="12,10" IsVisible="{Binding PolicyModal.IsNoPassesMode}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Center">
                      <Path Grid.Column="0" Data="{StaticResource IconUserX}" Width="16" Height="16" Stretch="Uniform" Stroke="#E11D48" StrokeThickness="2" StrokeLineCap="Round" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="No Passes During Class" FontWeight="Bold" FontSize="13" Foreground="#9F1239" />
                        <TextBlock Text="Pass checkouts are locked for the entire class period. The Mini Window indicates passes are locked." FontSize="11" Foreground="#BE123C" TextWrapping="Wrap" />
                      </StackPanel>
                    </Grid>
                  </Border>

                  <!-- MODE: NO RULES INFO CARD -->
                  <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="12" Padding="12,10" IsVisible="{Binding PolicyModal.IsNoRulesMode}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Center">
                      <Path Grid.Column="0" Data="{StaticResource IconCheck}" Width="16" Height="16" Stretch="Uniform" Stroke="#059669" StrokeThickness="2.2" StrokeLineCap="Round" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="Open Pass Access (No Rules)" FontWeight="Bold" FontSize="13" Foreground="#065F46" />
                        <TextBlock Text="Students may take passes at any time during class without bell-window lockouts or warnings." FontSize="11" Foreground="#047857" TextWrapping="Wrap" />
                      </StackPanel>
                    </Grid>
                  </Border>

                  <!-- PERIOD TIMELINE PREVIEW (Visible for All Modes) -->
                  <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="10,8">
                    <StackPanel Spacing="6">
                      <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                        <TextBlock Text="PERIOD TIMELINE PREVIEW" FontSize="10" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding PolicyModal.TimelineSummaryText}" FontSize="10" Foreground="#0284C7" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                      </Grid>

                      <!-- Preview Strip: Windows Mode (3 Segments) -->
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="4" Height="26" IsVisible="{Binding PolicyModal.IsWindowsMode}">
                        <Border Grid.Column="0" Background="{Binding PolicyModal.FirstWindowBadgeColor}" CornerRadius="6" Padding="8,3" VerticalAlignment="Stretch">
                          <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="First" FontSize="11" FontWeight="Bold" Foreground="White" />
                            <TextBlock Text="{Binding PolicyModal.FirstWindowMinutes, StringFormat='{}{0}m'}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                            <TextBlock Text="{Binding PolicyModal.FirstWindowAction, StringFormat='· {0}'}" FontSize="11" FontWeight="Bold" Foreground="White" />
                          </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="{Binding PolicyModal.MiddleWindowBadgeColor}" CornerRadius="6" Padding="8,3" VerticalAlignment="Stretch">
                          <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="In Between · " FontSize="11" FontWeight="SemiBold" Foreground="White" />
                            <TextBlock Text="{Binding PolicyModal.MiddleWindowAction}" FontSize="11" FontWeight="Black" Foreground="White" />
                          </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="{Binding PolicyModal.LastWindowBadgeColor}" CornerRadius="6" Padding="8,3" VerticalAlignment="Stretch">
                          <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="Last" FontSize="11" FontWeight="Bold" Foreground="White" />
                            <TextBlock Text="{Binding PolicyModal.LastWindowMinutes, StringFormat='{}{0}m'}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                            <TextBlock Text="{Binding PolicyModal.LastWindowAction, StringFormat='· {0}'}" FontSize="11" FontWeight="Bold" Foreground="White" />
                          </StackPanel>
                        </Border>
                      </Grid>

                      <!-- Preview Strip: No Passes Mode (Full Period Locked) -->
                      <Border Background="#F43F5E" CornerRadius="6" Padding="8,3" Height="26" VerticalAlignment="Center" IsVisible="{Binding PolicyModal.IsNoPassesMode}">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                          <Path Data="{StaticResource IconUserX}" Width="12" Height="12" Stretch="Uniform" Stroke="White" StrokeThickness="2" StrokeLineCap="Round" VerticalAlignment="Center" />
                          <TextBlock Text="Entire Class Period · Passes Locked (No Passes Allowed)" FontSize="11" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                      </Border>

                      <!-- Preview Strip: No Rules Mode (Full Period Open) -->
                      <Border Background="#059669" CornerRadius="6" Padding="8,3" Height="26" VerticalAlignment="Center" IsVisible="{Binding PolicyModal.IsNoRulesMode}">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                          <Path Data="{StaticResource IconCheck}" Width="12" Height="12" Stretch="Uniform" Stroke="White" StrokeThickness="2.2" StrokeLineCap="Round" VerticalAlignment="Center" />
                          <TextBlock Text="Entire Class Period · Open Pass Access (No Restrictions)" FontSize="11" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Border>

                  <Rectangle Height="1" Fill="#E0F2FE" />

                  <!-- BELL TRANSITION TIME OPTION -->
                  <StackPanel Spacing="3">
                    <CheckBox Content="Enable bell transition time between periods" IsChecked="{Binding PolicyModal.BellTransitionEnabled}" FontSize="13" />
                    <TextBlock Text="Marks passing periods between scheduled classes as 'Transition Time' in the Mini Window with countdown to the next class." FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="24,0,0,0" />
                  </StackPanel>

                  <Rectangle Height="1" Fill="#E0F2FE" />

                  <!-- WARNING SOUNDS CONFIGURATION -->
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconVolume2}" Width="14" Height="14" Stretch="Uniform" Stroke="#0284C7" StrokeThickness="1.8" StrokeLineCap="Round" VerticalAlignment="Center" />
                        <TextBlock Text="Warning Sound" FontSize="13" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center" />
                      </StackPanel>
                      <CheckBox Grid.Column="1" Content="Play warning sound" IsChecked="{Binding PolicyModal.WarningSoundEnabled}" FontSize="12" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" VerticalAlignment="Center" IsEnabled="{Binding PolicyModal.WarningSoundEnabled}">
                      <ComboBox ItemsSource="{Binding PolicyModal.AlertSounds}" SelectedItem="{Binding PolicyModal.AlertSound}" HorizontalAlignment="Stretch" />

                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconVolume2}" Width="12" Height="12" Stretch="Uniform" Stroke="#64748B" StrokeThickness="1.8" StrokeLineCap="Round" VerticalAlignment="Center" />
                        <Slider Minimum="10" Maximum="100" Value="{Binding PolicyModal.WarningSoundVolume}" Width="85" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding PolicyModal.WarningSoundVolume, StringFormat='{}{0}%'}" FontSize="11" FontWeight="Bold" Foreground="#64748B" Width="36" VerticalAlignment="Center" />
                      </StackPanel>

                      <Button Grid.Column="2" Classes="pill-secondary" Click="OnPlaySoundPreviewClick" ToolTip.Tip="Hear selected warning sound at configured volume">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                          <Path Data="{StaticResource IconVolume2}" Width="12" Height="12" Stretch="Uniform" Stroke="#0369A1" StrokeThickness="1.8" StrokeLineCap="Round" VerticalAlignment="Center" />
                          <TextBlock Text="Preview" FontSize="12" FontWeight="Bold" Foreground="#0369A1" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                    </Grid>
                  </StackPanel>

                  <Rectangle Height="1" Fill="#E0F2FE" />

                  <!-- TERMINAL ENFORCEMENT & MASTER DISABLE -->
                  <StackPanel Spacing="8">
                    <StackPanel Spacing="3">
                      <CheckBox Content="Enforce bell-time lockouts on the terminal" IsChecked="{Binding PolicyModal.TerminalEnforcementEnabled}" FontSize="13" />
                      <TextBlock Text="Optional and off by default. When enabled, the next 14 days are copied to the kiosk for offline enforcement." FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="24,0,0,0" />
                    </StackPanel>

                    <StackPanel Spacing="3">
                      <CheckBox Content="Disable bell-time window rules completely" IsChecked="{Binding PolicyModal.BellTimeRulesDisabled}" FontSize="13" />
                      <TextBlock Text="Bypasses all pass window lockouts and warnings during class (Mini Window shows passes open at all times)." FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="24,0,0,0" />
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </Border>

            </StackPanel>

            <!-- RIGHT COLUMN: BELL SCHEDULE -->
            <StackPanel Grid.Column="1" Spacing="14">
              
              <!-- Section Header: Bell Schedule -->
              <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                <Path Data="{StaticResource IconCalendar}" Width="18" Height="18" Stretch="Uniform" Stroke="#0284C7" StrokeThickness="2" StrokeLineCap="Round" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Bell Schedule" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                <Button Grid.Column="2" Classes="pill-secondary" Click="OnTogglePeriodSortClick" ToolTip.Tip="Toggle between earliest and latest period first">
                  <TextBlock Text="{Binding PolicyModal.SortOrderButtonText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </Button>
                <Button Grid.Column="3" Classes="pill-secondary" Click="OnAddPeriodClick">
                  <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconPlus}" Width="12" Height="12" Stretch="Uniform" Stroke="#0369A1" StrokeThickness="2" StrokeLineCap="Round" VerticalAlignment="Center" />
                    <TextBlock Text="Add Period" FontWeight="Bold" Foreground="#0369A1" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </Grid>

              <TextBlock Text="Regular and alternate templates stay inside this teacher workspace. Each period can identify the class section active at that time." FontSize="12" Foreground="#64748B" TextWrapping="Wrap" />

              <!-- PERIODS LIST -->
              <ItemsControl ItemsSource="{Binding PolicyModal.Periods}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Panel Margin="0,4">
                      <!-- VIEW MODE: COMPACT READABLE ROW -->
                      <Border Classes="hallzee-section-white" IsVisible="{Binding !IsEditing}">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="6" VerticalAlignment="Center">
                          <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding DisplayTitle}" FontWeight="Bold" FontSize="14" Foreground="#0F172A" VerticalAlignment="Center" />
                          <Border Grid.Row="0" Grid.Column="1" Background="#E0F2FE" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FormattedDaysSummary}" FontSize="11" FontWeight="SemiBold" Foreground="#0369A1" />
                          </Border>
                          <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding DisplayTimeRange}" FontSize="12" FontFamily="Cascadia Mono, Menlo, monospace" FontWeight="SemiBold" Foreground="#617694" VerticalAlignment="Center" />
                          <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button Classes="icon-circle info" Click="OnEditPeriodClick" Tag="{Binding}" ToolTip.Tip="Edit Period">
                              <Path Data="{StaticResource IconEdit}" Width="13" Height="13" Stretch="Uniform" Stroke="#0284C7" StrokeThickness="1.8" StrokeLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                            <Button Classes="icon-circle danger" Click="OnRemovePeriodClick" Tag="{Binding}" ToolTip.Tip="Delete Period">
                              <Path Data="{StaticResource IconTrash}" Width="13" Height="13" Stretch="Uniform" Stroke="#EF4444" StrokeThickness="1.8" StrokeLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                          </StackPanel>
                        </Grid>
                      </Border>

                      <!-- EDIT MODE: FORM FIELDS WITH CHECKBOXES -->
                      <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="16" Padding="12,10" IsVisible="{Binding IsEditing}">
                        <StackPanel Spacing="8">
                          <Grid ColumnDefinitions="1.5*,*,*,Auto" RowDefinitions="Auto,Auto" RowSpacing="6" ColumnSpacing="8" VerticalAlignment="Center">
                            <TextBox Text="{Binding EditName}" Watermark="Period name" FontSize="12" />
                            <TextBox Grid.Column="1" Text="{Binding EditStartTime}" Watermark="08:00 AM" FontSize="12" />
                            <TextBox Grid.Column="2" Text="{Binding EditEndTime}" Watermark="08:50 AM" FontSize="12" />
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                              <Button Classes="hallzee-pill-btn" Click="OnSavePeriodClick" Tag="{Binding}" Width="32" Height="32" Padding="0" ToolTip.Tip="Save Changes">
                                <Path Data="{StaticResource IconCheck}" Width="14" Height="14" Stretch="Uniform" Stroke="White" StrokeThickness="2.2" StrokeLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                              </Button>
                              <Button Classes="secondary" Click="OnCancelPeriodClick" Tag="{Binding}" Width="32" Height="32" Padding="0" ToolTip.Tip="Cancel Edit">
                                <Path Data="{StaticResource IconX}" Width="14" Height="14" Stretch="Uniform" Stroke="#64748B" StrokeThickness="2" StrokeLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                              </Button>
                            </StackPanel>
                            <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding EditClassSection}" Watermark="Class section (e.g. Chemistry 3)" FontSize="12" />
                            <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding EditScheduleName}" Watermark="Schedule template (Regular, Early Release…)" FontSize="12" />
                          </Grid>

                          <!-- DAY CHECKBOXES -->
                          <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                            <TextBlock Text="Active Days:" FontSize="11" FontWeight="Bold" Foreground="#166534" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                              <CheckBox Content="Mon" IsChecked="{Binding IsMonday}" FontSize="12" />
                              <CheckBox Content="Tue" IsChecked="{Binding IsTuesday}" FontSize="12" />
                              <CheckBox Content="Wed" IsChecked="{Binding IsWednesday}" FontSize="12" />
                              <CheckBox Content="Thu" IsChecked="{Binding IsThursday}" FontSize="12" />
                              <CheckBox Content="Fri" IsChecked="{Binding IsFriday}" FontSize="12" />
                            </StackPanel>
                          </Grid>
                        </StackPanel>
                      </Border>
                    </Panel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Border Classes="hallzee-section-white" Margin="0,8,0,0">
                <StackPanel Spacing="8">
                  <TextBlock Text="DATE EXCEPTIONS" FontSize="11" FontWeight="Bold" Foreground="#64748B" />
                  <TextBlock Text="Choose which named schedule template applies on a special date, or mark the day as no school." FontSize="11" Foreground="#64748B" TextWrapping="Wrap" />
                  <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="6">
                    <TextBox Text="{Binding PolicyModal.NewExceptionDate}" Watermark="YYYY-MM-DD" FontSize="12" />
                    <TextBox Grid.Column="1" Text="{Binding PolicyModal.NewExceptionScheduleName}" Watermark="Schedule template" FontSize="12" IsEnabled="{Binding !PolicyModal.NewExceptionIsNoSchool}" />
                    <Button Grid.Column="2" Classes="pill-secondary" Content="Add" Click="OnAddExceptionClick" />
                  </Grid>
                  <CheckBox Content="No school on this date" IsChecked="{Binding PolicyModal.NewExceptionIsNoSchool}" FontSize="12" />
                  <ItemsControl ItemsSource="{Binding PolicyModal.Exceptions}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                          <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="#334155" VerticalAlignment="Center" />
                          <Button Grid.Column="1" Classes="icon-circle danger" Content="✕" Tag="{Binding}" Click="OnRemoveExceptionClick" ToolTip.Tip="Remove date exception" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

            </StackPanel>

          </Grid>
        </ScrollViewer>

      </Grid>
    </Border>
  </Border>
</UserControl>
