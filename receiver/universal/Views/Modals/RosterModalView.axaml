<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BathroomSync.Universal.ViewModels;assembly=HallzeeSync.Universal"
             x:Class="BathroomSync.Universal.Views.RosterModalView"
             x:DataType="vm:MainViewModel">
  <Border Background="#99000000" Padding="32,24">
    <Border Background="White" CornerRadius="24" MaxWidth="980" MaxHeight="640" VerticalAlignment="Center" HorizontalAlignment="Stretch" Padding="28" BoxShadow="0 10 30 0 #40000000">
      <Grid RowDefinitions="Auto,*">
        
        <!-- HEADER -->
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
          <StackPanel Spacing="2">
            <TextBlock Text="Classroom Roster &amp; Students" FontSize="22" FontWeight="Bold" Foreground="#111B33" />
            <TextBlock Text="Manage student names, student IDs, and import SIS rosters." FontSize="14" Foreground="#617694" />
          </StackPanel>
          <Button Grid.Column="1" Classes="secondary" Content="✕" Click="OnCloseClick" Width="36" Height="36" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
        </Grid>

        <!-- VIEW SWITCHER: NORMAL LIST VS 2-PHASE CSV IMPORT PREVIEW -->
        <Grid Grid.Row="1">
          <!-- 1. NORMAL ROSTER VIEW -->
          <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12" IsVisible="{Binding !RosterModal.IsImportPreviewActive}">
            
            <!-- ROW 0: CLASSROOM SELECTION & CSV IMPORT BUTTON -->
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
              <TextBlock Text="Class:" FontWeight="Bold" FontSize="13" Foreground="#334155" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" Classes="filter-dropdown" ItemsSource="{Binding Profiles}" SelectedItem="{Binding ActiveProfile}" DisplayMemberBinding="{Binding Name}" MinWidth="200" VerticalAlignment="Center" />
              <Border Grid.Column="2" Background="#F1F5F9" CornerRadius="8" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="{Binding RosterModal.TotalStudents, StringFormat='{}{0} Enrolled'}" FontSize="12" FontWeight="SemiBold" Foreground="#475569" />
              </Border>
              <Button Grid.Column="3" Classes="hallzee-pill-btn" Content="Import Roster (CSV)" Click="OnImportCsvClick" Padding="16,8" FontSize="13" />
            </Grid>

            <!-- ROW 1: ADD NEW CLASS BAR -->
            <Border Grid.Row="1" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="16" Padding="14,8">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
                <TextBlock Text="Add new class:" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding PolicyModal.NewProfileName}" Watermark="Class / section name (e.g. Period 3 Chemistry)" FontSize="12" />
                <Button Grid.Column="2" Classes="secondary" Content="+ Create Class" Click="OnCreateClassClick" Padding="12,6" FontSize="12" />
              </Grid>
            </Border>

            <!-- ROW 2: STUDENTS LIST / TABLE WITH UNIFIED TABLE STYLES -->
            <Border Grid.Row="2" Classes="hallzee-table-container">
              <Grid RowDefinitions="Auto,*">
                <!-- TABLE HEADER -->
                <Border Classes="hallzee-table-header">
                  <Grid ColumnDefinitions="1.2*,2*,1*,1*,70" VerticalAlignment="Center">
                    <Button Classes="table-header-btn" Click="OnSortStudentClick">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Student ID" FontSize="12" FontWeight="Bold" Foreground="#0369A1" />
                        <TextBlock Text="{Binding RosterModal.StudentSortIndicator}" FontSize="12" Foreground="#94A3B8" />
                      </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Classes="table-header-btn" Click="OnSortStudentClick">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Student Name" FontSize="12" FontWeight="Bold" Foreground="#0369A1" />
                        <TextBlock Text="{Binding RosterModal.StudentSortIndicator}" FontSize="12" Foreground="#94A3B8" />
                      </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Classes="table-header-btn" Click="OnSortGradeClick">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Grade" FontSize="12" FontWeight="Bold" Foreground="#0369A1" />
                        <TextBlock Text="{Binding RosterModal.GradeSortIndicator}" FontSize="12" Foreground="#94A3B8" />
                      </StackPanel>
                    </Button>
                    <Button Grid.Column="3" Classes="table-header-btn" Click="OnSortPeriodClick">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Period" FontSize="12" FontWeight="Bold" Foreground="#0369A1" />
                        <TextBlock Text="{Binding RosterModal.PeriodSortIndicator}" FontSize="12" Foreground="#94A3B8" />
                      </StackPanel>
                    </Button>
                    <TextBlock Grid.Column="4" Text="Action" FontSize="12" FontWeight="Bold" Foreground="#0369A1" HorizontalAlignment="Right" Margin="0,0,8,0" />
                  </Grid>
                </Border>

                <!-- STUDENT ITEMS -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                  <Panel>
                    <ListBox ItemsSource="{Binding RosterModal.Students}" IsVisible="{Binding RosterModal.HasStudents}" Classes="hallzee-table-list">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <Border Classes="hallzee-table-row">
                            <Grid ColumnDefinitions="1.2*,2*,1*,1*,70" VerticalAlignment="Center">
                              <!-- Student ID -->
                              <TextBlock Text="{Binding StudentId, StringFormat='#{0}'}" FontWeight="Bold" FontSize="13" Foreground="#0F172A" VerticalAlignment="Center" />
                              
                              <!-- Student Name -->
                              <TextBlock Grid.Column="1" Text="{Binding FullName}" FontWeight="Bold" FontSize="13" Foreground="#0F172A" VerticalAlignment="Center" />
                              
                              <!-- Grade -->
                              <TextBlock Grid.Column="2" Text="{Binding Grade, FallbackValue='—'}" FontSize="13" Foreground="#475569" VerticalAlignment="Center" />
                              
                              <!-- Period -->
                              <TextBlock Grid.Column="3" Text="{Binding ClassPeriod, FallbackValue='—'}" FontSize="13" Foreground="#475569" VerticalAlignment="Center" />
                              
                              <!-- Action -->
                              <Button Grid.Column="4" Classes="danger" Click="OnDeleteStudentClick" Tag="{Binding StudentId}" HorizontalAlignment="Right" Margin="0,0,6,0" Width="36" Height="32" Padding="0" ToolTip.Tip="Remove student from roster">
                                <Path Data="{StaticResource IconTrash}" Width="13" Height="13" Stretch="Uniform" Stroke="#E11D48" StrokeThickness="1.8" StrokeLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                              </Button>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- EMPTY STATE -->
                    <StackPanel IsVisible="{Binding RosterModal.HasNoStudents}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Margin="32">
                      <Path Data="{StaticResource IconUsers}" Width="36" Height="36" Stretch="Uniform" Stroke="#CBD5E1" StrokeThickness="1.8" StrokeLineCap="Round" HorizontalAlignment="Center" />
                      <TextBlock Text="No students enrolled in this class yet" FontSize="14" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center" />
                      <TextBlock Text="Click 'Import Roster (CSV)' above to upload your roster from a spreadsheet or SIS export." FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="380" />
                    </StackPanel>
                  </Panel>
                </ScrollViewer>
              </Grid>
            </Border>

            <!-- ROW 3: FOOTER STATUS -->
            <TextBlock Grid.Row="3" Text="{Binding RosterModal.ImportStatusMessage}" Foreground="{Binding RosterModal.ImportStatusColor}" FontSize="13" FontWeight="SemiBold" />
          </Grid>

          <!-- 2. TWO-PHASE CSV IMPORT & COLUMN MAPPING VERIFICATION VIEW -->
          <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12" IsVisible="{Binding RosterModal.IsImportPreviewActive}">
            <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="12">
              <TextBlock Text="Step 2: Confirm Column Mappings below based on sample rows from your CSV." FontWeight="SemiBold" FontSize="13" Foreground="#166534" />
            </Border>

            <!-- COLUMN MAPPING DROPDOWNS -->
            <Grid Grid.Row="1" ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="10">
              <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                <TextBlock Text="Student ID Column *" FontSize="12" FontWeight="Bold" Foreground="#334155" />
                <ComboBox ItemsSource="{Binding RosterModal.AvailableHeaders}" SelectedItem="{Binding RosterModal.SelectedIdColumn}" HorizontalAlignment="Stretch" />
              </StackPanel>

              <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                <TextBlock Text="First Name Column" FontSize="12" FontWeight="Bold" Foreground="#334155" />
                <ComboBox ItemsSource="{Binding RosterModal.AvailableHeaders}" SelectedItem="{Binding RosterModal.SelectedFirstNameColumn}" HorizontalAlignment="Stretch" />
              </StackPanel>

              <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4">
                <TextBlock Text="Last Name Column" FontSize="12" FontWeight="Bold" Foreground="#334155" />
                <ComboBox ItemsSource="{Binding RosterModal.AvailableHeaders}" SelectedItem="{Binding RosterModal.SelectedLastNameColumn}" HorizontalAlignment="Stretch" />
              </StackPanel>

              <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                <TextBlock Text="Combined Full Name" FontSize="12" FontWeight="Bold" Foreground="#334155" />
                <ComboBox ItemsSource="{Binding RosterModal.AvailableHeaders}" SelectedItem="{Binding RosterModal.SelectedFullNameColumn}" HorizontalAlignment="Stretch" />
              </StackPanel>

              <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                <TextBlock Text="Grade Column" FontSize="12" FontWeight="Bold" Foreground="#334155" />
                <ComboBox ItemsSource="{Binding RosterModal.AvailableHeaders}" SelectedItem="{Binding RosterModal.SelectedGradeColumn}" HorizontalAlignment="Stretch" />
              </StackPanel>

              <StackPanel Grid.Row="1" Grid.Column="2" Spacing="4">
                <TextBlock Text="Period / Section" FontSize="12" FontWeight="Bold" Foreground="#334155" />
                <ComboBox ItemsSource="{Binding RosterModal.AvailableHeaders}" SelectedItem="{Binding RosterModal.SelectedPeriodColumn}" HorizontalAlignment="Stretch" />
              </StackPanel>
            </Grid>

            <!-- SAMPLE PREVIEW DATA TABLE -->
            <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <StackPanel Spacing="6">
                  <TextBlock Text="CSV File Sample Rows:" FontSize="12" FontWeight="Bold" Foreground="#64748B" />
                  <ItemsControl ItemsSource="{Binding RosterModal.PreviewData.SampleRows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,2">
                          <ItemsControl ItemsSource="{Binding}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="12" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="12" Foreground="#334155" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>
            </Border>

            <!-- ACTION BUTTONS -->
            <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" VerticalAlignment="Center">
              <TextBlock Text="{Binding RosterModal.ImportStatusMessage}" Foreground="{Binding RosterModal.ImportStatusColor}" FontSize="12" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="secondary" Content="Cancel" Click="OnCancelImportClick" />
              <Button Grid.Column="2" Classes="hallzee-pill-btn" Content="Confirm &amp; Import" Click="OnConfirmImportClick" IsEnabled="{Binding RosterModal.CanConfirmImport}" Padding="16,8" FontSize="13" />
            </Grid>
          </Grid>
        </Grid>
      </Grid>
    </Border>
  </Border>
</UserControl>
