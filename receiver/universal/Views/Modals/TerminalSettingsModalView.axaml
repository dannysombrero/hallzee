<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BathroomSync.Universal.ViewModels;assembly=HallzeeSync.Universal"
             x:Class="BathroomSync.Universal.Views.TerminalSettingsModalView"
             x:DataType="vm:MainViewModel">
  <!-- OVERLAY WITH GUARANTEED PADDING SO MODAL NEVER CLIPS WINDOW BOUNDS -->
  <Border Background="#99000000" Padding="32,24" PointerPressed="OnBackdropPointerPressed">
    <Border Classes="hallzee-modal-window" MaxWidth="680" MaxHeight="700" VerticalAlignment="Center" HorizontalAlignment="Stretch">
      <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16">
        
        <!-- HEADER -->
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2">
            <TextBlock Text="Settings" FontSize="20" FontWeight="Bold" Foreground="#0F172A" />
            <TextBlock Text="Configure this teacher workspace and its assigned kiosk." FontSize="13" Foreground="#64748B" />
          </StackPanel>
          <Button Grid.Column="1" Classes="secondary" Content="✕" Click="OnCloseClick" Width="36" Height="36" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
        </Grid>

        <!-- SUBMENU TAB SELECTOR (Profile, Device) -->
        <Border Grid.Row="1" Classes="hallzee-subnav-bar" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Button Classes="tab-btn" Click="OnProfileTabClick" Background="{Binding TerminalSettingsModal.ProfileTabBackground}" Foreground="{Binding TerminalSettingsModal.ProfileTabForeground}" CornerRadius="10" Padding="14,6">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Path Data="{StaticResource IconUsers}" Width="14" Height="14" Stretch="Uniform" Stroke="{Binding TerminalSettingsModal.ProfileTabForeground}" StrokeThickness="2" StrokeLineCap="Round" VerticalAlignment="Center" />
                <TextBlock Text="Teacher" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="tab-btn" Click="OnDeviceTabClick" Background="{Binding TerminalSettingsModal.DeviceTabBackground}" Foreground="{Binding TerminalSettingsModal.DeviceTabForeground}" CornerRadius="10" Padding="14,6">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Path Data="{StaticResource IconRadio}" Width="14" Height="14" Stretch="Uniform" Stroke="{Binding TerminalSettingsModal.DeviceTabForeground}" StrokeThickness="2" StrokeLineCap="Round" VerticalAlignment="Center" />
                <TextBlock Text="Device" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>

        <!-- TAB 1: PROFILE / CLASSROOM SETTINGS -->
        <StackPanel Grid.Row="2" Spacing="16" IsVisible="{Binding TerminalSettingsModal.IsProfileSelected}">
          
          <Border Classes="hallzee-section-white" Padding="20">
            <StackPanel Spacing="14">
              <TextBlock Text="CLASSROOM &amp; TEACHER INFORMATION" FontSize="11" FontWeight="Bold" Foreground="#64748B" />
              <TextBlock Text="Set your classroom details to display in the application header." FontSize="12" Foreground="#475569" TextWrapping="Wrap" />

              <StackPanel Spacing="12" Margin="0,4,0,0">
                <!-- Teacher Name -->
                <Grid ColumnDefinitions="130,*" VerticalAlignment="Center">
                  <TextBlock Text="Teacher Name:" FontSize="13" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" Text="{Binding TerminalSettingsModal.TeacherName}" Watermark="e.g. Herrero" FontSize="13" />
                </Grid>

                <Rectangle Height="1" Fill="#E0F2FE" />

                <!-- School -->
                <Grid ColumnDefinitions="130,*" VerticalAlignment="Center">
                  <TextBlock Text="School:" FontSize="13" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" Text="{Binding TerminalSettingsModal.School}" Watermark="e.g. HRMS" FontSize="13" />
                </Grid>

                <Rectangle Height="1" Fill="#E0F2FE" />

                <!-- Room -->
                <Grid ColumnDefinitions="130,*" VerticalAlignment="Center">
                  <TextBlock Text="Room:" FontSize="13" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" Text="{Binding TerminalSettingsModal.Room}" Watermark="e.g. Room 2-207" FontSize="13" />
                </Grid>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- HEADER PREVIEW CARD -->
          <Border Classes="hallzee-section-white" Padding="14">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Center">
              <Path Data="{StaticResource IconShieldCheck}" Width="16" Height="16" Stretch="Uniform" Stroke="#0284C7" StrokeThickness="2" StrokeLineCap="Round" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="Header Bar Display:" FontSize="11" FontWeight="Bold" Foreground="#0369A1" />
                <TextBlock Text="{Binding HeaderLocationText, StringFormat='Hallzee Desktop Client | {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" />
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>

        <!-- TAB 2: DEVICE SETTINGS -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" IsVisible="{Binding TerminalSettingsModal.IsDeviceSelected}">
        <StackPanel Spacing="16">
          
          <!-- STUDENT ID LIMIT -->
          <Border Classes="hallzee-section-white" Padding="20">
            <StackPanel Spacing="12">
              <TextBlock Text="STUDENT ID KEYPAD LIMIT" FontSize="11" FontWeight="Bold" Foreground="#64748B" />
              <TextBlock Text="Set the maximum number of digits students can type at the kiosk (4–16 digits)." FontSize="12" Foreground="#475569" TextWrapping="Wrap" />

              <Grid ColumnDefinitions="2*,*" VerticalAlignment="Center" Margin="0,4,0,0">
                <TextBlock Text="Max Student ID Length:" FontSize="13" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" />
                <NumericUpDown Grid.Column="1" Minimum="4" Maximum="16" Increment="1" FormatString="0" ParsingNumberStyle="Integer" HorizontalContentAlignment="Center" Value="{Binding TerminalSettingsModal.MaxStudentIdLength}" />
              </Grid>
            </StackPanel>
          </Border>

          <!-- DEVICE INFORMATION -->
          <Border Classes="hallzee-section-white" Padding="20">
            <StackPanel Spacing="10">
              <TextBlock Text="DEVICE INFORMATION" FontSize="11" FontWeight="Bold" Foreground="#64748B" />
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12" ColumnSpacing="14">
                <TextBlock Text="Terminal Name:" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                <Panel Grid.Column="1">
                  <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding !TerminalSettingsModal.IsEditingName}">
                    <TextBlock Text="{Binding TerminalSettingsModal.TerminalName}" FontSize="13" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button Grid.Column="1" Classes="secondary" Click="OnEditNameClick" IsEnabled="{Binding CanEditDevice}" ToolTip.Tip="Edit friendly name" AutomationProperties.Name="Edit friendly name" Padding="8">
                      <Path Data="{StaticResource IconEdit}" Width="15" Height="15" Stretch="Uniform" Stroke="#0369A1" StrokeThickness="2" />
                    </Button>
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" IsVisible="{Binding TerminalSettingsModal.IsEditingName}">
                    <TextBox Text="{Binding TerminalSettingsModal.EditedTerminalName}" MaxLength="24" Watermark="e.g. Room 204 Door" FontSize="12" IsEnabled="{Binding CanEditDevice}" />
                    <Button Grid.Column="1" Classes="hallzee-pill-btn" Content="Save" Click="OnSaveNameClick" IsEnabled="{Binding CanEditDevice}" Padding="10,6" />
                    <Button Grid.Column="2" Classes="secondary" Content="Cancel" Click="OnCancelNameClick" IsEnabled="{Binding !IsDeviceBusy}" Padding="10,6" />
                  </Grid>
                </Panel>
                <TextBlock Grid.Row="1" Text="Unique Device ID:" FontSize="12" Foreground="#64748B" />
                <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DeviceUniqueId}" FontSize="12" FontWeight="SemiBold" Foreground="#334155" TextWrapping="Wrap" />
                <TextBlock Grid.Row="2" Text="GATT Transport:" FontSize="12" Foreground="#64748B" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="Bluetooth Low Energy (BLE 4.2+)" FontSize="12" FontWeight="SemiBold" Foreground="#334155" TextWrapping="Wrap" />
                <TextBlock Grid.Row="3" Text="Connection:" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                <Border Grid.Row="3" Grid.Column="1" Background="{Binding ConnectionBadgeBackground}" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left">
                  <TextBlock Text="{Binding DeviceConnectionStatus}" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                </Border>
              </Grid>
            </StackPanel>
          </Border>
          <Border Classes="hallzee-section-white" Padding="20">
            <StackPanel Spacing="10">
              <TextBlock Text="Disconnecting will unpair this computer from the terminal. You will need pairing mode and a new passkey to connect again." FontSize="12" Foreground="#475569" TextWrapping="Wrap" />
              <TextBlock Text="Check in all active passes before unpairing." IsVisible="{Binding HasStudentsOut}" FontSize="12" Foreground="#B45309" TextWrapping="Wrap" />
              <TextBlock Text="Connect to the terminal first to release its pairing." IsVisible="{Binding !IsConnected}" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" />
              <Button Classes="danger" Content="Disconnect &amp; Unpair" Click="OnDisconnectAndUnpairClick" IsEnabled="{Binding CanUnpairDevice}" HorizontalAlignment="Left" Padding="14,8" />
            </StackPanel>
          </Border>
        </StackPanel>
        </ScrollViewer>

        <!-- FOOTER ACTIONS -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" VerticalAlignment="Center">
          <TextBlock Text="{Binding TerminalSettingsModal.StatusMessage}" Foreground="{Binding TerminalSettingsModal.StatusColor}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
          <Button Grid.Column="1" Classes="hallzee-pill-btn" Content="Save Classroom Info" Click="OnSaveClassroomInfoClick" Padding="16,8" FontSize="13" IsVisible="{Binding TerminalSettingsModal.IsProfileSelected}" />
          <Button Grid.Column="2" Classes="hallzee-pill-btn" Content="Apply ID Limit" IsEnabled="{Binding CanEditDevice}" Click="OnApplyClick" Padding="16,8" FontSize="13" IsVisible="{Binding TerminalSettingsModal.IsDeviceSelected}" />
        </Grid>
      </Grid>
    </Border>
  </Border>
</UserControl>
