<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BathroomSync.Universal.ViewModels;assembly=HallzeeSync.Universal"
             x:Class="BathroomSync.Universal.Views.TerminalSettingsModalView"
             x:DataType="vm:MainViewModel">
  <!-- OVERLAY WITH GUARANTEED PADDING SO MODAL NEVER CLIPS WINDOW BOUNDS -->
  <Border Background="#99000000" Padding="32,24">
    <Border Background="White" CornerRadius="24" MaxWidth="680" MaxHeight="620" VerticalAlignment="Center" HorizontalAlignment="Stretch" Padding="24" BoxShadow="0 10 30 0 #40000000">
      <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16">
        
        <!-- HEADER -->
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2">
            <TextBlock Text="Settings" FontSize="20" FontWeight="Bold" Foreground="#0F172A" />
            <TextBlock Text="Configure classroom profiles, kiosk hardware parameters, and preferences." FontSize="13" Foreground="#64748B" />
          </StackPanel>
          <Button Grid.Column="1" Classes="secondary" Content="✕" Click="OnCloseClick" Width="36" Height="36" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
        </Grid>

        <!-- SUBMENU TAB SELECTOR (Profile, Device) -->
        <Border Grid.Row="1" Classes="hallzee-subnav-bar" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Button Classes="tab-btn" Click="OnProfileTabClick" Background="{Binding TerminalSettingsModal.ProfileTabBackground}" Foreground="{Binding TerminalSettingsModal.ProfileTabForeground}" CornerRadius="10" Padding="14,6">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Path Data="{StaticResource IconUsers}" Width="14" Height="14" Stretch="Uniform" Stroke="{Binding TerminalSettingsModal.ProfileTabForeground}" StrokeThickness="2" StrokeLineCap="Round" VerticalAlignment="Center" />
                <TextBlock Text="Profile" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="tab-btn" Click="OnDeviceTabClick" Background="{Binding TerminalSettingsModal.DeviceTabBackground}" Foreground="{Binding TerminalSettingsModal.DeviceTabForeground}" CornerRadius="10" Padding="14,6">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Path Data="{StaticResource IconRadio}" Width="14" Height="14" Stretch="Uniform" Stroke="{Binding TerminalSettingsModal.DeviceTabForeground}" StrokeThickness="2" StrokeLineCap="Round" VerticalAlignment="Center" />
                <TextBlock Text="Device" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>

        <!-- TAB 1: PROFILE / CLASSROOM SETTINGS -->
        <StackPanel Grid.Row="2" Spacing="16" IsVisible="{Binding TerminalSettingsModal.IsProfileSelected}">
          
          <Border Classes="hallzee-section" Padding="20">
            <StackPanel Spacing="14">
              <TextBlock Text="CLASSROOM &amp; TEACHER INFORMATION" FontSize="11" FontWeight="Bold" Foreground="#64748B" />
              <TextBlock Text="Set your classroom details to display in the application header." FontSize="12" Foreground="#475569" TextWrapping="Wrap" />

              <StackPanel Spacing="12" Margin="0,4,0,0">
                <!-- Teacher Name -->
                <Grid ColumnDefinitions="130,*" VerticalAlignment="Center">
                  <TextBlock Text="Teacher Name:" FontSize="13" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" Text="{Binding TerminalSettingsModal.TeacherName}" Watermark="e.g. Herrero" FontSize="13" />
                </Grid>

                <Rectangle Height="1" Fill="#E0F2FE" />

                <!-- School -->
                <Grid ColumnDefinitions="130,*" VerticalAlignment="Center">
                  <TextBlock Text="School:" FontSize="13" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" Text="{Binding TerminalSettingsModal.School}" Watermark="e.g. HRMS" FontSize="13" />
                </Grid>

                <Rectangle Height="1" Fill="#E0F2FE" />

                <!-- Room -->
                <Grid ColumnDefinitions="130,*" VerticalAlignment="Center">
                  <TextBlock Text="Room:" FontSize="13" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" Text="{Binding TerminalSettingsModal.Room}" Watermark="e.g. Room 2-207" FontSize="13" />
                </Grid>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- HEADER PREVIEW CARD -->
          <Border Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="16" Padding="14">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Center">
              <Path Data="{StaticResource IconShieldCheck}" Width="16" Height="16" Stretch="Uniform" Stroke="#0284C7" StrokeThickness="2" StrokeLineCap="Round" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="Header Bar Display:" FontSize="11" FontWeight="Bold" Foreground="#0369A1" />
                <TextBlock Text="{Binding HeaderLocationText, StringFormat='Hallzee Desktop Client | {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" />
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>

        <!-- TAB 2: DEVICE SETTINGS -->
        <StackPanel Grid.Row="2" Spacing="16" IsVisible="{Binding TerminalSettingsModal.IsDeviceSelected}">
          
          <!-- STUDENT ID LIMIT -->
          <Border Classes="hallzee-section">
            <StackPanel Spacing="12">
              <TextBlock Text="STUDENT ID KEYPAD LIMIT" FontSize="11" FontWeight="Bold" Foreground="#64748B" />
              <TextBlock Text="Set the maximum number of digits students can type at the kiosk (4–16 digits)." FontSize="12" Foreground="#475569" TextWrapping="Wrap" />

              <Grid ColumnDefinitions="2*,*" VerticalAlignment="Center" Margin="0,4,0,0">
                <TextBlock Text="Max Student ID Length:" FontSize="13" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" />
                <NumericUpDown Grid.Column="1" Minimum="4" Maximum="16" Increment="1" FormatString="0" ParsingNumberStyle="Integer" HorizontalContentAlignment="Center" Value="{Binding TerminalSettingsModal.MaxStudentIdLength}" />
              </Grid>
            </StackPanel>
          </Border>

          <!-- DEVICE INFORMATION -->
          <Border Classes="hallzee-section">
            <StackPanel Spacing="8">
              <TextBlock Text="DEVICE INFORMATION" FontSize="11" FontWeight="Bold" Foreground="#64748B" />
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="12">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Node Name:" FontSize="12" Foreground="#64748B" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TerminalSettingsModal.TerminalName}" FontSize="12" FontWeight="SemiBold" Foreground="#334155" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="GATT Transport:" FontSize="12" Foreground="#64748B" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="Bluetooth Low Energy (BLE 4.2+)" FontSize="12" FontWeight="SemiBold" Foreground="#334155" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Connection:" FontSize="12" Foreground="#64748B" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ConnectionStatusText}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding ConnectionBadgeForeground}" />
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- FOOTER ACTIONS -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" VerticalAlignment="Center">
          <TextBlock Text="{Binding TerminalSettingsModal.StatusMessage}" Foreground="{Binding TerminalSettingsModal.StatusColor}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="hallzee-pill-btn" Content="Save Classroom Info" Click="OnSaveClassroomInfoClick" Padding="16,8" FontSize="13" IsVisible="{Binding TerminalSettingsModal.IsProfileSelected}" />
          <Button Grid.Column="2" Classes="hallzee-pill-btn" Content="Apply Setting to Kiosk" Click="OnApplyClick" Padding="16,8" FontSize="13" IsVisible="{Binding TerminalSettingsModal.IsDeviceSelected}" />
        </Grid>
      </Grid>
    </Border>
  </Border>
</UserControl>
