<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BathroomSync.Universal.ViewModels;assembly=HallzeeSync.Universal"
             x:Class="BathroomSync.Universal.Views.TripsModalView"
             x:DataType="vm:MainViewModel">
  <Border Background="#99000000">
    <Border Background="White" CornerRadius="22" Width="980" MaxHeight="680" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24" BoxShadow="0 10 30 0 #40000000">
      <Grid RowDefinitions="Auto,*,Auto">
        
        <!-- HEADER -->
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
          <StackPanel Spacing="2">
            <TextBlock Text="Hall Pass Trip History" FontSize="20" FontWeight="Bold" Foreground="#0F172A" />
            <TextBlock Text="Search, filter, and inspect detailed pass usage." FontSize="13" Foreground="#64748B" />
          </StackPanel>
          <Button Grid.Column="1" Classes="secondary" Content="✕" Click="OnCloseClick" Width="40" Height="40" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
        </Grid>

        <!-- CONTENT GRID -->
        <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
          
          <!-- ROW 0: CLASSROOM SELECTION & EXPORT ACTION BUTTON -->
          <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
            <TextBlock Text="Class:" FontWeight="Bold" FontSize="13" Foreground="#334155" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Profiles}" SelectedItem="{Binding ActiveProfile}" DisplayMemberBinding="{Binding Name}" MinWidth="200" VerticalAlignment="Center" />
            <Border Grid.Column="2" Background="#F1F5F9" CornerRadius="6" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center">
              <TextBlock Text="{Binding TripsModal.TotalTrips, StringFormat='{}{0} Records'}" FontSize="12" FontWeight="SemiBold" Foreground="#475569" />
            </Border>
            <Button Grid.Column="3" Classes="hallzee-pill-btn" Click="OnExportCsvClick" Padding="16,8" FontSize="13">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <PathIcon Data="{StaticResource IconDownload}" Width="13" Height="13" Foreground="White" VerticalAlignment="Center" />
                <TextBlock Text="Export" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>

          <!-- ROW 1: SEARCH & FILTER TOOLBAR -->
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalAlignment="Center">
            <Border Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="24" Padding="14,6">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <PathIcon Data="{StaticResource IconSearch}" Width="20" Height="20" Foreground="#8AA4C2" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding TripsModal.SearchText, UpdateSourceTrigger=PropertyChanged}" Watermark="Filter student name, ID, or trip…" FontSize="14" Padding="0,6" Background="Transparent" BorderThickness="0" />
              </Grid>
            </Border>
            <ComboBox Grid.Column="1" ItemsSource="{Binding TripsModal.StatusOptions}" SelectedItem="{Binding TripsModal.SelectedStatus}" Width="160" />
          </Grid>

          <!-- ROW 2: TRIPS TABLE (WITH SEPARATE TIME OUT & TIME IN COLUMNS AND COMPACT DURATION) -->
          <Border Grid.Row="2" BorderBrush="#D8EDF8" BorderThickness="1" CornerRadius="18" Background="White" MinHeight="260" ClipToBounds="True">
            <Grid RowDefinitions="Auto,*">
              
              <!-- TABLE HEADER -->
              <Border Background="#F0F9FF" BorderBrush="#E1F1F8" BorderThickness="0,0,0,1" Padding="16,14" CornerRadius="18,18,0,0">
                <Grid ColumnDefinitions="1.25*,2.2*,1.1*,1.1*,1.1*,0.9*,90" VerticalAlignment="Center">
                  <Button Classes="table-header-btn" Click="OnSortTripIdClick">
                    <StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="TRIP ID" FontSize="11" FontWeight="Bold" Foreground="#0C3554" /><TextBlock Text="{Binding TripsModal.TripIdSortIndicator}" FontSize="11" Foreground="#8AA4C2" /></StackPanel>
                  </Button>
                  
                  <Button Grid.Column="1" Classes="table-header-btn" Click="OnSortStudentClick">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                      <TextBlock Text="STUDENT" FontSize="11" FontWeight="Bold" Foreground="#0C3554" />
                      <TextBlock Text="{Binding TripsModal.StudentSortIndicator}" FontSize="11" FontWeight="Bold" Foreground="#0284C7" />
                    </StackPanel>
                  </Button>

                  <Button Grid.Column="2" Classes="table-header-btn" Click="OnSortDateClick">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                      <TextBlock Text="DATE" FontSize="11" FontWeight="Bold" Foreground="#0C3554" />
                      <TextBlock Text="{Binding TripsModal.DateSortIndicator}" FontSize="11" FontWeight="Bold" Foreground="#0284C7" />
                    </StackPanel>
                  </Button>

                  <Button Grid.Column="3" Classes="table-header-btn" Click="OnSortTimeOutClick">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                      <TextBlock Text="TIME OUT" FontSize="11" FontWeight="Bold" Foreground="#0C3554" />
                      <TextBlock Text="{Binding TripsModal.TimeOutSortIndicator}" FontSize="11" FontWeight="Bold" Foreground="#0284C7" />
                    </StackPanel>
                  </Button>

                  <Button Grid.Column="4" Classes="table-header-btn" Click="OnSortTimeInClick">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                      <TextBlock Text="TIME IN" FontSize="11" FontWeight="Bold" Foreground="#0C3554" />
                      <TextBlock Text="{Binding TripsModal.TimeInSortIndicator}" FontSize="11" FontWeight="Bold" Foreground="#0284C7" />
                    </StackPanel>
                  </Button>

                  <Button Grid.Column="5" Classes="table-header-btn" Click="OnSortDurationClick">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                      <TextBlock Text="DURATION" FontSize="11" FontWeight="Bold" Foreground="#0C3554" />
                      <TextBlock Text="{Binding TripsModal.DurationSortIndicator}" FontSize="11" FontWeight="Bold" Foreground="#0284C7" />
                    </StackPanel>
                  </Button>

                  <Button Grid.Column="6" Classes="table-header-btn" Click="OnSortStatusClick" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                      <TextBlock Text="STATUS" FontSize="11" FontWeight="Bold" Foreground="#0C3554" />
                      <TextBlock Text="{Binding TripsModal.StatusSortIndicator}" FontSize="11" FontWeight="Bold" Foreground="#0284C7" />
                    </StackPanel>
                  </Button>
                </Grid>
              </Border>

              <!-- TRIPS LIST -->
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Panel>
                  <ListBox ItemsSource="{Binding TripsModal.Trips}" IsVisible="{Binding TripsModal.HasTrips}">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="#EDF6FB" BorderThickness="0,0,0,1" Padding="16,14">
                        <Grid ColumnDefinitions="1.25*,2.2*,1.1*,1.1*,1.1*,0.9*,90" VerticalAlignment="Center">
                          <TextBlock Text="{Binding TripId, StringFormat='TRIP-{0:D4}'}" FontFamily="Cascadia Mono, Menlo, monospace" FontWeight="Bold" FontSize="12" Foreground="#617694" VerticalAlignment="Center" />
                          
                          <!-- STUDENT -->
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="14" Foreground="#111B33" />
                            <TextBlock Text="{Binding StudentId, StringFormat='#{0}'}" FontSize="11" Foreground="#617694" />
                          </StackPanel>

                          <!-- DATE -->
                          <TextBlock Grid.Column="2" Text="{Binding TripDate}" FontSize="13" Foreground="#4A5E7A" VerticalAlignment="Center" />
                          
                          <!-- TIME OUT -->
                          <TextBlock Grid.Column="3" Text="{Binding TimeOut}" FontSize="13" Foreground="#4A5E7A" VerticalAlignment="Center" />

                          <!-- TIME IN -->
                          <TextBlock Grid.Column="4" Text="{Binding TimeIn, FallbackValue='--'}" FontSize="13" Foreground="#4A5E7A" VerticalAlignment="Center" />

                          <!-- DURATION -->
                          <TextBlock Grid.Column="5" Text="{Binding FormattedDuration}" FontWeight="Bold" FontSize="13" Foreground="#111B33" VerticalAlignment="Center" />
                          
                          <!-- STATUS -->
                          <Border Grid.Column="6" Classes="status-pill" Background="{Binding StatusBackground}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0">
                            <TextBlock Text="{Binding StatusDisplay}" Foreground="{Binding StatusForeground}" />
                          </Border>
                        </Grid>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>

                  <!-- EMPTY STATE -->
                  <StackPanel IsVisible="{Binding TripsModal.HasNoTrips}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Margin="32">
                    <PathIcon Data="{StaticResource IconHistory}" Width="36" Height="36" Foreground="#CBD5E1" HorizontalAlignment="Center" />
                    <TextBlock Text="No hall pass trips found" FontSize="14" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center" />
                    <TextBlock Text="Completed trips from the kiosk terminal or manual passes will appear here." FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="380" />
                  </StackPanel>
                </Panel>
              </ScrollViewer>
            </Grid>
          </Border>

          <!-- ROW 3: FOOTER STATUS -->
          <TextBlock Grid.Row="3" Text="{Binding TripsModal.ExportStatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="#166534" IsVisible="{Binding TripsModal.ExportStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </Grid>

      </Grid>
    </Border>
  </Border>
</UserControl>
