<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BathroomSync.Universal.ViewModels;assembly=HallzeeSync.Universal"
             x:Class="BathroomSync.Universal.Views.TripsModalView"
             x:DataType="vm:MainViewModel">
  <Border Background="#99000000">
    <Border Background="White" CornerRadius="16" Width="720" MaxHeight="560" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24" BoxShadow="0 10 30 0 #40000000">
      <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16">
        
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2">
            <TextBlock Text="Hall Pass Trip History" FontSize="20" FontWeight="Bold" Foreground="#0F172A" />
            <TextBlock Text="Search, filter, and inspect detailed pass usage." FontSize="13" Foreground="#64748B" />
          </StackPanel>
          <Button Grid.Column="1" Classes="secondary" Content="✕" Click="OnCloseClick" Width="36" Height="36" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="2*,*,Auto" ColumnSpacing="12">
          <TextBox Text="{Binding TripsModal.SearchText}" Watermark="Filter by student name or ID…" />
          <ComboBox Grid.Column="1" SelectedItem="{Binding TripsModal.SelectedStatus}" HorizontalAlignment="Stretch">
            <ComboBoxItem Content="ALL" />
            <ComboBoxItem Content="COMPLETED" />
            <ComboBoxItem Content="MANUAL_RESET" />
          </ComboBox>
          <Button Grid.Column="2" Classes="hallzee-pill-btn" Content="Refresh" Click="OnFilterClick" Padding="14,6" FontSize="12" />
        </Grid>

        <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ListBox ItemsSource="{Binding TripsModal.Trips}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="Auto,2*,*,*,*,Auto" Margin="0,4" VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource IconHistory}" Width="16" Height="16" Margin="4,0,8,0" Foreground="#0284C7" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A" />
                      <TextBlock Text="{Binding StudentId, StringFormat='ID: {0}'}" FontSize="11" Foreground="#64748B" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding TripDate}" FontSize="12" Foreground="#334155" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding TimeOut, StringFormat='Out: {0}'}" FontSize="12" Foreground="#334155" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="{Binding DurationSeconds, StringFormat='{}{0}s'}" FontWeight="SemiBold" FontSize="12" Foreground="#0F172A" VerticalAlignment="Center" />
                    <Border Grid.Column="5" Background="#F1F5F9" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,6,0">
                      <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" Foreground="#475569" />
                    </Border>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </ScrollViewer>
        </Border>

        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding TripsModal.TotalTrips, StringFormat='Total Records: {0}'}" FontSize="13" Foreground="#64748B" />
            <TextBlock Text="{Binding TripsModal.ExportStatusMessage}" FontSize="11" FontWeight="SemiBold" Foreground="#166534" IsVisible="{Binding TripsModal.ExportStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
          
          <Button Grid.Column="1" Classes="card-outline" Click="OnExportCsvClick" Padding="12,6">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <PathIcon Data="{StaticResource IconDownload}" Width="12" Height="12" Foreground="#0369A1" />
              <TextBlock Text="Export CSV" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>
      </Grid>
    </Border>
  </Border>
</UserControl>
