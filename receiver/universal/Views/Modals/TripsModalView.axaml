<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BathroomSync.Universal.ViewModels;assembly=HallzeeSync.Universal"
             x:Class="BathroomSync.Universal.Views.TripsModalView"
             x:DataType="vm:MainViewModel">

  <!-- OVERLAY WITH GUARANTEED PADDING SO MODAL NEVER CLIPS WINDOW BOUNDS -->
  <Border Background="#99000000" Padding="32,24" PointerPressed="OnBackdropPointerPressed">
    <Border Background="White" CornerRadius="24" MaxWidth="1040" MaxHeight="640" VerticalAlignment="Center" HorizontalAlignment="Stretch" Padding="24" BoxShadow="0 10 30 0 #40000000">
      <Grid RowDefinitions="Auto,*,Auto">
        
        <!-- HEADER -->
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
          <StackPanel Spacing="2">
            <TextBlock Text="Hall Pass Trip History" FontSize="20" FontWeight="Bold" Foreground="#0F172A" />
            <TextBlock Text="Search, filter, and inspect detailed pass usage." FontSize="13" Foreground="#64748B" />
          </StackPanel>
          <Button Grid.Column="1" Classes="secondary" Content="✕" Click="OnCloseClick" Width="40" Height="40" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
        </Grid>

        <!-- CONTENT GRID -->
        <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
          
          <!-- ROW 0: CLASSROOM SELECTION & EXPORT ACTION BUTTON -->
          <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
            <TextBlock Text="Teacher workspace:" FontWeight="Bold" FontSize="13" Foreground="#334155" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" Classes="filter-dropdown" ItemsSource="{Binding Profiles}" SelectedItem="{Binding ActiveProfile}" DisplayMemberBinding="{Binding Name}" MinWidth="200" VerticalAlignment="Center" />
            <Border Grid.Column="2" Background="#F1F5F9" CornerRadius="8" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center">
              <TextBlock Text="{Binding TripsModal.TotalTrips, StringFormat='{}{0} Records'}" FontSize="12" FontWeight="SemiBold" Foreground="#475569" />
            </Border>
            <Button Grid.Column="3" Classes="pill-outline" Click="OnExportCsvClick" Padding="14,6" Height="36" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Path Data="{StaticResource IconDownload}" Width="14" Height="14" Stretch="Uniform" Stroke="#0369A1" StrokeThickness="2" StrokeLineCap="Round" VerticalAlignment="Center" />
                <TextBlock Text="Export" FontSize="13" FontWeight="Bold" Foreground="#0369A1" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>

          <!-- ROW 1: SEARCH & THEMED FILTER TOOLBAR -->
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10" VerticalAlignment="Center">
            <Border Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="24" Padding="14,6">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Path Data="{StaticResource IconSearch}" Width="16" Height="16" Stretch="Uniform" Stroke="#0284C7" StrokeThickness="2" StrokeLineCap="Round" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding TripsModal.SearchText, UpdateSourceTrigger=PropertyChanged}" Watermark="Search student name, ID, or trip…" FontSize="13" Padding="0,6" Background="Transparent" BorderThickness="0" />
              </Grid>
            </Border>
            <ComboBox Grid.Column="1" Classes="filter-dropdown" ItemsSource="{Binding TripsModal.TimeframeOptions}" SelectedItem="{Binding TripsModal.SelectedTimeframe}" Width="125" VerticalAlignment="Center" ToolTip.Tip="Filter by date range" />
            <ComboBox Grid.Column="2" Classes="filter-dropdown" ItemsSource="{Binding TripsModal.DurationOptions}" SelectedItem="{Binding TripsModal.SelectedDuration}" Width="130" VerticalAlignment="Center" ToolTip.Tip="Filter by duration" />
            <ComboBox Grid.Column="3" Classes="filter-dropdown" ItemsSource="{Binding TripsModal.StatusOptions}" SelectedItem="{Binding TripsModal.SelectedStatus}" Width="130" VerticalAlignment="Center" ToolTip.Tip="Filter by status" />
          </Grid>

          <!-- ROW 2: TRIPS TABLE WITH UNIFIED TABLE STYLES -->
          <Border Grid.Row="2" Classes="hallzee-table-container">
            <Border Classes="hallzee-table-inner">
              <Grid RowDefinitions="Auto,*">
              
              <!-- TABLE HEADER -->
              <Border Classes="hallzee-table-header">
                <Grid ColumnDefinitions="0.65*,0.75*,2.6*,0.8*,0.7*,0.7*,0.7*,85" VerticalAlignment="Center">
                  <Button Classes="table-header-btn" Click="OnSortTripIdClick">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <TextBlock Text="Trip ID" FontSize="12" FontWeight="Bold" Foreground="#0369A1" />
                      <TextBlock Text="{Binding TripsModal.TripIdSortIndicator}" FontSize="12" Foreground="#94A3B8" />
                    </StackPanel>
                  </Button>
                  
                  <Button Grid.Column="1" Classes="table-header-btn" Click="OnSortStudentIdClick">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <TextBlock Text="Student ID" FontSize="12" FontWeight="Bold" Foreground="#0369A1" />
                      <TextBlock Text="{Binding TripsModal.StudentIdSortIndicator}" FontSize="12" Foreground="#94A3B8" />
                    </StackPanel>
                  </Button>

                  <Button Grid.Column="2" Classes="table-header-btn" Click="OnSortStudentNameClick">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <TextBlock Text="Student Name" FontSize="12" FontWeight="Bold" Foreground="#0369A1" />
                      <TextBlock Text="{Binding TripsModal.StudentNameSortIndicator}" FontSize="12" Foreground="#94A3B8" />
                    </StackPanel>
                  </Button>

                  <Button Grid.Column="3" Classes="table-header-btn" Click="OnSortDateClick">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <TextBlock Text="Date" FontSize="12" FontWeight="Bold" Foreground="#0369A1" />
                      <TextBlock Text="{Binding TripsModal.DateSortIndicator}" FontSize="12" Foreground="#94A3B8" />
                    </StackPanel>
                  </Button>

                  <Button Grid.Column="4" Classes="table-header-btn" Click="OnSortDepartedClick">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <TextBlock Text="Departed" FontSize="12" FontWeight="Bold" Foreground="#0369A1" />
                      <TextBlock Text="{Binding TripsModal.DepartedSortIndicator}" FontSize="12" Foreground="#94A3B8" />
                    </StackPanel>
                  </Button>

                  <Button Grid.Column="5" Classes="table-header-btn" Click="OnSortReturnedClick">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <TextBlock Text="Returned" FontSize="12" FontWeight="Bold" Foreground="#0369A1" />
                      <TextBlock Text="{Binding TripsModal.ReturnedSortIndicator}" FontSize="12" Foreground="#94A3B8" />
                    </StackPanel>
                  </Button>

                  <Button Grid.Column="6" Classes="table-header-btn" Click="OnSortDurationClick">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <TextBlock Text="Duration" FontSize="12" FontWeight="Bold" Foreground="#0369A1" />
                      <TextBlock Text="{Binding TripsModal.DurationSortIndicator}" FontSize="12" Foreground="#94A3B8" />
                    </StackPanel>
                  </Button>

                  <Button Grid.Column="7" Classes="table-header-btn" Click="OnSortStatusClick" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <TextBlock Text="Status" FontSize="12" FontWeight="Bold" Foreground="#0369A1" />
                      <TextBlock Text="{Binding TripsModal.StatusSortIndicator}" FontSize="12" Foreground="#94A3B8" />
                    </StackPanel>
                  </Button>
                </Grid>
              </Border>

              <!-- TRIPS LIST -->
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Panel>
                  <ListBox ItemsSource="{Binding TripsModal.Trips}" IsVisible="{Binding TripsModal.HasTrips}" Classes="hallzee-table-list">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Border Classes="hallzee-table-row">
                          <Grid ColumnDefinitions="0.65*,0.75*,2.6*,0.8*,0.7*,0.7*,0.7*,85" VerticalAlignment="Center">
                            <!-- Trip ID -->
                            <TextBlock Text="{Binding TripId, StringFormat='TRIP-{0:D4}'}" FontFamily="Cascadia Mono, Menlo, monospace" FontWeight="Bold" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                            
                            <!-- Student ID -->
                            <TextBlock Grid.Column="1" Text="{Binding StudentId, StringFormat='#{0}'}" FontWeight="Bold" FontSize="13" Foreground="#0F172A" VerticalAlignment="Center" />

                            <!-- Student Name -->
                            <Panel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                              <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="13" Foreground="#0F172A" IsVisible="{Binding HasKnownName}" TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{Binding StudentId, StringFormat='Student ID #{0} (Unmapped)'}" FontStyle="Italic" FontSize="12" Foreground="#94A3B8" IsVisible="{Binding !HasKnownName}" TextTrimming="CharacterEllipsis" />
                            </Panel>

                            <!-- Date -->
                            <TextBlock Grid.Column="3" Text="{Binding FormattedTripDate}" FontSize="13" Foreground="#475569" VerticalAlignment="Center" />

                            <!-- Departed -->
                            <TextBlock Grid.Column="4" Text="{Binding TimeOut}" FontSize="13" Foreground="#475569" VerticalAlignment="Center" />

                            <!-- Returned -->
                            <TextBlock Grid.Column="5" Text="{Binding TimeInDisplay}" FontSize="13" Foreground="#475569" VerticalAlignment="Center" />

                            <!-- Duration -->
                            <TextBlock Grid.Column="6" Text="{Binding FormattedDuration}" FontWeight="Bold" FontSize="13" Foreground="#0F172A" VerticalAlignment="Center" />
                            
                            <!-- Status -->
                            <Border Grid.Column="7" Classes="status-pill" Background="{Binding StatusBackground}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0">
                              <TextBlock Text="{Binding StatusDisplay}" Foreground="{Binding StatusForeground}" />
                            </Border>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>

                  <!-- EMPTY STATE -->
                  <StackPanel IsVisible="{Binding TripsModal.HasNoTrips}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Margin="32">
                    <Path Data="{StaticResource IconHistory}" Width="36" Height="36" Stretch="Uniform" Stroke="#CBD5E1" StrokeThickness="1.8" StrokeLineCap="Round" HorizontalAlignment="Center" />
                    <TextBlock Text="No hall pass trips found" FontSize="14" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center" />
                    <TextBlock Text="Completed trips from the kiosk terminal or manual passes will appear here." FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="380" />
                  </StackPanel>
                </Panel>
              </ScrollViewer>
            </Grid>
          </Border>
        </Border>

          <!-- ROW 3: FOOTER STATUS -->
          <TextBlock Grid.Row="3" Text="{Binding TripsModal.ExportStatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="#166534" IsVisible="{Binding TripsModal.ExportStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </Grid>

      </Grid>
    </Border>
  </Border>
</UserControl>
