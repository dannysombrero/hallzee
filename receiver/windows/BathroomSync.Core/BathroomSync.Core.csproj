<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ReleaseRepository Condition="'$(ReleaseRepository)' == ''">dannysombrero/hallzee</ReleaseRepository>
  </PropertyGroup>
  <ItemGroup>
    <!-- Select the native engine explicitly: the Microsoft.Data.Sqlite bundle
         otherwise pulls the retired SQLitePCLRaw.lib.e_sqlite3 2.x package. -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="8.0.30" />
    <PackageReference Include="SQLitePCLRaw.config.e_sqlite3" Version="3.0.5" />
    <PackageReference Include="SourceGear.sqlite3" Version="3.53.4" />
  </ItemGroup>
  <ItemGroup><EmbeddedResource Include="../../../firmware/release-public-key.pem" LogicalName="Hallzee.FirmwarePublicKey" /></ItemGroup>
  <ItemGroup><AssemblyMetadata Include="ReleaseRepository" Value="$(ReleaseRepository)" /></ItemGroup>
</Project>
