{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "typeRoots": [
      "../web-client/node_modules/@types"
    ],
    "types": ["node"]
  },
  "include": ["src/**/*", "test/**/*"]
}
