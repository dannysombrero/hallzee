{
  "name": "hallzee-web-client",
  "version": "1.2.0-dev.1",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "engines": { "node": ">=22.23.2" },
  "scripts": {
    "dev": "vite --host localhost --port 5173 --strictPort",
    "build": "vite build && node scripts/build-shell.mjs",
    "preview": "vite preview --host localhost --port 4190 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests",
    "test:unit": "vitest run",
    "test:browser": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test:unit && npm run build && npm run test:browser"
  },
  "dependencies": { "react": "19.2.8", "react-dom": "19.2.8", "lucide-react": "1.42.0" },
  "devDependencies": {
    "@types/react": "19.2.14", "@types/react-dom": "19.2.3", "@types/node": "26.5.0",
    "@types/web-bluetooth": "0.0.21", "@vitejs/plugin-react": "6.1.1",
    "@tailwindcss/vite": "4.3.3", "tailwindcss": "4.3.3", "typescript": "7.0.2",
    "vite": "8.2.2", "vitest": "5.0.0", "@playwright/test": "1.63.0",
    "fake-indexeddb": "6.2.4", "oxlint": "1.82.0"
  }
}
